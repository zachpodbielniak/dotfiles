set -euo pipefail

usage () {
	cat <<'HELP'
Usage: librewolf-config COMMAND [--root DIR | --profile DIR]
       librewolf-config save-export NAME FILE
Manage Flatpak LibreWolf without tracking a browser profile.

  profile             Print the resolved profile (read-only).
  plan                Show the files apply would update (read-only).
  apply               Copy CSS and enable userChrome; close LibreWolf first.
  capture             Copy this profile's userChrome.css into the repo.
  extensions          List extension names and installation URLs.
  save-export NAME FILE
                      Save a JSON export: sidebery, ublock, vimium,
                      temporary-containers, or darkreader. Review before commit.
  -h, --help          Show help.
  --license           Show license.

--root selects a directory containing profiles.ini; --profile bypasses discovery.
Default roots: Flatpak XDG config, then the legacy Flatpak .librewolf directory.
Ambiguous profiles require --profile. apply backs up changes next to each file.
Extensions are installed through their URLs; settings are imported in each addon.
No extension databases, passwords, sessions, or Bitwarden exports are copied.

Examples:
  librewolf-config plan
  librewolf-config apply
  librewolf-config capture --profile '/path/to/random.default-default'
  librewolf-config extensions
  librewolf-config save-export sidebery ~/Downloads/sidebery-settings.json

Exit status: 0 on success; nonzero for invalid input or failed operations.
HELP
}

fail () {
	printf 'librewolf-config: %s\n' "$*" >&2
	exit 1
}

# Resolve the installed symlink back to the checkout containing managed assets.
case "${1:-}" in
	-h|--help) usage; exit 0 ;;
	--license) printf '%s\n' 'AGPL-3.0-or-later: https://www.gnu.org/licenses/agpl-3.0.html'; exit 0 ;;
esac
command_name="${1:-}"
[[ -n "${command_name}" ]] || { usage >&2; exit 1; }
shift
script_path="$(realpath -- "${BASH_SOURCE[0]}")"
repo_dir="$(dirname -- "$(dirname -- "$(dirname -- "${script_path}")")")"
assets="${repo_dir}/share/librewolf"

# Exports stay in their addon-native format; never accept password-manager data.
if [[ "${command_name}" == save-export ]]
then
	[[ $# -eq 2 ]] || fail 'save-export requires NAME FILE'
	case "${1}" in
		sidebery|ublock|vimium|temporary-containers|darkreader) ;;
		*) fail 'Unsupported export name (Bitwarden data must not enter git).' ;;
	esac
	jq -e 'type == "object"' -- "${2}" >/dev/null || fail 'Expected an addon JSON object export.'
	mkdir -p -- "${assets}/exports"
	cp --backup=numbered -- "${2}" "${assets}/exports/${1}.json"
	printf 'Saved %s; review for private URLs and other personal data before committing.\n' "${assets}/exports/${1}.json"
	exit 0
fi
if [[ "${command_name}" == extensions ]]
then
	[[ $# -eq 0 ]] || fail 'extensions takes no arguments'
	jq -r '.[] | [.name, .url] | @tsv' "${assets}/extensions.json"
	exit 0
fi
case "${command_name}" in profile|plan|apply|capture) ;; *) fail "Unknown command: ${command_name}" ;; esac
root=''
profile=''
while [[ $# -gt 0 ]]
do
	case "${1}" in
		--root|--profile)
			[[ $# -ge 2 && -n "${2}" ]] || fail "${1} requires a directory"
			if [[ "${1}" == --root ]]; then root="${2}"; else profile="${2}"; fi
			shift 2 ;;
		*) fail "Unknown argument: ${1}" ;;
	esac
done
[[ -z "${root}" || -z "${profile}" ]] || fail 'Use either --root or --profile.'
if [[ -z "${profile}" ]]
then
	if [[ -z "${root}" ]]
	then
		flatpak_home="${HOME}/.var/app/io.gitlab.librewolf-community"
		for candidate in "${flatpak_home}/config/librewolf/librewolf" "${flatpak_home}/.librewolf"
		do
			if [[ -f "${candidate}/profiles.ini" ]]; then root="${candidate}"; break; fi
		done
	fi
	[[ -f "${root}/profiles.ini" ]] || fail 'No profiles.ini found; launch LibreWolf once or pass --profile.'
	# Install-specific defaults outrank legacy Profile Default=1. Never guess
	# among different installation defaults or multiple non-default profiles.
	profile="$(awk -F= '
		{ sub(/\r$/, "") }
		/^\[/ { section=$0; next }
		$1 == "Path" { paths[section]=substr($0,6) }
		$1 == "IsRelative" { relative[section]=$2 }
		$1 == "Default" {
			if (section ~ /^\[Install/) installs[substr($0,9)]=1
			else if ($2 == "1") defaults[section]=1
		}
		END {
			for (p in installs) { chosen=p; count++ }
			if (count > 1) exit 2
			if (count == 1) { print chosen; exit }
			for (s in defaults) { chosen=s; count++ }
			if (count == 0) for (s in paths) { chosen=s; count++ }
			if (count != 1 || !(chosen in paths)) exit 2
			if (relative[chosen] == "0" && paths[chosen] !~ /^\//) exit 2
			print paths[chosen]
		}' "${root}/profiles.ini")" || fail 'Ambiguous or invalid profiles.ini; pass --profile.'
	[[ "${profile}" == /* ]] || profile="${root}/${profile}"
fi
[[ -d "${profile}" ]] || fail "Profile does not exist: ${profile}"
profile="$(realpath -- "${profile}")"
[[ -f "${profile}/prefs.js" ]] || fail "Not an initialized profile: ${profile}"
if [[ "${command_name}" == profile ]]; then printf '%s\n' "${profile}"; exit 0; fi
if [[ "${command_name}" == capture ]]
then
	cp --backup=numbered -- "${profile}/chrome/userChrome.css" "${assets}/chrome/userChrome.css"
	exit 0
fi
if [[ "${command_name}" == plan ]]
then
	printf 'Copy %s -> %s\nEnable toolkit.legacyUserProfileCustomizations.stylesheets in %s/user.js\n' "${assets}/chrome/userChrome.css" "${profile}/chrome/userChrome.css" "${profile}"
	exit 0
fi
# Do not race browser writes. Firefox lock symlinks may be dangling while held;
# existence tests must therefore check both regular files and symlinks.
for lock in lock .parentlock parent.lock
do
	[[ ! -e "${profile}/${lock}" && ! -L "${profile}/${lock}" ]] || fail "Close LibreWolf before apply (profile has ${lock}); inspect stale locks manually."
done
[[ -f "${assets}/chrome/userChrome.css" ]] || fail 'Managed userChrome.css is missing.'
[[ ! -L "${profile}/chrome" && ! -L "${profile}/chrome/userChrome.css" && ! -L "${profile}/user.js" ]] || fail 'Refusing symlinked destinations; replace them with local files first.'
# Generate the preference change before touching existing files. Only our
# delimited block is replaced, preserving unrelated host preferences.
pending="$(mktemp)"
trap 'rm -f -- "${pending}"' EXIT
if [[ -f "${profile}/user.js" ]]
then
	awk '
		$0 == "// BEGIN dotfiles librewolf" { if (block) exit 2; block=1; next }
		$0 == "// END dotfiles librewolf" { if (!block) exit 2; block=0; next }
		!block { print }
		END { if (block) exit 2 }
	' "${profile}/user.js" > "${pending}" || fail 'Malformed managed block in user.js; original preserved.'
fi
cat >> "${pending}" <<'PREFS'
// BEGIN dotfiles librewolf
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
// END dotfiles librewolf
PREFS
mkdir -p -- "${profile}/chrome"
# Numbered backups remain beside the originals, inside Flatpak-readable storage.
for entry in chrome/userChrome.css user.js
do
	source_file="${assets}/${entry}"
	[[ "${entry}" != user.js ]] || source_file="${pending}"
	if ! cmp -s -- "${source_file}" "${profile}/${entry}"
	then
		cp --backup=numbered -- "${source_file}" "${profile}/${entry}"
		printf 'Updated %s\n' "${profile}/${entry}"
	fi
done
