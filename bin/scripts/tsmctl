# ============================================================================
# Errors and logging
# ============================================================================

class TsmctlError(Exception):
	"""A fatal, user-facing error. main() prints it to stderr and exits 1."""


class Log(object):
	"""
	Minimal stderr logger. Warnings are always shown unless --quiet;
	info needs -v and debug needs -vv.
	"""

	verbosity: int = 0
	quiet: bool = False
	warnings: list[str] = []

	@classmethod
	def warn(cls, msg: str) -> None:
		cls.warnings.append(msg)
		if not cls.quiet:
			print(f"{PROG}: warning: {msg}", file=sys.stderr)

	@classmethod
	def info(cls, msg: str) -> None:
		if cls.verbosity >= 1 and not cls.quiet:
			print(f"{PROG}: {msg}", file=sys.stderr)

	@classmethod
	def debug(cls, msg: str) -> None:
		if cls.verbosity >= 2:
			print(f"{PROG}: debug: {msg}", file=sys.stderr)


# ============================================================================
# Lua literal parser (SavedVariables)
# ============================================================================

# One token per match. Strings use the unrolled-loop form so megabyte-long
# CSV strings tokenize in linear time.
LUA_TOKEN_RE: re.Pattern[bytes] = re.compile(rb"""
	(?P<ws>\s+|--[^\n]*)
	|(?P<str>"[^"\\]*(?:\\.[^"\\]*)*"|'[^'\\]*(?:\\.[^'\\]*)*')
	|(?P<long>\[(?P<eq>=*)\[.*?\](?P=eq)\])
	|(?P<num>-?(?:0[xX][0-9a-fA-F]+|\d+\.?\d*(?:[eE][-+]?\d+)?|\.\d+(?:[eE][-+]?\d+)?))
	|(?P<name>[A-Za-z_][A-Za-z0-9_]*)
	|(?P<punct>[{}\[\]=,;])
""", re.X | re.S)

LUA_ESCAPE_RE: re.Pattern[bytes] = re.compile(rb"\\(\d{1,3}|x[0-9a-fA-F]{2}|\r\n|.)", re.S)
LUA_ESCAPES: dict[bytes, bytes] = {
	b"n": b"\n", b"t": b"\t", b"r": b"\r", b"a": b"\a", b"b": b"\b", b"f": b"\f",
	b"v": b"\v", b"\\": b"\\", b"\"": b"\"", b"'": b"'", b"\n": b"\n", b"\r\n": b"\n",
}


def _lua_unescape_match(match: re.Match[bytes]) -> bytes:
	"""Translate one Lua string escape sequence into its raw byte(s)."""
	seq: bytes = match.group(1)
	if seq[:1].isdigit():
		return bytes([int(seq) & 0xFF])
	if seq[:1] == b"x" and len(seq) == 3:
		return bytes([int(seq[1:], 16)])
	return LUA_ESCAPES.get(seq, seq)


class LuaParser(object):
	"""
	Parser for the data-only Lua that WoW writes to SavedVariables:
	a sequence of `Name = <value>` assignments where values are strings,
	numbers, booleans, nil, and (nested) tables.

	Nothing is executed. Tables become dicts; a table whose keys are exactly
	1..n becomes a list. Strings are decoded as UTF-8 (invalid bytes are
	replaced) after Lua escapes are resolved.
	"""

	def __init__(self, data: bytes, origin: str):
		self.origin: str = origin
		self.kinds: list[str] = []
		self.values: list[bytes] = []
		self.offsets: list[int] = []
		self.pos: int = 0
		self._tokenize(data)

	def _tokenize(self, data: bytes) -> None:
		"""Split the whole file into (kind, value, offset) tokens up front."""
		pos: int = 0
		end: int = len(data)
		match: Callable[..., Optional[re.Match[bytes]]] = LUA_TOKEN_RE.match
		kinds: list[str] = self.kinds
		values: list[bytes] = self.values
		offsets: list[int] = self.offsets
		while pos < end:
			mo: Optional[re.Match[bytes]] = match(data, pos)
			if mo is None:
				raise TsmctlError(f"{self.origin}: unexpected byte at offset {pos}: {data[pos:pos + 32]!r}")
			kind: str = mo.lastgroup or ""
			if kind == "eq":
				kind = "long"
			if kind != "ws":
				kinds.append(kind)
				values.append(mo.group(kind))
				offsets.append(pos)
			pos = mo.end()

	def _fail(self, msg: str) -> TsmctlError:
		offset: int = self.offsets[self.pos] if self.pos < len(self.offsets) else -1
		return TsmctlError(f"{self.origin}: Lua parse error near offset {offset}: {msg}")

	def _expect(self, value: bytes) -> None:
		if self.pos >= len(self.values) or self.values[self.pos] != value:
			got: bytes = self.values[self.pos] if self.pos < len(self.values) else b"<eof>"
			raise self._fail(f"expected {value!r}, got {got[:40]!r}")
		self.pos += 1

	def parse_assignments(self) -> dict[str, Any]:
		"""Parse the top level: `Name = value` repeated until end of file."""
		result: dict[str, Any] = {}
		total: int = len(self.kinds)
		while self.pos < total:
			if self.kinds[self.pos] != "name":
				raise self._fail("expected a global variable name")
			name: str = self.values[self.pos].decode("utf-8", "replace")
			self.pos += 1
			self._expect(b"=")
			result[name] = self._value()
			if self.pos < total and self.values[self.pos] == b";":
				self.pos += 1
		return result

	def parse_value(self) -> Any:
		"""Parse a single standalone value (used for `return {...}` chunks)."""
		return self._value()

	def _value(self) -> Any:
		if self.pos >= len(self.kinds):
			raise self._fail("unexpected end of input")
		kind: str = self.kinds[self.pos]
		raw: bytes = self.values[self.pos]
		if kind == "str":
			self.pos += 1
			return LUA_ESCAPE_RE.sub(_lua_unescape_match, raw[1:-1]).decode("utf-8", "replace")
		if kind == "long":
			self.pos += 1
			level: int = raw.index(b"[", 1) + 1
			body: bytes = raw[level:-level]
			if body.startswith(b"\r\n"):
				body = body[2:]
			elif body.startswith(b"\n"):
				body = body[1:]
			return body.decode("utf-8", "replace")
		if kind == "num":
			self.pos += 1
			text: str = raw.decode("ascii")
			try:
				return int(text, 0)
			except ValueError:
				return float(text)
		if kind == "name":
			self.pos += 1
			if raw == b"true":
				return True
			if raw == b"false":
				return False
			if raw == b"nil":
				return None
			raise self._fail(f"unexpected identifier {raw!r} (only data is supported)")
		if raw == b"{":
			return self._table()
		raise self._fail(f"unexpected token {raw[:40]!r}")

	def _table(self) -> Any:
		"""Parse `{ ... }` with `[k] = v`, `name = v` and positional entries."""
		self.pos += 1
		result: dict[Any, Any] = {}
		next_index: int = 1
		kinds: list[str] = self.kinds
		values: list[bytes] = self.values
		while True:
			if self.pos >= len(kinds):
				raise self._fail("unterminated table")
			raw: bytes = values[self.pos]
			if raw == b"}":
				self.pos += 1
				break
			if raw == b"[" and kinds[self.pos] == "punct":
				self.pos += 1
				key: Any = self._value()
				self._expect(b"]")
				self._expect(b"=")
				result[key] = self._value()
			elif kinds[self.pos] == "name" and self.pos + 1 < len(values) and values[self.pos + 1] == b"=":
				key = raw.decode("utf-8", "replace")
				self.pos += 2
				result[key] = self._value()
			else:
				result[next_index] = self._value()
				next_index += 1
			if self.pos < len(values) and values[self.pos] in (b",", b";"):
				self.pos += 1
		# A table keyed exactly 1..n is an array.
		count: int = len(result)
		if count and next_index - 1 == count and all(isinstance(k, int) for k in result):
			return [result[i] for i in range(1, count + 1)]
		return result


def lua_list(value: Any) -> list[Any]:
	"""Return a Lua array value as a list whether it parsed as list, dict or scalar."""
	if value is None:
		return []
	if isinstance(value, list):
		return value
	if isinstance(value, dict):
		return [value[k] for k in sorted(k for k in value if isinstance(k, int))]
	return [value]


def lua_dict(value: Any) -> dict[Any, Any]:
	"""Return a Lua table as a dict (an empty Lua table may parse as {})."""
	if isinstance(value, dict):
		return value
	if isinstance(value, list):
		return {i + 1: v for i, v in enumerate(value)}
	return {}


def parse_lua_file(path: Path) -> dict[str, Any]:
	"""Read and parse a SavedVariables file into {global_name: value}."""
	try:
		data: bytes = path.read_bytes()
	except OSError as exc:
		raise TsmctlError(f"cannot read {path}: {exc}") from exc
	started: float = time.monotonic()
	result: dict[str, Any] = LuaParser(data, str(path)).parse_assignments()
	Log.debug(f"parsed {path.name} ({len(data):,} bytes) in {time.monotonic() - started:.2f}s")
	return result


# ============================================================================
# Small YAML-subset config parser
# ============================================================================

class SimpleYaml(object):
	"""
	Parse the flat YAML subset tsmctl's config uses:

	    key: value          # scalars (strings, numbers, true/false/null)
	    key: [a, b]         # inline lists
	    key:                # block lists
	      - a
	      - b

	Nested mappings are not supported (and not needed).
	"""

	KEY_RE: re.Pattern[str] = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:\s*(.*)$")
	ITEM_RE: re.Pattern[str] = re.compile(r"^\s+-\s*(.*)$|^-\s+(.*)$")

	@staticmethod
	def _strip_comment(line: str) -> str:
		"""Remove a trailing `# comment` that is not inside quotes."""
		quote: str = ""
		for i, ch in enumerate(line):
			if quote:
				if ch == quote:
					quote = ""
			elif ch in ("'", "\""):
				quote = ch
			elif ch == "#" and (i == 0 or line[i - 1].isspace()):
				return line[:i].rstrip()
		return line.rstrip()

	@staticmethod
	def scalar(text: str) -> Any:
		"""Convert a YAML scalar into a Python value."""
		text = text.strip()
		if len(text) >= 2 and text[0] == text[-1] and text[0] in ("'", "\""):
			return text[1:-1]
		if text.startswith("[") and text.endswith("]"):
			inner: str = text[1:-1].strip()
			return [SimpleYaml.scalar(p) for p in inner.split(",")] if inner else []
		lowered: str = text.lower()
		if lowered in ("true", "yes", "on"):
			return True
		if lowered in ("false", "no", "off"):
			return False
		if lowered in ("null", "~", ""):
			return None
		try:
			return int(text)
		except ValueError:
			pass
		try:
			return float(text)
		except ValueError:
			return text

	@classmethod
	def parse(cls, text: str, origin: str) -> dict[str, Any]:
		result: dict[str, Any] = {}
		list_key: Optional[str] = None
		for lineno, raw in enumerate(text.splitlines(), 1):
			line: str = cls._strip_comment(raw)
			if not line.strip() or line.strip() == "---":
				continue
			item: Optional[re.Match[str]] = cls.ITEM_RE.match(line)
			if item and list_key is not None:
				result[list_key].append(cls.scalar(item.group(1) if item.group(1) is not None else item.group(2)))
				continue
			kv: Optional[re.Match[str]] = cls.KEY_RE.match(line)
			if kv is None:
				raise TsmctlError(f"{origin}:{lineno}: cannot parse config line: {raw.strip()!r}")
			key: str = kv.group(1).replace("-", "_")
			if kv.group(2).strip() == "":
				result[key] = []
				list_key = key
			else:
				result[key] = cls.scalar(kv.group(2))
				list_key = None
		return result


# ============================================================================
# Settings (CLI > environment > config file > defaults)
# ============================================================================

@dataclass
class Settings(object):
	"""Effective settings after merging every configuration layer."""

	config_path: Optional[Path] = None
	host: str = ""
	local: bool = False
	wow_dir: str = DEFAULT_WOW_DIR
	flavor: str = DEFAULT_FLAVOR
	cache_dir: Path = Path(DEFAULT_CACHE_DIR)
	offline: bool = False
	refresh: bool = False
	ssh_options: list[str] = field(default_factory=list)
	accounts: list[str] = field(default_factory=list)
	realm: str = ""
	price_source: str = DEFAULT_PRICE_SOURCE
	market_source: str = DEFAULT_MARKET_SOURCE
	sell_source: str = DEFAULT_SELL_SOURCE
	ah_cut: float = DEFAULT_AH_CUT_PCT / 100.0
	notes_dir: Path = Path(DEFAULT_NOTES_DIR).expanduser()
	report_dir: Path = Path(DEFAULT_REPORT_DIR).expanduser()
	money: str = "g"
	color: str = "auto"
	author: str = DEFAULT_AUTHOR
	categories: str = DEFAULT_CATEGORIES
	sources: dict[str, str] = field(default_factory=dict)


def _config_layer(args: argparse.Namespace) -> tuple[dict[str, Any], Optional[Path]]:
	"""Load the YAML config named by --config / $TSMCTL_CONFIG / the default path."""
	if getattr(args, "no_config", False):
		return {}, None
	explicit: Optional[str] = getattr(args, "config", None) or os.environ.get("TSMCTL_CONFIG")
	path: Path = Path(explicit).expanduser() if explicit else DEFAULT_CONFIG_PATH
	if not path.exists():
		if explicit:
			raise TsmctlError(f"config file not found: {path}")
		return {}, None
	try:
		return SimpleYaml.parse(path.read_text(encoding="utf-8"), str(path)), path
	except OSError as exc:
		raise TsmctlError(f"cannot read config {path}: {exc}") from exc


def build_settings(args: argparse.Namespace) -> Settings:
	"""
	Merge configuration layers. For each setting the first non-empty value
	wins, in this order: command line, environment, config file, default.
	"""
	config: dict[str, Any]
	config_path: Optional[Path]
	config, config_path = _config_layer(args)
	settings: Settings = Settings(config_path=config_path)

	def pick(name: str, cli: Any, env_names: tuple[str, ...], default: Any) -> Any:
		if cli not in (None, "", []):
			settings.sources[name] = "cli"
			return cli
		for env_name in env_names:
			env_value: Optional[str] = os.environ.get(env_name)
			if env_value:
				settings.sources[name] = f"env {env_name}"
				return env_value
		if config.get(name) not in (None, "", []):
			settings.sources[name] = "config"
			return config[name]
		settings.sources[name] = "default"
		return default

	settings.local = bool(getattr(args, "local", False))
	settings.host = "" if settings.local else str(pick("host", getattr(args, "host", None), ("TSMCTL_HOST",), "") or "")
	settings.wow_dir = str(pick("wow_dir", getattr(args, "wow_dir", None), ("TSMCTL_WOW_DIR", "TSM_WOW_DIR"), DEFAULT_WOW_DIR))
	settings.flavor = str(pick("flavor", getattr(args, "flavor", None), ("TSMCTL_FLAVOR",), DEFAULT_FLAVOR))
	if not (settings.flavor.startswith("_") and settings.flavor.endswith("_")):
		settings.flavor = f"_{settings.flavor.strip('_')}_"
	settings.cache_dir = Path(str(pick("cache_dir", getattr(args, "cache_dir", None), ("TSMCTL_CACHE_DIR",), DEFAULT_CACHE_DIR))).expanduser()
	settings.offline = bool(getattr(args, "offline", False))
	settings.refresh = bool(getattr(args, "refresh", False))
	ssh_options: Any = config.get("ssh_options") or []
	settings.ssh_options = [str(o) for o in lua_list(ssh_options)] if not isinstance(ssh_options, str) else shlex.split(ssh_options)
	accounts: Any = pick("accounts", getattr(args, "account", None), ("TSMCTL_ACCOUNTS",), [])
	settings.accounts = _split_multi(accounts)
	settings.realm = str(pick("realm", getattr(args, "default_realm", None), ("TSMCTL_REALM",), "") or "")
	settings.price_source = str(pick("price_source", getattr(args, "price_source", None), ("TSMCTL_PRICE_SOURCE",), DEFAULT_PRICE_SOURCE))
	settings.market_source = str(pick("market_source", getattr(args, "market_source", None), ("TSMCTL_MARKET_SOURCE",), DEFAULT_MARKET_SOURCE))
	settings.sell_source = str(pick("sell_source", getattr(args, "sell_source", None), ("TSMCTL_SELL_SOURCE",), DEFAULT_SELL_SOURCE))
	ah_cut: Any = pick("ah_cut", getattr(args, "ah_cut", None), ("TSMCTL_AH_CUT",), DEFAULT_AH_CUT_PCT)
	try:
		settings.ah_cut = float(ah_cut) / 100.0
	except (TypeError, ValueError) as exc:
		raise TsmctlError(f"ah_cut must be a percentage number, got {ah_cut!r}") from exc
	if not 0.0 <= settings.ah_cut < 1.0:
		raise TsmctlError("ah_cut must be between 0 and 100 percent")
	settings.notes_dir = Path(str(pick("notes_dir", None, ("TSMCTL_NOTES_DIR",), DEFAULT_NOTES_DIR))).expanduser()
	settings.report_dir = Path(str(pick("report_dir", None, ("TSMCTL_REPORT_DIR",), DEFAULT_REPORT_DIR))).expanduser()
	settings.money = str(pick("money", getattr(args, "money", None), ("TSMCTL_MONEY",), "g"))
	if settings.money not in ("g", "gsc", "copper"):
		raise TsmctlError(f"money format must be one of g, gsc, copper (got {settings.money!r})")
	settings.color = str(pick("color", getattr(args, "color", None), ("TSMCTL_COLOR",), "auto"))
	settings.author = str(pick("author", None, ("TSMCTL_AUTHOR",), DEFAULT_AUTHOR))
	settings.categories = str(pick("categories", None, ("TSMCTL_CATEGORIES",), DEFAULT_CATEGORIES))
	return settings


def _split_multi(values: Any) -> list[str]:
	"""Flatten repeated and comma-separated option values into one list."""
	result: list[str] = []
	for value in lua_list(values) if not isinstance(values, str) else [values]:
		for part in str(value).split(","):
			part = part.strip()
			if part:
				result.append(part)
	return result


# ============================================================================
# Data source: local directory or read-only ssh mirror
# ============================================================================

def is_local_host(host: str) -> bool:
	"""True when `host` names this machine (so no ssh is needed)."""
	if not host:
		return True
	names: set[str] = {"localhost", "127.0.0.1", "::1"}
	try:
		fqdn: str = socket.gethostname()
		names.update({fqdn, fqdn.split(".")[0]})
	except OSError:
		pass
	return host in names or host.split(".")[0] in names


class DataSource(object):
	"""
	Resolves where the TSM files are and, for a remote host, mirrors them
	into the cache. The remote side only ever runs `find` and `tar c`.
	"""

	def __init__(self, settings: Settings):
		self.settings: Settings = settings
		self.remote: bool = bool(settings.host) and not is_local_host(settings.host)
		self.synced_at: Optional[float] = None
		self.stale: bool = False
		self.root: Path = self._local_root() if not self.remote else self._cache_root()

	def describe(self) -> str:
		if self.remote:
			return f"ssh {self.settings.host} (cached in {self.root})"
		return f"local {self.root}"

	def _local_root(self) -> Path:
		return Path(self.settings.wow_dir).expanduser() / self.settings.flavor

	def _cache_root(self) -> Path:
		slug: str = re.sub(r"[^A-Za-z0-9._-]", "_", self.settings.host)
		return self.settings.cache_dir / "hosts" / slug / self.settings.flavor

	def _manifest_path(self) -> Path:
		return self.root.parent / f"manifest{self.settings.flavor}.json"

	def _remote_dir_expr(self) -> str:
		"""Shell expression for the remote flavor dir; `~/x` becomes "$HOME"/x."""
		path: str = self.settings.wow_dir.rstrip("/") + "/" + self.settings.flavor
		if path.startswith("~/"):
			return "\"$HOME\"/" + shlex.quote(path[2:])
		return shlex.quote(path)

	def _ssh(self, remote_cmd: str, binary: bool = False, timeout: int = 120) -> subprocess.CompletedProcess[Any]:
		"""Run one read-only command on the remote host."""
		cmd: list[str] = ["ssh", *SSH_BASE_OPTIONS, *self.settings.ssh_options, self.settings.host, remote_cmd]
		Log.debug(f"ssh: {shlex.join(cmd)}")
		try:
			return subprocess.run(cmd, capture_output=True, timeout=timeout, text=not binary)
		except FileNotFoundError as exc:
			raise TsmctlError("ssh is not installed; cannot reach a remote host") from exc
		except subprocess.TimeoutExpired as exc:
			raise TsmctlError(f"ssh to {self.settings.host} timed out after {timeout}s") from exc

	def prepare(self) -> None:
		"""Make sure self.root holds current data (sync if remote)."""
		if not self.remote:
			if not self.root.is_dir():
				hint: str = " (set --host, $TSMCTL_HOST or `host:` in the config to read a remote machine)"
				raise TsmctlError(f"WoW directory not found: {self.root}{hint}")
			return
		manifest: dict[str, Any] = self._read_manifest()
		if self.settings.offline:
			if not manifest:
				raise TsmctlError(f"--offline given but nothing is cached for {self.settings.host} yet")
			self.synced_at = manifest.get("synced_at")
			self.stale = True
			return
		try:
			self._sync(manifest)
		except TsmctlError as exc:
			if not manifest:
				raise
			self.synced_at = manifest.get("synced_at")
			self.stale = True
			when: str = fmt_age(time.time() - float(self.synced_at or 0))
			Log.warn(f"{exc}; using cached data from {when} ago")

	def _read_manifest(self) -> dict[str, Any]:
		path: Path = self._manifest_path()
		try:
			data: Any = json.loads(path.read_text(encoding="utf-8"))
			return data if isinstance(data, dict) else {}
		except (OSError, ValueError):
			return {}

	def _sync(self, manifest: dict[str, Any]) -> None:
		"""List remote files, then copy only the ones whose mtime/size changed."""
		listing_cmd: str = (
			f"cd -- {self._remote_dir_expr()} 2>/dev/null || exit 3; "
			f"find WTF/Account -mindepth {SV_GLOB_DEPTH} -maxdepth {SV_GLOB_DEPTH} -type f "
			"-name TradeSkillMaster.lua -path '*/SavedVariables/*' -printf '%T@\\t%s\\t%p\\n' 2>/dev/null; "
			f"if [ -f {shlex.quote(APPDATA_REL)} ]; then find {shlex.quote(APPDATA_REL)} -printf '%T@\\t%s\\t%p\\n'; fi; true"
		)
		proc: subprocess.CompletedProcess[Any] = self._ssh(listing_cmd, timeout=60)
		if proc.returncode == 3:
			raise TsmctlError(f"WoW directory not found on {self.settings.host}: {self.settings.wow_dir}/{self.settings.flavor}")
		if proc.returncode != 0:
			raise TsmctlError(f"ssh {self.settings.host} failed (exit {proc.returncode}): {proc.stderr.strip()[:300]}")
		remote_files: dict[str, list[float]] = {}
		for line in proc.stdout.splitlines():
			parts: list[str] = line.split("\t", 2)
			if len(parts) != 3:
				continue
			rel: str = parts[2]
			if rel.startswith("/") or ".." in Path(rel).parts:
				continue
			remote_files[rel] = [float(parts[0]), float(parts[1])]
		if not remote_files:
			raise TsmctlError(f"no TSM files found on {self.settings.host} under {self.settings.wow_dir}/{self.settings.flavor}")

		cached: dict[str, list[float]] = manifest.get("files", {}) if not self.settings.refresh else {}
		wanted: list[str] = [
			rel for rel, meta in sorted(remote_files.items())
			if cached.get(rel) != meta or not (self.root / rel).is_file()
		]
		if wanted:
			Log.info(f"fetching {len(wanted)} changed file(s) from {self.settings.host}")
			self._fetch(wanted, remote_files)
		else:
			Log.info(f"cache for {self.settings.host} is current")

		# Drop cached files that disappeared remotely.
		for rel in set(cached) - set(remote_files):
			stale_path: Path = self.root / rel
			if stale_path.is_file():
				stale_path.unlink()
		self.synced_at = time.time()
		self.root.mkdir(parents=True, exist_ok=True)
		tmp: Path = self._manifest_path().with_suffix(".tmp")
		tmp.write_text(json.dumps({"synced_at": self.synced_at, "host": self.settings.host, "files": remote_files}, indent=1), encoding="utf-8")
		os.replace(tmp, self._manifest_path())

	def _fetch(self, wanted: list[str], remote_files: dict[str, list[float]]) -> None:
		"""Stream `tar c` of the wanted files from the remote and unpack safely."""
		quoted: str = " ".join(shlex.quote(rel) for rel in wanted)
		remote_cmd: str = f"cd -- {self._remote_dir_expr()} && tar cf - -- {quoted}"
		cmd: list[str] = ["ssh", *SSH_BASE_OPTIONS, *self.settings.ssh_options, self.settings.host, remote_cmd]
		Log.debug(f"ssh: {shlex.join(cmd)}")
		wanted_set: set[str] = set(wanted)
		received: set[str] = set()
		try:
			proc: subprocess.Popen[bytes] = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
		except FileNotFoundError as exc:
			raise TsmctlError("ssh is not installed; cannot reach a remote host") from exc
		assert proc.stdout is not None and proc.stderr is not None
		try:
			with tarfile.open(fileobj=proc.stdout, mode="r|") as archive:
				for member in archive:
					# Only accept regular files we asked for; never trust paths.
					if member.name not in wanted_set or not member.isfile():
						Log.debug(f"skipping unexpected tar member {member.name!r}")
						continue
					source: Optional[io.BufferedReader] = archive.extractfile(member)  # type: ignore[assignment]
					if source is None:
						continue
					dest: Path = self.root / member.name
					dest.parent.mkdir(parents=True, exist_ok=True)
					tmp: Path = dest.with_name(dest.name + ".part")
					with open(tmp, "wb") as handle:
						shutil.copyfileobj(source, handle)
					os.replace(tmp, dest)
					mtime: float = remote_files.get(member.name, [member.mtime])[0]
					os.utime(dest, (mtime, mtime))
					received.add(member.name)
		except tarfile.TarError as exc:
			proc.kill()
			raise TsmctlError(f"bad tar stream from {self.settings.host}: {exc}") from exc
		finally:
			stderr: str = proc.stderr.read().decode("utf-8", "replace")
			proc.wait(timeout=30)
		if proc.returncode != 0:
			raise TsmctlError(f"copying from {self.settings.host} failed (exit {proc.returncode}): {stderr.strip()[:300]}")
		missing: set[str] = wanted_set - received
		if missing:
			raise TsmctlError(f"remote tar did not include: {', '.join(sorted(missing))}")

	def sv_files(self) -> list[tuple[str, Path]]:
		"""Return (account, path) for every account's TradeSkillMaster.lua."""
		base: Path = self.root / "WTF" / "Account"
		found: list[tuple[str, Path]] = []
		if base.is_dir():
			for path in sorted(base.glob("*/SavedVariables/TradeSkillMaster.lua")):
				found.append((path.parent.parent.name, path))
		return found

	def appdata_file(self) -> Optional[Path]:
		path: Path = self.root / APPDATA_REL
		return path if path.is_file() else None


# ============================================================================
# Domain model
# ============================================================================

ITEM_STRING_RE: re.Pattern[str] = re.compile(r"^[ip]:\d+")
ORG_LINK_RE: re.Pattern[str] = re.compile(r"\[\[[^\]]*\]\[([^\]]*)\]\]")


def class_name(token: str) -> str:
	return CLASS_NAMES.get(token, token.title())


def item_base(item: str) -> str:
	"""Reduce an item string (i:ID::bonus..., p:species:...) to its base form."""
	if not item:
		return item
	parts: list[str] = item.split(":")
	if len(parts) >= 2 and parts[0] in ("i", "p"):
		return f"{parts[0]}:{parts[1]}"
	return item


def item_id(item: str) -> str:
	parts: list[str] = item.split(":")
	return parts[1] if len(parts) >= 2 else item


def wowhead_url(item: str) -> str:
	base: str = item_base(item)
	if base.startswith("p:"):
		return f"https://www.wowhead.com/battle-pet/{item_id(base)}"
	return f"https://www.wowhead.com/item={item_id(base)}"


@dataclass(slots=True)
class Character(object):
	"""One character as TSM knows it (from the s@ sync scope)."""

	key: str
	name: str
	faction: str
	realm: str
	account: str
	money: int = 0
	class_key: str = ""
	professions: dict[str, Any] = field(default_factory=dict)
	guild: str = ""
	gold_log: list[tuple[int, int]] = field(default_factory=list)
	gold_log_updated: int = 0


@dataclass(slots=True)
class Txn(object):
	"""
	One accounting record. For sale/buy, `price` is per item and `qty` the
	total units; for income/expense, `price` is the amount and `qty` is 1;
	for expire/cancel, `price` is 0.
	"""

	kind: str
	realm: str
	account: str
	time: int
	player: str
	other: str = ""
	item: str = ""
	stack: int = 0
	qty: int = 0
	price: int = 0
	source: str = ""
	internal: bool = False

	@property
	def total(self) -> int:
		return self.price * self.qty


@dataclass(slots=True)
class Holding(object):
	"""A quantity of an item sitting somewhere (bags, bank, AH, warbank...)."""

	account: str
	realm: str
	faction: str
	owner: str
	location: str
	item: str
	qty: int


@dataclass(slots=True)
class ItemInfo(object):
	"""Decoded entry of TSM's item-info cache."""

	item: str
	name: str
	item_level: int = -1
	min_level: int = -1
	vendor_sell: int = -1
	max_stack: int = -1
	quality: int = -1
	class_id: int = -1
	subclass_id: int = -1
	is_bop: int = -1
	is_reagent: int = -1
	expansion: int = -1
	crafted_quality: int = -1


@dataclass
class SvFileInfo(object):
	account: str
	path: Path
	size: int
	mtime: float


def _parse_minute_log(text: Any) -> list[tuple[int, int]]:
	"""Decode TSM's "minute,copper" gold log CSV into [(epoch, copper)]."""
	result: list[tuple[int, int]] = []
	if not isinstance(text, str):
		return result
	for line in text.split("\n")[1:]:
		parts: list[str] = line.split(",")
		if len(parts) == 2 and parts[0].isdigit():
			try:
				result.append((int(parts[0]) * 60, int(parts[1])))
			except ValueError:
				continue
	return result


def _to_int(text: str) -> int:
	try:
		return int(text)
	except ValueError:
		try:
			return int(float(text))
		except ValueError:
			return 0


class TsmData(object):
	"""
	Everything tsmctl knows, merged across all WoW accounts: characters,
	ledger, holdings, gold logs, item info, groups, and (lazily) the market.
	"""

	def __init__(self) -> None:
		self.accounts: list[str] = []
		self.files: list[SvFileInfo] = []
		self.characters: dict[str, Character] = {}
		self.txns: list[Txn] = []
		self.holdings: list[Holding] = []
		self.warbank_money: dict[str, int] = {}
		self.warbank_log: dict[str, list[tuple[int, int]]] = {}
		self.guild_logs: dict[str, list[tuple[int, int]]] = {}
		self.guild_realm: dict[str, str] = {}
		self.items: dict[str, ItemInfo] = {}
		self.items_by_base: dict[str, ItemInfo] = {}
		self.vendor_buy: dict[str, int] = {}
		self.groups: dict[str, str] = {}
		self.groups_by_base: dict[str, str] = {}
		self.group_paths: set[str] = set()
		self.trimmed: list[str] = []
		self.own_names: set[str] = set()
		self.market: Optional["Market"] = None
		self.appdata_path: Optional[Path] = None
		self._ledger_stats: Optional[dict[str, dict[str, Optional[int]]]] = None
		self._save_time: int = int(time.time())
		self.future_clamped: int = 0
		self._name_counts: Optional[dict[str, int]] = None

	# ------------------------------------------------------------------ load

	def load_account(self, account: str, path: Path) -> None:
		"""Parse one account's TradeSkillMaster.lua and merge it in."""
		stat: os.stat_result = path.stat()
		self.files.append(SvFileInfo(account, path, stat.st_size, stat.st_mtime))
		parsed: dict[str, Any] = parse_lua_file(path)
		db: dict[Any, Any] = lua_dict(parsed.get("TradeSkillMasterDB"))
		if not db:
			Log.warn(f"{path}: no TradeSkillMasterDB table; skipping account {account}")
			return
		self.accounts.append(account)
		sync_owner: dict[Any, Any] = lua_dict(db.get("_syncOwner"))
		sync_account: dict[Any, Any] = lua_dict(db.get("_syncAccountKey"))
		seen_txns: set[tuple[Any, ...]] = {self._txn_key(t) for t in self.txns}
		self._save_time = int(stat.st_mtime)

		for raw_key, value in db.items():
			if not isinstance(raw_key, str) or raw_key.startswith("_"):
				continue
			parts: list[str] = raw_key.split("@")
			if len(parts) != 4:
				continue
			scope, scope_key, section, name = parts
			if scope == "s" and section == "internalData":
				self._load_char_value(account, scope_key, name, value, sync_owner, sync_account)
			elif scope == "r" and section == "internalData":
				self._load_realm_value(account, scope_key, name, value, seen_txns)
			elif scope == "f" and section == "internalData":
				self._load_faction_value(account, scope_key, name, value)
			elif scope == "g" and section == "internalData":
				self._load_global_value(account, name, value)
			elif scope == "p" and section == "userData" and name in ("items", "groups"):
				self._load_groups(name, value)

		item_db: dict[Any, Any] = lua_dict(parsed.get("TSMItemInfoDB"))
		if item_db:
			self._load_item_info(item_db, str(path))

	def _char(self, account: str, scope_key: str, sync_owner: dict[Any, Any], sync_account: dict[Any, Any]) -> Optional[Character]:
		"""
		Get or create the Character for "Name - Faction - Realm". When TSM
		account sync mirrors a character into several accounts, the account
		that owns it wins.
		"""
		bits: list[str] = scope_key.split(" - ", 2)
		if len(bits) != 3:
			return None
		name, faction, realm = bits
		owned: bool = sync_owner.get(scope_key) is None or sync_owner.get(scope_key) == sync_account.get(f"{faction} - {realm}")
		existing: Optional[Character] = self.characters.get(scope_key)
		if existing is not None:
			if existing.account != account and not owned:
				return None
			if existing.account != account and owned:
				existing.account = account
			return existing
		char: Character = Character(key=scope_key, name=name, faction=faction, realm=realm, account=account)
		self.characters[scope_key] = char
		return char

	def _load_char_value(self, account: str, scope_key: str, name: str, value: Any, sync_owner: dict[Any, Any], sync_account: dict[Any, Any]) -> None:
		char: Optional[Character] = self._char(account, scope_key, sync_owner, sync_account)
		if char is None:
			return
		if name == "money" and isinstance(value, (int, float)):
			char.money = int(value)
		elif name == "classKey" and isinstance(value, str):
			char.class_key = value
		elif name == "playerProfessions":
			char.professions = lua_dict(value)
		elif name == "goldLog":
			char.gold_log = _parse_minute_log(value)
		elif name == "goldLogLastUpdate" and isinstance(value, (int, float)):
			char.gold_log_updated = int(value)
		elif name.endswith("Quantity"):
			# bagQuantity, bankQuantity, mailQuantity, auctionQuantity, ...
			location: str = name[: -len("Quantity")]
			self.holdings = [h for h in self.holdings if not (h.owner == char.name and h.realm == char.realm and h.location == location)]
			for item, qty in lua_dict(value).items():
				if isinstance(item, str) and isinstance(qty, (int, float)) and qty > 0:
					self.holdings.append(Holding(account, char.realm, char.faction, char.name, location, item, int(qty)))

	@staticmethod
	def _txn_key(t: Txn) -> tuple[Any, ...]:
		return (t.kind, t.realm, t.time, t.player, t.other, t.item, t.stack, t.qty, t.price, t.source)

	def _load_realm_value(self, account: str, realm: str, name: str, value: Any, seen: set[tuple[Any, ...]]) -> None:
		if name == "accountingTrimmed":
			for what, when in lua_dict(value).items():
				if when:
					self.trimmed.append(f"{realm} {what}")
			return
		kind: Optional[str] = next((k for k, v in LEDGER_KEYS.items() if v == name), None)
		if kind is None or not isinstance(value, str) or not value:
			return
		lines: list[str] = value.split("\n")
		header: list[str] = lines[0].split(",")
		bad: int = 0
		for line in lines[1:]:
			if not line:
				continue
			cols: list[str] = line.split(",")
			if len(cols) != len(header):
				bad += 1
				continue
			row: dict[str, str] = dict(zip(header, cols))
			txn: Txn
			if kind in ("sale", "buy"):
				txn = Txn(
					kind=kind, realm=realm, account=account, time=_to_int(row.get("time", "0")),
					player=row.get("player", ""), other=row.get("otherPlayer") or row.get("buyer") or row.get("seller") or "",
					item=row.get("itemString", ""), stack=_to_int(row.get("stackSize", "0")),
					qty=_to_int(row.get("quantity", "0")), price=_to_int(row.get("price", "0")),
					source=row.get("source", ""),
				)
			elif kind in ("income", "expense"):
				txn = Txn(
					kind=kind, realm=realm, account=account, time=_to_int(row.get("time", "0")),
					player=row.get("player", ""), other=row.get("otherPlayer", ""), qty=1,
					price=_to_int(row.get("amount", "0")), source=row.get("type", ""),
				)
			else:
				txn = Txn(
					kind=kind, realm=realm, account=account, time=_to_int(row.get("time", "0")),
					player=row.get("player", ""), item=row.get("itemString", ""),
					stack=_to_int(row.get("stackSize", "0")), qty=_to_int(row.get("quantity", "0")),
					source="Auction",
				)
			key: tuple[Any, ...] = self._txn_key(txn)
			if key in seen:
				continue
			seen.add(key)
			# TSM dates mail-based records as now + (daysLeft - 30) days, which
			# lands in the future for mail with long expiry (WoW Token sales).
			# Nothing can happen after the file was saved, so clamp to that.
			if txn.time > self._save_time + 3600:
				self.future_clamped += 1
				txn.time = self._save_time
			self.txns.append(txn)
		if bad:
			Log.warn(f"{realm} {name}: skipped {bad} malformed row(s)")

	def _load_faction_value(self, account: str, faction_realm: str, name: str, value: Any) -> None:
		bits: list[str] = faction_realm.split(" - ", 1)
		faction: str = bits[0] if len(bits) == 2 else ""
		realm: str = bits[1] if len(bits) == 2 else faction_realm
		if name == "guildVaults":
			for guild, items in lua_dict(value).items():
				owner: str = f"Guild: {guild}"
				self.guild_realm[str(guild)] = realm
				self.holdings = [h for h in self.holdings if not (h.owner == owner and h.realm == realm)]
				for item, qty in lua_dict(items).items():
					if isinstance(item, str) and isinstance(qty, (int, float)) and qty > 0:
						self.holdings.append(Holding(account, realm, faction, owner, "guild", item, int(qty)))
		elif name == "guildGoldLog":
			for guild, text in lua_dict(value).items():
				self.guild_logs[f"{guild} ({realm})"] = _parse_minute_log(text)
				self.guild_realm[str(guild)] = realm
		elif name == "characterGuilds":
			for char_name, guild in lua_dict(value).items():
				char: Optional[Character] = self.characters.get(f"{char_name} - {faction} - {realm}")
				if char is not None and isinstance(guild, str):
					char.guild = guild

	def _load_global_value(self, account: str, name: str, value: Any) -> None:
		if name == "warbankMoney" and isinstance(value, (int, float)):
			self.warbank_money[account] = int(value)
		elif name == "warbankGoldLog":
			self.warbank_log[account] = _parse_minute_log(value)
		elif name == "warbankQuantity":
			self.holdings = [h for h in self.holdings if not (h.owner == "Warbank" and h.account == account)]
			for item, qty in lua_dict(value).items():
				if isinstance(item, str) and isinstance(qty, (int, float)) and qty > 0:
					self.holdings.append(Holding(account, "", "", "Warbank", "warbank", item, int(qty)))
		elif name == "vendorItems":
			for item, price in lua_dict(value).items():
				if isinstance(item, str) and isinstance(price, (int, float)):
					self.vendor_buy.setdefault(item, int(price))
					self.vendor_buy.setdefault(item_base(item), int(price))

	def _load_groups(self, name: str, value: Any) -> None:
		if name == "groups":
			for path in lua_dict(value):
				if isinstance(path, str) and path:
					self.group_paths.add(path)
		else:
			for item, path in lua_dict(value).items():
				if isinstance(item, str) and isinstance(path, str) and path:
					self.groups.setdefault(item, path)
					self.groups_by_base.setdefault(item_base(item), path)
					self.group_paths.add(path)

	def _load_item_info(self, item_db: dict[Any, Any], origin: str) -> None:
		"""
		Decode TSMItemInfoDB: parallel arrays of names and item strings
		(\\x02-joined, possibly chunked) plus a 24-char-per-item packed record.
		"""
		def joined(value: Any) -> list[str]:
			out: list[str] = []
			for chunk in lua_list(value) if not isinstance(value, str) else [value]:
				if isinstance(chunk, str):
					out.extend(chunk.split(ITEMINFO_SEP))
			return out

		names: list[str] = joined(item_db.get("names"))
		strings: list[str] = joined(item_db.get("itemStrings"))
		data: Any = item_db.get("data")
		if not isinstance(data, str):
			data = "".join(c for c in lua_list(data) if isinstance(c, str))
		if len(names) != len(strings):
			Log.warn(f"{origin}: item cache names/itemStrings mismatch ({len(names)} vs {len(strings)}); item names may be missing")
			return
		decode: dict[str, int] = {ch: i for i, ch in enumerate(ITEMINFO_ALPHABET)}
		nil_char: str = ITEMINFO_ALPHABET[-1]

		def multi(chunk: str) -> int:
			if all(c == nil_char for c in chunk):
				return -1
			total: int = 0
			for shift, ch in enumerate(chunk):
				total += decode.get(ch, 0) << (6 * shift)
			return total

		def single(ch: str) -> int:
			value: int = decode.get(ch, 63)
			return -1 if value == 63 else value

		for index, (name, item) in enumerate(zip(names, strings)):
			if not item or not name:
				continue
			record: str = data[index * ITEMINFO_RECORD_LEN:(index + 1) * ITEMINFO_RECORD_LEN]
			info: ItemInfo = ItemInfo(item=item, name=name)
			if len(record) == ITEMINFO_RECORD_LEN:
				info.item_level = multi(record[0:2])
				info.min_level = multi(record[2:4])
				info.vendor_sell = multi(record[4:9])
				info.max_stack = multi(record[9:11])
				info.class_id = single(record[17])
				info.subclass_id = single(record[18])
				info.quality = single(record[19])
				info.is_bop = single(record[20])
				info.is_reagent = single(record[21])
				info.expansion = single(record[22])
				info.crafted_quality = single(record[23])
			if item not in self.items:
				self.items[item] = info
			base: str = item_base(item)
			if base not in self.items_by_base or base == item:
				self.items_by_base[base] = info

	def finish(self) -> None:
		"""Post-load fixups: own-name index, internal-transfer flags, sort."""
		for char in self.characters.values():
			self.own_names.add(char.name.lower())
			self.own_names.add(f"{char.name}-{char.realm.replace(' ', '')}".lower())
			self.own_names.add(f"{char.name}-{char.realm}".lower())
		for txn in self.txns:
			if txn.other and txn.other.lower() in self.own_names:
				txn.internal = True
		self.txns.sort(key=lambda t: t.time)
		if self.future_clamped:
			Log.warn(f"{self.future_clamped} ledger record(s) were dated in the future by TSM (mail expiry math, e.g. WoW Token sales); dated them at the SavedVariables save time instead")

	# --------------------------------------------------------------- lookups

	def item_info(self, item: str) -> Optional[ItemInfo]:
		return self.items.get(item) or self.items_by_base.get(item_base(item))

	def item_name(self, item: str) -> str:
		info: Optional[ItemInfo] = self.item_info(item)
		return info.name if info else item

	def name_is_ambiguous(self, name: str) -> bool:
		"""True when several base items share this name (e.g. the 15 "Blood Card"s)."""
		if self._name_counts is None:
			counts: dict[str, int] = {}
			for info in self.items_by_base.values():
				counts[info.name] = counts.get(info.name, 0) + 1
			self._name_counts = counts
		return self._name_counts.get(name, 0) > 1

	def group_of(self, item: str) -> str:
		return self.groups.get(item) or self.groups_by_base.get(item_base(item)) or ""

	def realms(self) -> list[str]:
		names: set[str] = {c.realm for c in self.characters.values()}
		names.update(t.realm for t in self.txns)
		return sorted(n for n in names if n)

	def ledger_stats(self) -> dict[str, dict[str, Optional[int]]]:
		"""All-time per-base-item sale/buy price stats for the avg*/min*/max* sources."""
		if self._ledger_stats is not None:
			return self._ledger_stats
		acc: dict[str, dict[str, Any]] = {}
		for t in self.txns:
			if t.kind not in ("sale", "buy") or t.internal or t.qty <= 0:
				continue
			entry: dict[str, Any] = acc.setdefault(item_base(t.item), {"sq": 0, "sv": 0, "bq": 0, "bv": 0, "smin": None, "smax": None, "bmin": None, "bmax": None})
			if t.kind == "sale":
				entry["sq"] += t.qty
				entry["sv"] += t.total
				entry["smin"] = t.price if entry["smin"] is None else min(entry["smin"], t.price)
				entry["smax"] = t.price if entry["smax"] is None else max(entry["smax"], t.price)
			else:
				entry["bq"] += t.qty
				entry["bv"] += t.total
				entry["bmin"] = t.price if entry["bmin"] is None else min(entry["bmin"], t.price)
				entry["bmax"] = t.price if entry["bmax"] is None else max(entry["bmax"], t.price)
		self._ledger_stats = {
			base: {
				"avg_sell": e["sv"] // e["sq"] if e["sq"] else None,
				"avg_buy": e["bv"] // e["bq"] if e["bq"] else None,
				"min_sell": e["smin"], "max_sell": e["smax"],
				"min_buy": e["bmin"], "max_buy": e["bmax"],
			}
			for base, e in acc.items()
		}
		return self._ledger_stats

	def search_items(self, query: str) -> list[str]:
		"""
		Resolve an item query to base item strings. Accepts i:123, 123,
		p:123, a wowhead URL, an exact name, or a name substring.
		"""
		query = query.strip()
		if not query:
			return []
		url: Optional[re.Match[str]] = re.search(r"item=(\d+)", query)
		if url:
			return [f"i:{url.group(1)}"]
		pet_url: Optional[re.Match[str]] = re.search(r"battle-pet/(\d+)", query)
		if pet_url:
			return [f"p:{pet_url.group(1)}"]
		if re.fullmatch(r"[ip]:\d+.*", query):
			return [item_base(query)]
		if query.isdigit():
			return [f"i:{query}"]
		lowered: str = query.lower()
		exact: list[str] = []
		partial: list[str] = []
		for base, info in self.items_by_base.items():
			name: str = info.name.lower()
			if name == lowered:
				exact.append(base)
			elif lowered in name:
				partial.append(base)
		if exact:
			return sorted(set(exact))
		return sorted(set(partial), key=lambda b: (len(self.item_name(b)), self.item_name(b)))


# ============================================================================
# Market data (AppData.lua)
# ============================================================================

@dataclass
class Dataset(object):
	"""One LoadData(...) block of AppData: fields plus raw per-item rows."""

	tag: str
	scope: str
	download_time: int
	fields: list[str]
	rows: dict[str, str]
	decoded: dict[str, list[int]] = field(default_factory=dict)

	def get(self, item: str, field_name: str) -> Optional[int]:
		"""Return a field for an item (exact, else base item), or None."""
		try:
			index: int = self.fields.index(field_name)
		except ValueError:
			return None
		values: Optional[list[int]] = self._row(item)
		if values is None:
			values = self._row(item_base(item))
		if values is None or index >= len(values):
			return None
		value: int = values[index]
		return value if value > 0 else None

	def _row(self, item: str) -> Optional[list[int]]:
		cached: Optional[list[int]] = self.decoded.get(item)
		if cached is not None:
			return cached
		raw: Optional[str] = self.rows.get(item)
		if raw is None:
			return None
		values: list[int] = []
		for part in raw.split(","):
			try:
				values.append(int(part, 32))
			except ValueError:
				values.append(0)
		self.decoded[item] = values
		return values


class Market(object):
	"""
	TSM AuctionDB data from AppData.lua. Realm-scoped datasets are per
	(connected) realm; commodity and region datasets are region-wide.
	"""

	LOAD_RE: re.Pattern[str] = re.compile(r'LoadData\("([A-Z_]+)","([^"]*)",\[(=*)\[(.*?)\]\3\]\)', re.S)
	ROW_RE: re.Pattern[str] = re.compile(r'\{"?([^,"{}]+)"?,([^{}]+)\}')

	def __init__(self, path: Path):
		self.path: Path = path
		self.mtime: float = path.stat().st_mtime
		self.realm_sets: dict[str, list[Dataset]] = {}
		self.commodity_sets: list[Dataset] = []
		self.region_sets: list[Dataset] = []
		self.region: str = ""
		self.app_sync: Optional[int] = None
		self._load()

	def _load(self) -> None:
		started: float = time.monotonic()
		try:
			text: str = self.path.read_text(encoding="utf-8", errors="replace")
		except OSError as exc:
			raise TsmctlError(f"cannot read {self.path}: {exc}") from exc
		for match in self.LOAD_RE.finditer(text):
			tag, where, _, body = match.groups()
			if tag == "APP_INFO":
				sync: Optional[re.Match[str]] = re.search(r"lastSync=(\d+)", body[:2000])
				self.app_sync = int(sync.group(1)) if sync else None
				continue
			if tag not in APPDATA_REALM_TAGS + APPDATA_COMMODITY_TAGS + APPDATA_REGION_TAGS:
				continue
			dataset: Optional[Dataset] = self._parse_dataset(tag, where, body)
			if dataset is None:
				continue
			if tag in APPDATA_REALM_TAGS:
				self.realm_sets.setdefault(where, []).append(dataset)
			elif tag in APPDATA_COMMODITY_TAGS:
				self.commodity_sets.append(dataset)
				self.region = self.region or where
			else:
				self.region_sets.append(dataset)
				self.region = self.region or where
		Log.debug(f"loaded AppData in {time.monotonic() - started:.2f}s")

	def _parse_dataset(self, tag: str, where: str, body: str) -> Optional[Dataset]:
		"""Parse `return {downloadTime=..,fields={..},data={{..},..}}`."""
		data_at: int = body.find(",data={")
		if data_at < 0:
			Log.warn(f"AppData {tag} {where}: no data block")
			return None
		meta: str = body[:data_at]
		when: Optional[re.Match[str]] = re.search(r"downloadTime=(\d+)", meta)
		fields_match: Optional[re.Match[str]] = re.search(r"fields=\{([^}]*)\}", meta)
		if not fields_match:
			Log.warn(f"AppData {tag} {where}: no field list")
			return None
		fields: list[str] = [f.strip().strip('"') for f in fields_match.group(1).split(",") if f.strip()]
		if not fields or fields[0] != "itemString":
			Log.warn(f"AppData {tag} {where}: unexpected fields {fields}")
			return None
		rows: dict[str, str] = {}
		for row in self.ROW_RE.finditer(body, data_at + len(",data={")):
			item: str = row.group(1)
			if item.isdigit():
				item = f"i:{item}"
			rows[item] = row.group(2)
		scope: str = "realm" if tag in APPDATA_REALM_TAGS else ("commodity" if tag in APPDATA_COMMODITY_TAGS else "region")
		return Dataset(tag=tag, scope=scope, download_time=int(when.group(1)) if when else 0, fields=fields[1:], rows=rows)

	def realm_names(self) -> list[str]:
		return sorted(self.realm_sets)

	def has_realm(self, realm: str) -> bool:
		return realm in self.realm_sets

	def realm_value(self, item: str, field_name: str, realm: str) -> Optional[int]:
		"""Realm field: the realm's non-commodity data, then region commodity data."""
		for dataset in self.realm_sets.get(realm, []):
			if field_name in dataset.fields:
				value: Optional[int] = dataset.get(item, field_name)
				if value is not None:
					return value
		for dataset in self.commodity_sets:
			if field_name in dataset.fields:
				value = dataset.get(item, field_name)
				if value is not None:
					return value
		return None

	def region_value(self, item: str, field_name: str) -> Optional[int]:
		for dataset in self.region_sets:
			if field_name in dataset.fields:
				value: Optional[int] = dataset.get(item, field_name)
				if value is not None:
					return value
		return None

	def realm_items(self, realm: str, include_commodities: bool) -> set[str]:
		"""Every item with a min buyout on the realm (optionally commodities too)."""
		items: set[str] = set()
		for dataset in self.realm_sets.get(realm, []):
			if "minBuyout" in dataset.fields:
				items.update(dataset.rows)
		if include_commodities:
			for dataset in self.commodity_sets:
				if "minBuyout" in dataset.fields:
					items.update(dataset.rows)
		return items

	def datasets(self) -> list[tuple[str, Dataset]]:
		out: list[tuple[str, Dataset]] = []
		for realm, sets in sorted(self.realm_sets.items()):
			out.extend((realm, d) for d in sets)
		out.extend((self.region or "region", d) for d in self.commodity_sets)
		out.extend((self.region or "region", d) for d in self.region_sets)
		return out

	def realm_download_time(self, realm: str) -> Optional[int]:
		times: list[int] = [d.download_time for d in self.realm_sets.get(realm, []) if d.tag == "AUCTIONDB_NON_COMMODITY_DATA"]
		return max(times) if times else None


# ============================================================================
# Price expressions (a safe subset of TSM custom price strings)
# ============================================================================

PRICE_TOKEN_RE: re.Pattern[str] = re.compile(r"\s*(?:(\d+(?:\.\d+)?)([gsc]?)|([A-Za-z_][A-Za-z0-9_]*)|(.))")


class PriceExpr(object):
	"""
	Parse and evaluate expressions such as:

	    dbmarket
	    min(dbmarket, dbregionmarketavg)
	    first(dbmarket, dbregionmarketavg, vendorsell)
	    80% dbmarket
	    dbmarket - 10g
	    max(vendorsell, 0.5 * dbregionsaleavg)
	    check(dbregionsaleavg, dbmarket, vendorsell)

	Functions: min, max, avg, first, check(cond, then[, else]) which yields
	`then` when `cond` is present and positive, else `else`. Operators:
	+ - * / and N% (prefix).
	Money literals: 10g, 50s, 25c, 1g50s. Bare numbers are plain numbers.
	A missing source yields None, which propagates through arithmetic;
	min/max/avg ignore missing arguments and first returns the first present.
	"""

	FUNCTIONS: tuple[str, ...] = ("min", "max", "avg", "first", "check")

	def __init__(self, text: str):
		self.text: str = text
		self.tokens: list[tuple[str, Any]] = self._tokenize(text)
		self.pos: int = 0
		self.ast: Any = self._expr()
		if self.pos != len(self.tokens):
			raise TsmctlError(f"price expression {text!r}: unexpected {self.tokens[self.pos][1]!r}")

	@staticmethod
	def _tokenize(text: str) -> list[tuple[str, Any]]:
		tokens: list[tuple[str, Any]] = []
		pos: int = 0
		stripped: str = text.rstrip()
		while pos < len(stripped):
			match: Optional[re.Match[str]] = PRICE_TOKEN_RE.match(stripped, pos)
			if match is None:
				break
			number, unit, name, other = match.groups()
			if number is not None:
				value: float = float(number)
				if unit:
					value *= {"g": COPPER_PER_GOLD, "s": COPPER_PER_SILVER, "c": 1}[unit]
					# 1g50s25c: merge adjacent money parts into one literal.
					if tokens and tokens[-1][0] == "money":
						tokens[-1] = ("money", tokens[-1][1] + value)
						pos = match.end()
						continue
					tokens.append(("money", value))
				else:
					tokens.append(("num", value))
			elif name is not None:
				tokens.append(("name", name.lower()))
			elif other is not None:
				tokens.append(("op", other))
			pos = match.end()
		return tokens

	def _peek(self) -> Optional[tuple[str, Any]]:
		return self.tokens[self.pos] if self.pos < len(self.tokens) else None

	def _take(self) -> tuple[str, Any]:
		token: Optional[tuple[str, Any]] = self._peek()
		if token is None:
			raise TsmctlError(f"price expression {self.text!r}: unexpected end")
		self.pos += 1
		return token

	def _expr(self) -> Any:
		node: Any = self._term()
		while self._peek() in (("op", "+"), ("op", "-")):
			op: str = self._take()[1]
			node = ("bin", op, node, self._term())
		return node

	def _term(self) -> Any:
		node: Any = self._factor()
		while self._peek() in (("op", "*"), ("op", "/")):
			op: str = self._take()[1]
			node = ("bin", op, node, self._factor())
		return node

	def _factor(self) -> Any:
		token: tuple[str, Any] = self._take()
		kind, value = token
		if kind == "num" and self._peek() == ("op", "%"):
			self._take()
			return ("bin", "*", ("const", value / 100.0), self._factor())
		if kind in ("num", "money"):
			return ("const", value)
		if kind == "op" and value == "(":
			node: Any = self._expr()
			if self._take() != ("op", ")"):
				raise TsmctlError(f"price expression {self.text!r}: missing ')'")
			return node
		if kind == "op" and value == "-":
			return ("bin", "-", ("const", 0.0), self._factor())
		if kind == "name":
			if self._peek() == ("op", "("):
				if value not in self.FUNCTIONS:
					raise TsmctlError(f"price expression {self.text!r}: unknown function {value!r} (use {', '.join(self.FUNCTIONS)})")
				self._take()
				args: list[Any] = [self._expr()]
				while self._peek() == ("op", ","):
					self._take()
					args.append(self._expr())
				if self._take() != ("op", ")"):
					raise TsmctlError(f"price expression {self.text!r}: missing ')' after {value}(")
				if value == "check" and len(args) not in (2, 3):
					raise TsmctlError(f"price expression {self.text!r}: check() takes 2 or 3 arguments")
				return ("call", value, args)
			if value not in PRICE_SOURCES:
				raise TsmctlError(f"price expression {self.text!r}: unknown source {value!r} (see `tsmctl get sources`)")
			return ("src", value)
		raise TsmctlError(f"price expression {self.text!r}: unexpected {value!r}")

	def evaluate(self, pricer: "Pricer", item: str, realm: str) -> Optional[float]:
		return self._eval(self.ast, pricer, item, realm)

	def _eval(self, node: Any, pricer: "Pricer", item: str, realm: str) -> Optional[float]:
		kind: str = node[0]
		if kind == "const":
			return float(node[1])
		if kind == "src":
			return pricer.source(node[1], item, realm)
		if kind == "bin":
			left: Optional[float] = self._eval(node[2], pricer, item, realm)
			right: Optional[float] = self._eval(node[3], pricer, item, realm)
			if left is None or right is None:
				return None
			if node[1] == "+":
				return left + right
			if node[1] == "-":
				return left - right
			if node[1] == "*":
				return left * right
			return left / right if right else None
		if node[1] == "check":
			condition: Optional[float] = self._eval(node[2][0], pricer, item, realm)
			if condition is not None and condition > 0:
				return self._eval(node[2][1], pricer, item, realm)
			return self._eval(node[2][2], pricer, item, realm) if len(node[2]) == 3 else None
		values: list[float] = [v for v in (self._eval(a, pricer, item, realm) for a in node[2]) if v is not None]
		if not values:
			return None
		name: str = node[1]
		if name == "min":
			return min(values)
		if name == "max":
			return max(values)
		if name == "avg":
			return sum(values) / len(values)
		return values[0]


class Pricer(object):
	"""Evaluates price sources and expressions against the loaded data."""

	def __init__(self, data: TsmData, settings: Settings):
		self.data: TsmData = data
		self.settings: Settings = settings
		self._exprs: dict[str, PriceExpr] = {}
		self._default_realm: Optional[str] = None

	def expr(self, text: str) -> PriceExpr:
		if text not in self._exprs:
			self._exprs[text] = PriceExpr(text)
		return self._exprs[text]

	def source(self, name: str, item: str, realm: str) -> Optional[float]:
		spec: dict[str, Any] = PRICE_SOURCES[name]
		scope: str = spec["scope"]
		raw: Optional[float] = None
		market: Optional[Market] = self.data.market
		if scope == "realm":
			raw = market.realm_value(item, spec["field"], realm) if market else None
		elif scope == "region":
			raw = market.region_value(item, spec["field"]) if market else None
		elif scope == "item":
			if spec["field"] == "vendor_sell":
				info: Optional[ItemInfo] = self.data.item_info(item)
				raw = info.vendor_sell if info and info.vendor_sell > 0 else None
			else:
				raw = self.data.vendor_buy.get(item) or self.data.vendor_buy.get(item_base(item))
		elif scope == "ledger":
			raw = self.data.ledger_stats().get(item_base(item), {}).get(spec["field"])
		if raw is None:
			return None
		return float(raw) / spec["scale"]

	def price(self, text: str, item: str, realm: str) -> Optional[int]:
		value: Optional[float] = self.expr(text).evaluate(self, item, realm)
		return int(round(value)) if value is not None else None

	def default_realm(self) -> str:
		"""Realm used when a value has no realm of its own (warbank items); cached."""
		if self._default_realm is None:
			self._default_realm = self._pick_default_realm()
		return self._default_realm

	def _pick_default_realm(self) -> str:
		"""Configured realm, else the realm with the most sales, else the first known."""
		if self.settings.realm:
			return resolve_realm(self.settings.realm, self.data, self.data.market)
		counts: dict[str, int] = {}
		for t in self.data.txns:
			if t.kind == "sale":
				counts[t.realm] = counts.get(t.realm, 0) + 1
		if counts:
			return max(counts, key=lambda r: counts[r])
		realms: list[str] = self.data.realms()
		return realms[0] if realms else ""


def resolve_realm(query: str, data: TsmData, market: Optional[Market]) -> str:
	"""Resolve a realm name case-insensitively, by exact name then prefix/substring."""
	candidates: set[str] = set(data.realms())
	if market is not None:
		candidates.update(market.realm_names())
	lowered: str = query.lower().strip()
	for name in candidates:
		if name.lower() == lowered:
			return name
	prefix: list[str] = sorted(n for n in candidates if n.lower().startswith(lowered))
	if len(prefix) == 1:
		return prefix[0]
	contains: list[str] = sorted(n for n in candidates if lowered in n.lower())
	if len(contains) == 1:
		return contains[0]
	options: list[str] = prefix or contains
	if options:
		raise TsmctlError(f"realm {query!r} is ambiguous: {', '.join(options)}")
	raise TsmctlError(f"unknown realm {query!r}; known: {', '.join(sorted(candidates)) or 'none'}")


# ============================================================================
# Time handling
# ============================================================================

RELATIVE_RE: re.Pattern[str] = re.compile(r"^(\d+)\s*(h|hr|hours?|d|days?|w|wk|weeks?|m|mo|months?|y|yr|years?)$", re.I)


def local_midnight(when: datetime) -> datetime:
	return when.replace(hour=0, minute=0, second=0, microsecond=0)


def parse_when(text: str, now: Optional[datetime] = None) -> Optional[int]:
	"""
	Parse a time bound into an epoch. Accepts: all, now, today, yesterday,
	week (since Monday), month, year/ytd, relative amounts (12h, 7d, 2w,
	3m, 1y), dates (2026-09-01), datetimes (2026-09-01T12:00) and epochs.
	"""
	now = now or datetime.now().astimezone()
	value: str = text.strip().lower()
	if value in ("all", "ever", "forever", "beginning"):
		return None
	if value == "now":
		return int(now.timestamp())
	if value == "today":
		return int(local_midnight(now).timestamp())
	if value == "yesterday":
		return int((local_midnight(now) - timedelta(days=1)).timestamp())
	if value in ("week", "this-week"):
		return int((local_midnight(now) - timedelta(days=now.weekday())).timestamp())
	if value in ("month", "this-month"):
		return int(local_midnight(now).replace(day=1).timestamp())
	if value in ("year", "ytd", "this-year"):
		return int(local_midnight(now).replace(month=1, day=1).timestamp())
	relative: Optional[re.Match[str]] = RELATIVE_RE.match(value)
	if relative:
		amount: int = int(relative.group(1))
		unit: str = relative.group(2)[0]
		if relative.group(2).startswith("mo") or unit == "m":
			delta: timedelta = timedelta(days=30 * amount)
		else:
			delta = timedelta(hours=amount) if unit == "h" else timedelta(days=amount * {"d": 1, "w": 7, "y": 365}[unit])
		return int((now - delta).timestamp())
	if re.fullmatch(r"\d{9,11}", value):
		return int(value)
	try:
		parsed: datetime = datetime.fromisoformat(text.strip())
	except ValueError as exc:
		raise TsmctlError(f"cannot parse time {text!r} (try 7d, 2w, today, week, month, ytd, 2026-09-01)") from exc
	if parsed.tzinfo is None:
		parsed = parsed.astimezone()
	return int(parsed.timestamp())


def parse_period(text: str) -> tuple[Optional[int], Optional[int]]:
	"""Named periods that set both bounds: today, yesterday, this/last week|month|year, or any --since value."""
	now: datetime = datetime.now().astimezone()
	value: str = text.strip().lower()
	midnight: datetime = local_midnight(now)
	if value == "yesterday":
		return int((midnight - timedelta(days=1)).timestamp()), int(midnight.timestamp())
	if value == "last-week":
		start: datetime = midnight - timedelta(days=now.weekday() + 7)
		return int(start.timestamp()), int((start + timedelta(days=7)).timestamp())
	if value == "last-month":
		first: datetime = midnight.replace(day=1)
		prev: datetime = (first - timedelta(days=1)).replace(day=1)
		return int(prev.timestamp()), int(first.timestamp())
	if value == "last-year":
		first_year: datetime = midnight.replace(month=1, day=1)
		return int(first_year.replace(year=first_year.year - 1).timestamp()), int(first_year.timestamp())
	return parse_when(text, now), None


def fmt_time(epoch: Optional[float]) -> str:
	if not epoch:
		return "-"
	return datetime.fromtimestamp(epoch).astimezone().strftime("%Y-%m-%d %H:%M")


def fmt_date(epoch: Optional[float]) -> str:
	if not epoch:
		return "-"
	return datetime.fromtimestamp(epoch).astimezone().strftime("%Y-%m-%d")


def fmt_age(seconds: float) -> str:
	"""Compact age: 45s, 12m, 3.5h, 2.1d."""
	seconds = max(0.0, seconds)
	if seconds < 60:
		return f"{int(seconds)}s"
	if seconds < 3600:
		return f"{int(seconds // 60)}m"
	if seconds < SECONDS_PER_DAY:
		return f"{seconds / 3600:.1f}h"
	return f"{seconds / SECONDS_PER_DAY:.1f}d"


def iso_now() -> str:
	return datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")


def bucket_of(epoch: int, by: str) -> tuple[str, str]:
	"""Return (sort key, label) for a day/week/month bucket in local time."""
	moment: datetime = datetime.fromtimestamp(epoch).astimezone()
	if by == "day":
		label: str = moment.strftime("%Y-%m-%d")
		return label, label
	if by == "week":
		monday: date = (moment - timedelta(days=moment.weekday())).date()
		iso: tuple[int, int, int] = monday.isocalendar()
		return monday.isoformat(), f"{iso[0]}-W{iso[1]:02d} ({monday.strftime('%m-%d')})"
	if by == "month":
		label = moment.strftime("%Y-%m")
		return label, label
	if by == "year":
		label = moment.strftime("%Y")
		return label, label
	raise TsmctlError(f"unknown time bucket {by!r}")


def bucket_edges(start: int, end: int, by: str) -> list[int]:
	"""Bucket end boundaries (exclusive) from start..end in local time."""
	moment: datetime = local_midnight(datetime.fromtimestamp(start).astimezone())
	if by == "week":
		moment -= timedelta(days=moment.weekday())
	elif by == "month":
		moment = moment.replace(day=1)
	edges: list[int] = []
	while True:
		if by == "day":
			moment += timedelta(days=1)
		elif by == "week":
			moment += timedelta(days=7)
		else:
			moment = (moment.replace(day=28) + timedelta(days=4)).replace(day=1)
		edges.append(int(moment.timestamp()))
		if edges[-1] >= end or len(edges) > 2000:
			break
	return edges


# ============================================================================
# Money parsing/formatting
# ============================================================================

MONEY_RE: re.Pattern[str] = re.compile(r"^\s*(-)?\s*(?:(\d[\d,]*(?:\.\d+)?)\s*g)?\s*(?:(\d+)\s*s)?\s*(?:(\d+)\s*c)?\s*$", re.I)


def parse_money(text: str) -> int:
	"""Parse 1500, 1500g, 12g50s, 75s, 30c, -5g into copper. Bare numbers are gold."""
	value: str = text.strip()
	if re.fullmatch(r"-?\d[\d,]*(?:\.\d+)?", value):
		return int(round(float(value.replace(",", "")) * COPPER_PER_GOLD))
	match: Optional[re.Match[str]] = MONEY_RE.match(value)
	if not match or not any(match.group(i) for i in (2, 3, 4)):
		raise TsmctlError(f"cannot parse money {text!r} (try 250g, 12g50s, 75s)")
	copper: float = float((match.group(2) or "0").replace(",", "")) * COPPER_PER_GOLD
	copper += int(match.group(3) or 0) * COPPER_PER_SILVER + int(match.group(4) or 0)
	return -int(round(copper)) if match.group(1) else int(round(copper))


def fmt_money(copper: Optional[float], style: str) -> str:
	if copper is None:
		return "-"
	value: int = int(round(copper))
	sign: str = "-" if value < 0 else ""
	value = abs(value)
	if style == "copper":
		return f"{sign}{value}"
	if style == "gsc":
		gold, rest = divmod(value, COPPER_PER_GOLD)
		silver, cop = divmod(rest, COPPER_PER_SILVER)
		if gold:
			return f"{sign}{gold:,}g {silver:02d}s {cop:02d}c"
		if silver:
			return f"{sign}{silver}s {cop:02d}c"
		return f"{sign}{cop}c"
	return f"{sign}{value / COPPER_PER_GOLD:,.2f}g"


# ============================================================================
# Output model: documents, sections, tables
# ============================================================================

class Column(object):
	"""
	A table column. kind drives formatting: str, int, num, rate, money,
	pct, time, date, item. signed colours money/pct red/green in text.
	wide columns only show with -o wide (and always in csv/tsv/json/org).
	"""

	def __init__(self, key: str, title: str, kind: str = "str", signed: bool = False, wide: bool = False, max_width: int = 0):
		self.key: str = key
		self.title: str = title
		self.kind: str = kind
		self.signed: bool = signed
		self.wide: bool = wide
		self.max_width: int = max_width

	@property
	def numeric(self) -> bool:
		return self.kind in ("int", "num", "rate", "money", "pct")


class Table(object):
	def __init__(self, columns: list[Column], rows: list[dict[str, Any]], title: str = "", totals: Optional[dict[str, Any]] = None, empty: str = "no rows"):
		self.columns: list[Column] = columns
		self.rows: list[dict[str, Any]] = rows
		self.title: str = title
		self.totals: Optional[dict[str, Any]] = totals
		self.empty: str = empty
		self.truncated_from: int = 0

	def column(self, key: str) -> Optional[Column]:
		return next((c for c in self.columns if c.key == key), None)

	def sort(self, key: str, reverse: bool = False) -> None:
		"""Sort rows by a column. Numbers sort high-first, text A-Z; --reverse flips."""
		column: Optional[Column] = self.column(key)
		if column is None:
			raise TsmctlError(f"cannot sort by {key!r}; columns: {', '.join(c.key for c in self.columns)}")
		descending: bool = column.numeric or column.kind in ("time", "date")
		if reverse:
			descending = not descending
		present: list[dict[str, Any]] = [r for r in self.rows if r.get(key) is not None]
		missing: list[dict[str, Any]] = [r for r in self.rows if r.get(key) is None]

		def sort_key(row: dict[str, Any]) -> Any:
			value: Any = row.get(key)
			return value.lower() if isinstance(value, str) else value

		present.sort(key=sort_key, reverse=descending)
		self.rows = present + missing

	def limit(self, count: int) -> None:
		if count and len(self.rows) > count:
			self.truncated_from = len(self.rows)
			self.rows = self.rows[:count]


class Section(object):
	"""A titled block of content: key/value lists, tables and text lines."""

	def __init__(self, title: str, level: int = 1):
		self.title: str = title
		self.level: int = level
		self.blocks: list[tuple[str, Any]] = []

	def kv(self, pairs: list[tuple[str, Any, str]]) -> "Section":
		self.blocks.append(("kv", pairs))
		return self

	def table(self, table: Table) -> "Section":
		self.blocks.append(("table", table))
		return self

	def text(self, line: str) -> "Section":
		self.blocks.append(("text", line))
		return self


class Doc(object):
	"""A rendered unit of output. `main` is the table --sort/--limit act on."""

	def __init__(self, title: str, slug: str):
		self.title: str = title
		self.slug: str = slug
		self.sections: list[Section] = []
		self.main: Optional[Table] = None

	def section(self, title: str, level: int = 1) -> Section:
		section: Section = Section(title, level)
		self.sections.append(section)
		return section


@dataclass
class RenderOptions(object):
	fmt: str
	money: str
	color: bool
	links: bool
	ids: bool
	wide: bool
	width: int


def _as_any(value: Any) -> Any:
	"""Drop type narrowing after a label check (cells hold numbers or labels)."""
	return value


class Renderer(object):
	"""Turns a Doc into text, org, csv, tsv or json."""

	def __init__(self, data: Optional[TsmData], opts: RenderOptions):
		self.data: Optional[TsmData] = data
		self.opts: RenderOptions = opts

	# ---------------------------------------------------------------- cells

	def item_label(self, item: str) -> str:
		if not item:
			return "-"
		name: str = self.data.item_name(item) if self.data else item
		if name == item:
			return item
		if self.opts.ids or (self.data is not None and self.data.name_is_ambiguous(name)):
			return f"{name} ({item})"
		return name

	def cell(self, value: Any, kind: str) -> str:
		"""Plain-text form of one value for text/org output."""
		if value is None or value == "":
			return "-"
		if isinstance(value, str) and kind not in ("str", "item"):
			# Labels such as "TOTAL" or "12 rows" in a typed column.
			return value
		value = _as_any(value)
		if kind == "money":
			return fmt_money(value, self.opts.money)
		if kind == "pct":
			return f"{value * 100:.1f}%"
		if kind == "int":
			return f"{int(value):,}"
		if kind == "num":
			return f"{value:,.2f}"
		if kind == "rate":
			return f"{value:.3f}"
		if kind == "time":
			return fmt_time(value)
		if kind == "date":
			return fmt_date(value)
		if kind == "item":
			return self.item_label(str(value))
		return str(value)

	def raw(self, value: Any, kind: str) -> Any:
		"""Machine form of one value for csv/tsv/json output."""
		if value is None:
			return None
		if isinstance(value, str) and kind not in ("str", "item"):
			return value
		value = _as_any(value)
		if kind == "money":
			return int(round(value))
		if kind in ("time", "date"):
			return datetime.fromtimestamp(value).astimezone().isoformat() if value else None
		if kind == "pct":
			return round(float(value), 6)
		return value

	def paint(self, text: str, value: Any, column: Optional[Column]) -> str:
		if not self.opts.color or column is None:
			return text
		if column.signed and isinstance(value, (int, float)):
			if value < 0:
				return f"{ANSI['red']}{text}{ANSI['reset']}"
			if value > 0:
				return f"{ANSI['green']}{text}{ANSI['reset']}"
		if column.kind == "item" and text != "-":
			return f"{ANSI['cyan']}{text}{ANSI['reset']}"
		return text

	def style(self, text: str, name: str) -> str:
		return f"{ANSI[name]}{text}{ANSI['reset']}" if self.opts.color else text

	def visible(self, table: Table) -> list[Column]:
		if self.opts.fmt in ("text",) and not self.opts.wide:
			return [c for c in table.columns if not c.wide]
		return table.columns

	# ------------------------------------------------------------- dispatch

	def render(self, doc: Doc) -> str:
		fmt: str = self.opts.fmt
		if fmt == "text":
			return self.render_text(doc)
		if fmt == "org":
			return self.render_org(doc, base_level=1)
		if fmt in ("csv", "tsv"):
			return self.render_delimited(doc, "," if fmt == "csv" else "\t")
		if fmt == "json":
			return self.render_json(doc)
		raise TsmctlError(f"unknown output format {fmt!r}")

	# ----------------------------------------------------------------- text

	def render_text(self, doc: Doc) -> str:
		out: list[str] = []
		for index, section in enumerate(doc.sections):
			if section.title:
				if index:
					out.append("")
				heading: str = section.title if section.level <= 1 else f"{section.title}"
				out.append(self.style(heading, "bold") if section.level <= 1 else self.style(heading, "yellow"))
				out.append(self.style(("=" if section.level <= 1 else "-") * len(heading), "dim"))
			for kind, payload in section.blocks:
				if kind == "kv":
					out.extend(self._text_kv(payload))
				elif kind == "table":
					out.extend(self._text_table(payload))
				else:
					out.append(payload)
		return "\n".join(out).rstrip() + "\n"

	def _text_kv(self, pairs: list[tuple[str, Any, str]]) -> list[str]:
		width: int = max((len(label) for label, _, _ in pairs), default=0)
		lines: list[str] = []
		for label, value, kind in pairs:
			text: str = self.cell(value, kind)
			column: Column = Column("v", label, kind, signed=kind in ("money", "pct") and label.lower().startswith(("net", "profit", "change", "realized", "unrealized", "p&l")))
			lines.append(f"  {label.ljust(width)}  {self.paint(text, value, column)}")
		return lines

	def _text_table(self, table: Table) -> list[str]:
		lines: list[str] = []
		if table.title:
			lines.append(self.style(table.title, "bold"))
		if not table.rows:
			lines.append(f"  ({table.empty})")
			return lines
		columns: list[Column] = self.visible(table)
		body: list[list[str]] = [[self.cell(row.get(c.key), c.kind) for c in columns] for row in table.rows]
		total_row: Optional[list[str]] = [self.cell(table.totals.get(c.key), c.kind) if c.key in table.totals else "" for c in columns] if table.totals else None
		widths: list[int] = [len(c.title) for c in columns]
		for row_cells in body + ([total_row] if total_row else []):
			for i, text in enumerate(row_cells):
				widths[i] = max(widths[i], len(text))
		for i, column in enumerate(columns):
			if column.max_width and not self.opts.wide:
				widths[i] = min(widths[i], max(column.max_width, len(column.title)))
		self._fit(columns, widths)

		def fit(text: str, i: int) -> str:
			if len(text) > widths[i]:
				text = text[: max(1, widths[i] - 1)] + "…"
			return text.rjust(widths[i]) if columns[i].numeric else text.ljust(widths[i])

		header: str = "  ".join(fit(c.title.upper(), i) for i, c in enumerate(columns)).rstrip()
		lines.append(self.style(header, "bold"))
		for row, row_cells in zip(table.rows, body):
			parts: list[str] = [self.paint(fit(text, i), row.get(columns[i].key), columns[i]) for i, text in enumerate(row_cells)]
			lines.append("  ".join(parts).rstrip())
		if total_row and table.totals:
			lines.append(self.style("  ".join("─" * w for w in widths), "dim"))
			parts = [self.paint(fit(text, i), table.totals.get(columns[i].key), columns[i]) for i, text in enumerate(total_row)]
			lines.append(self.style("  ".join(parts).rstrip(), "bold"))
		if table.truncated_from:
			lines.append(self.style(f"  … {table.truncated_from - len(table.rows)} more row(s); use -n 0 for all", "dim"))
		return lines

	def _fit(self, columns: list[Column], widths: list[int]) -> None:
		"""Shrink the widest text columns until the table fits the terminal."""
		if self.opts.wide:
			return
		budget: int = self.opts.width
		while sum(widths) + 2 * (len(widths) - 1) > budget:
			candidates: list[int] = [i for i, c in enumerate(columns) if not c.numeric and widths[i] > 12]
			if not candidates:
				break
			widest: int = max(candidates, key=lambda i: widths[i])
			widths[widest] -= 1

	# ------------------------------------------------------------------ org

	def org_cell(self, value: Any, column: Column) -> str:
		if column.kind == "item" and value and ITEM_STRING_RE.match(str(value)):
			label: str = self.item_label(str(value))
			text: str = f"[[{wowhead_url(str(value))}][{label}]]" if self.opts.links else label
		else:
			text = self.cell(value, column.kind)
		return text.replace("|", "¦")

	def render_org(self, doc: Doc, base_level: int = 1) -> str:
		out: list[str] = []
		for section in doc.sections:
			if section.title:
				out.append(f"{'*' * (base_level + section.level - 1)} {section.title}")
				out.append("")
			blocks: list[tuple[str, Any]] = section.blocks
			for index, (kind, payload) in enumerate(blocks):
				if kind == "kv":
					for label, value, vkind in payload:
						column: Column = Column("v", label, vkind)
						out.append(f"- {label.strip()} :: {self.org_cell(value, column)}")
					out.append("")
				elif kind == "table":
					out.extend(self._org_table(payload))
					out.append("")
				else:
					out.append(payload)
					# Keep consecutive "- " bullet lines in one list.
					following: Optional[tuple[str, Any]] = blocks[index + 1] if index + 1 < len(blocks) else None
					if not (payload.startswith("- ") and following is not None and following[0] == "text" and str(following[1]).startswith("- ")):
						out.append("")
		return "\n".join(out).rstrip() + "\n"

	def _org_table(self, table: Table) -> list[str]:
		lines: list[str] = []
		if table.title:
			lines.append(f"#+caption: {table.title}")
		if not table.rows:
			lines.append(f"/{table.empty}/")
			return lines
		columns: list[Column] = table.columns
		body: list[list[str]] = [[self.org_cell(row.get(c.key), c) for c in columns] for row in table.rows]
		totals: Optional[list[str]] = [self.org_cell(table.totals.get(c.key), c) if c.key in table.totals else "" for c in columns] if table.totals else None
		# Align on the width org displays: a [[url][desc]] link shows as desc.
		def shown(text: str) -> int:
			return len(ORG_LINK_RE.sub(r"\1", text))
		widths: list[int] = [len(c.title) for c in columns]
		for cells in body + ([totals] if totals else []):
			for i, text in enumerate(cells):
				widths[i] = max(widths[i], shown(text))

		def pad(text: str, i: int) -> str:
			gap: str = " " * (widths[i] - shown(text))
			return gap + text if columns[i].numeric else text + gap

		rule: str = "|" + "+".join("-" * (w + 2) for w in widths) + "|"
		lines.append("| " + " | ".join(pad(c.title, i) for i, c in enumerate(columns)) + " |")
		lines.append(rule)
		for cells in body:
			lines.append("| " + " | ".join(pad(text, i) for i, text in enumerate(cells)) + " |")
		if totals:
			lines.append(rule)
			lines.append("| " + " | ".join(pad(text, i) for i, text in enumerate(totals)) + " |")
		if table.truncated_from:
			lines.append(f"/{table.truncated_from - len(table.rows)} more row(s) not shown/")
		return lines

	# ------------------------------------------------------------ delimited

	def _flat_columns(self, table: Table) -> list[tuple[str, Column]]:
		"""Columns for machine output; item columns gain a <key>_name column."""
		flat: list[tuple[str, Column]] = []
		for column in table.columns:
			suffix: str = "_copper" if column.kind == "money" else ""
			flat.append((column.key + suffix, column))
			if column.kind == "item":
				flat.append((column.key + "_name", Column(column.key, column.title, "item_name")))
		return flat

	def _flat_value(self, row: dict[str, Any], column: Column) -> Any:
		if column.kind == "item_name":
			value: Any = row.get(column.key)
			return self.data.item_name(value) if (self.data and value) else ""
		return self.raw(row.get(column.key), column.kind)

	def render_delimited(self, doc: Doc, delimiter: str) -> str:
		buffer: io.StringIO = io.StringIO()
		writer: Any = csv.writer(buffer, delimiter=delimiter, lineterminator="\n")
		tables: list[Table] = [p for s in doc.sections for k, p in s.blocks if k == "table"]
		if doc.main is not None:
			tables = [doc.main]
		elif not tables:
			# A pure key/value document becomes a two-column table.
			pairs: list[tuple[str, Any, str]] = [p for s in doc.sections for k, kv in s.blocks if k == "kv" for p in kv]
			writer.writerow(["key", "value"])
			for label, value, kind in pairs:
				writer.writerow([label, self.raw(value, kind)])
			return buffer.getvalue()
		for index, table in enumerate(tables):
			if len(tables) > 1:
				if index:
					buffer.write("\n")
				buffer.write(f"# {table.title or 'table'}\n")
			flat: list[tuple[str, Column]] = self._flat_columns(table)
			writer.writerow([name for name, _ in flat])
			for row in table.rows:
				writer.writerow(["" if (v := self._flat_value(row, c)) is None else v for _, c in flat])
		return buffer.getvalue()

	# ----------------------------------------------------------------- json

	def render_json(self, doc: Doc) -> str:
		def table_json(table: Table) -> dict[str, Any]:
			flat: list[tuple[str, Column]] = self._flat_columns(table)
			return {
				"title": table.title,
				"columns": [name for name, _ in flat],
				"rows": [{name: self._flat_value(row, c) for name, c in flat} for row in table.rows],
				"totals": {name: self._flat_value(table.totals, c) for name, c in flat if c.key in table.totals} if table.totals else None,
			}

		sections: list[dict[str, Any]] = []
		for section in doc.sections:
			entry: dict[str, Any] = {"title": section.title, "values": {}, "tables": [], "notes": []}
			for kind, payload in section.blocks:
				if kind == "kv":
					for label, value, vkind in payload:
						entry["values"][label.strip()] = self.raw(value, vkind)
				elif kind == "table":
					entry["tables"].append(table_json(payload))
				else:
					entry["notes"].append(payload)
			sections.append(entry)
		return json.dumps({"title": doc.title, "generated": iso_now(), "generator": f"{PROG} {VERSION}", "sections": sections}, indent=2, ensure_ascii=False) + "\n"


# ============================================================================
# Filters
# ============================================================================

@dataclass
class Filters(object):
	"""Row filters shared by every command."""

	accounts: Optional[set[str]] = None
	realms: Optional[set[str]] = None
	chars: Optional[set[str]] = None
	items: Optional[set[str]] = None
	sources: Optional[set[str]] = None
	since: Optional[int] = None
	until: Optional[int] = None
	include_internal: bool = False
	variants: bool = False

	def key(self, item: str) -> str:
		"""Grouping key for an item: base item unless --variants."""
		return item if self.variants else item_base(item)

	def time_ok(self, epoch: int) -> bool:
		if self.since is not None and epoch < self.since:
			return False
		if self.until is not None and epoch >= self.until:
			return False
		return True

	def txn_ok(self, txn: Txn, use_time: bool = True) -> bool:
		if self.accounts is not None and txn.account not in self.accounts:
			return False
		if self.realms is not None and txn.realm not in self.realms:
			return False
		if self.chars is not None and txn.player.lower() not in self.chars:
			return False
		if self.items is not None and (not txn.item or item_base(txn.item) not in self.items):
			return False
		if self.sources is not None and txn.source.lower() not in self.sources:
			return False
		if txn.internal and not self.include_internal:
			return False
		if use_time and not self.time_ok(txn.time):
			return False
		return True

	def holding_ok(self, holding: Holding) -> bool:
		if self.accounts is not None and holding.account not in self.accounts:
			return False
		if self.realms is not None and holding.realm and holding.realm not in self.realms:
			return False
		if self.chars is not None and holding.owner.lower() not in self.chars:
			return False
		if self.items is not None and item_base(holding.item) not in self.items:
			return False
		return True

	def char_ok(self, char: Character) -> bool:
		if self.accounts is not None and char.account not in self.accounts:
			return False
		if self.realms is not None and char.realm not in self.realms:
			return False
		if self.chars is not None and char.name.lower() not in self.chars:
			return False
		return True

	def describe(self) -> list[tuple[str, Any, str]]:
		"""Human summary of active filters, for report headers."""
		parts: list[tuple[str, Any, str]] = []
		if self.since is not None or self.until is not None:
			parts.append(("Period", f"{fmt_time(self.since) if self.since else 'beginning'} → {fmt_time(self.until) if self.until else 'now'}", "str"))
		if self.realms:
			parts.append(("Realms", ", ".join(sorted(self.realms)), "str"))
		if self.chars:
			parts.append(("Characters", ", ".join(sorted(self.chars)), "str"))
		if self.accounts:
			parts.append(("Accounts", ", ".join(sorted(self.accounts)), "str"))
		if self.items is not None:
			parts.append(("Items", f"{len(self.items)} selected", "str"))
		if self.sources:
			parts.append(("Sources", ", ".join(sorted(self.sources)), "str"))
		return parts


# ============================================================================
# Analysis
# ============================================================================

@dataclass(slots=True)
class ItemStats(object):
	"""Per-item aggregate of the ledger over a window."""

	key: str
	sold: int = 0
	ah_sold: int = 0
	revenue: int = 0
	vendor_sold: int = 0
	vendor_revenue: int = 0
	sales: int = 0
	bought: int = 0
	spent: int = 0
	buys: int = 0
	expired: int = 0
	cancelled: int = 0
	expires: int = 0
	min_sale: Optional[int] = None
	max_sale: Optional[int] = None
	first_time: Optional[int] = None
	last_sale: Optional[int] = None
	last_buy: Optional[int] = None

	@property
	def avg_sale(self) -> Optional[int]:
		return self.revenue // self.sold if self.sold else None

	@property
	def avg_buy(self) -> Optional[int]:
		return self.spent // self.bought if self.bought else None

	@property
	def cogs(self) -> int:
		"""Cost of the units sold, at average purchase cost (0 if never bought)."""
		if not self.bought:
			return 0
		return min(self.sold, self.bought) * self.spent // self.bought

	@property
	def profit(self) -> int:
		return self.revenue - self.cogs

	@property
	def margin(self) -> Optional[float]:
		return self.profit / self.revenue if self.revenue else None

	@property
	def roi(self) -> Optional[float]:
		return self.profit / self.cogs if self.cogs else None

	@property
	def sell_through(self) -> Optional[float]:
		"""AH units sold / AH units that left the AH (sold + expired + cancelled)."""
		listed: int = self.ah_sold + self.expired + self.cancelled
		return self.ah_sold / listed if listed else None

	@property
	def basis(self) -> str:
		if not self.bought:
			return "no cost"
		if self.bought >= self.sold:
			return "flip"
		return "partial"


def item_stats(data: TsmData, filters: Filters) -> dict[str, ItemStats]:
	"""Aggregate filtered ledger rows by item key."""
	stats: dict[str, ItemStats] = {}
	for txn in data.txns:
		if not txn.item or not filters.txn_ok(txn):
			continue
		key: str = filters.key(txn.item)
		entry: Optional[ItemStats] = stats.get(key)
		if entry is None:
			entry = stats[key] = ItemStats(key=key)
		if entry.first_time is None:
			entry.first_time = txn.time
		if txn.kind == "sale":
			entry.sold += txn.qty
			entry.revenue += txn.total
			entry.sales += 1
			if txn.source == "Vendor":
				entry.vendor_sold += txn.qty
				entry.vendor_revenue += txn.total
			elif txn.source == "Auction":
				entry.ah_sold += txn.qty
			entry.min_sale = txn.price if entry.min_sale is None else min(entry.min_sale, txn.price)
			entry.max_sale = txn.price if entry.max_sale is None else max(entry.max_sale, txn.price)
			entry.last_sale = txn.time
		elif txn.kind == "buy":
			entry.bought += txn.qty
			entry.spent += txn.total
			entry.buys += 1
			entry.last_buy = txn.time
		elif txn.kind == "expire":
			entry.expired += txn.qty
			entry.expires += 1
		elif txn.kind == "cancel":
			entry.cancelled += txn.qty
	return stats


def holdings_by_item(data: TsmData, filters: Filters) -> dict[str, int]:
	totals: dict[str, int] = {}
	for holding in data.holdings:
		if filters.holding_ok(holding):
			key: str = filters.key(holding.item)
			totals[key] = totals.get(key, 0) + holding.qty
	return totals


@dataclass
class Pnl(object):
	"""Cash-basis profit & loss totals for one bucket."""

	ah_sales: int = 0
	vendor_sales: int = 0
	other_sales: int = 0
	income: int = 0
	purchases: int = 0
	expenses: int = 0
	sales_count: int = 0
	units_sold: int = 0

	@property
	def revenue(self) -> int:
		return self.ah_sales + self.vendor_sales + self.other_sales + self.income

	@property
	def net(self) -> int:
		return self.revenue - self.purchases - self.expenses

	def add(self, txn: Txn) -> None:
		if txn.kind == "sale":
			if txn.source == "Auction":
				self.ah_sales += txn.total
			elif txn.source == "Vendor":
				self.vendor_sales += txn.total
			else:
				self.other_sales += txn.total
			self.sales_count += 1
			self.units_sold += txn.qty
		elif txn.kind == "buy":
			self.purchases += txn.total
		elif txn.kind == "income":
			self.income += txn.total
		elif txn.kind == "expense":
			self.expenses += txn.total


def pnl_total(data: TsmData, filters: Filters) -> Pnl:
	total: Pnl = Pnl()
	for txn in data.txns:
		if filters.txn_ok(txn):
			total.add(txn)
	return total


def gold_series(data: TsmData, filters: Filters, edges: list[int]) -> list[Optional[int]]:
	"""
	Total gold at each edge, replaying every character/warbank/guild gold
	log (TSM rounds retail gold logs to 1000g). None until any log starts.
	"""
	streams: list[list[tuple[int, int]]] = []
	for char in data.characters.values():
		if filters.char_ok(char) and char.gold_log:
			streams.append(char.gold_log)
	if filters.chars is None:
		for account, log in data.warbank_log.items():
			if (filters.accounts is None or account in filters.accounts) and log:
				streams.append(log)
		for name, log in data.guild_logs.items():
			realm: str = name.rsplit(" (", 1)[-1].rstrip(")")
			if (filters.realms is None or realm in filters.realms) and log:
				streams.append(log)
	events: list[tuple[int, int, int]] = sorted((t, index, copper) for index, log in enumerate(streams) for t, copper in log)
	current: dict[int, int] = {}
	result: list[Optional[int]] = []
	cursor: int = 0
	for edge in edges:
		while cursor < len(events) and events[cursor][0] < edge:
			current[events[cursor][1]] = events[cursor][2]
			cursor += 1
		result.append(sum(current.values()) if current else None)
	return result


def gold_change_between(data: TsmData, filters: Filters, start: int, end: int) -> Optional[int]:
	"""
	Gold-log change over a window. If the logs begin inside the window, the
	first logged moment is the baseline (so a fresh TSM install still works).
	"""
	first_logged: Optional[int] = min((t for c in data.characters.values() if filters.char_ok(c) for t, _ in c.gold_log), default=None)
	if first_logged is None:
		return None
	baseline_at: int = max(start, first_logged + 1)
	if baseline_at >= end:
		return None
	before, after = gold_series(data, filters, [baseline_at, end + 1])
	if before is None or after is None:
		return None
	return after - before


def liquid_gold(data: TsmData, filters: Filters) -> tuple[int, int, int]:
	"""(character gold, warbank gold, guild bank gold from the last guild log entry)."""
	chars: int = sum(c.money for c in data.characters.values() if filters.char_ok(c))
	if filters.chars is not None:
		return chars, 0, 0
	warbank: int = sum(v for a, v in data.warbank_money.items() if filters.accounts is None or a in filters.accounts)
	guild: int = 0
	for name, log in data.guild_logs.items():
		realm: str = name.rsplit(" (", 1)[-1].rstrip(")")
		if log and (filters.realms is None or realm in filters.realms):
			guild += log[-1][1]
	return chars, warbank, guild


# ============================================================================
# Command context
# ============================================================================

class Context(object):
	"""Everything a command needs: settings, data, pricer, filters, args."""

	def __init__(self, args: argparse.Namespace, settings: Settings):
		self.args: argparse.Namespace = args
		self.settings: Settings = settings
		self.source: DataSource = DataSource(settings)
		self._data: Optional[TsmData] = None
		self._pricer: Optional[Pricer] = None
		self._filters: Optional[Filters] = None
		self.now: int = int(time.time())

	@property
	def data(self) -> TsmData:
		if self._data is None:
			self._data = self._load()
		return self._data

	def _load(self) -> TsmData:
		self.source.prepare()
		data: TsmData = TsmData()
		files: list[tuple[str, Path]] = self.source.sv_files()
		if not files:
			raise TsmctlError(f"no TradeSkillMaster.lua SavedVariables under {self.source.root / 'WTF' / 'Account'}")
		wanted: Optional[set[str]] = {a.lower() for a in self.settings.accounts} if self.settings.accounts else None
		for account, path in files:
			if wanted is not None and account.lower() not in wanted:
				continue
			data.load_account(account, path)
		if wanted is not None and not data.accounts:
			raise TsmctlError(f"no data for account(s) {', '.join(self.settings.accounts)}; found {', '.join(a for a, _ in files)}")
		data.finish()
		data.appdata_path = self.source.appdata_file()
		return data

	def market(self, required: bool = True) -> Optional[Market]:
		"""Load AppData.lua on first use."""
		data: TsmData = self.data
		if data.market is None and data.appdata_path is not None:
			data.market = Market(data.appdata_path)
		if data.market is None and required:
			raise TsmctlError("no AppData.lua found (run the TSM desktop app so it downloads market data)")
		return data.market

	@property
	def pricer(self) -> Pricer:
		if self._pricer is None:
			self.market(required=False)
			self._pricer = Pricer(self.data, self.settings)
		return self._pricer

	def filters(self, default_since: Optional[str] = None) -> Filters:
		"""Build Filters from the common options (default period per command)."""
		if self._filters is not None:
			return self._filters
		args: argparse.Namespace = self.args
		data: TsmData = self.data
		filters: Filters = Filters()
		filters.include_internal = bool(getattr(args, "include_internal", False))
		filters.variants = bool(getattr(args, "variants", False))
		if self.settings.accounts:
			filters.accounts = {a for a in data.accounts if a.lower() in {x.lower() for x in self.settings.accounts}}
		realms: list[str] = _split_multi(getattr(args, "realm", None) or [])
		if realms:
			market: Optional[Market] = self.market(required=False)
			filters.realms = {resolve_realm(r, data, market) for r in realms}
		chars: list[str] = _split_multi(getattr(args, "char", None) or [])
		if chars:
			known: set[str] = {c.name.lower() for c in data.characters.values()}
			unknown: list[str] = [c for c in chars if c.lower() not in known]
			if unknown:
				Log.warn(f"unknown character(s): {', '.join(unknown)}")
			filters.chars = {c.lower() for c in chars}
		items: set[str] = set()
		item_queries: list[str] = list(getattr(args, "item", None) or [])
		for query in item_queries:
			found: list[str] = data.search_items(query)
			if not found:
				raise TsmctlError(f"no item matches {query!r}")
			items.update(found)
		groups: list[str] = list(getattr(args, "group", None) or [])
		for group in groups:
			found_group: set[str] = self.group_items(group)
			if not found_group:
				raise TsmctlError(f"no TSM group matches {group!r}; see `tsmctl get groups`")
			items.update(found_group)
		if item_queries or groups:
			filters.items = items
		sources: list[str] = _split_multi(getattr(args, "source", None) or [])
		if sources:
			filters.sources = {s.lower() for s in sources}
		since: Optional[str] = getattr(args, "since", None)
		until: Optional[str] = getattr(args, "until", None)
		period: Optional[str] = getattr(args, "period", None)
		if period:
			filters.since, filters.until = parse_period(period)
		elif since is None and default_since:
			filters.since = parse_when(default_since)
		if since is not None:
			filters.since = parse_when(since)
		if until is not None:
			filters.until = parse_when(until)
		if filters.since is not None and filters.until is not None and filters.since >= filters.until:
			raise TsmctlError("--since must be before --until")
		self._filters = filters
		return filters

	def group_items(self, query: str) -> set[str]:
		"""Base items in TSM groups whose path matches (prefix, case-insensitive)."""
		wanted: str = normalize_group(query)
		result: set[str] = set()
		for item, path in self.data.groups.items():
			display: str = group_display(path).lower()
			if display == wanted or display.startswith(wanted + " > ") or (wanted and wanted in display.split(" > ")[-1]):
				result.add(item_base(item))
		return result

	def unit_value(self, item: str, realm: str, source: Optional[str] = None) -> Optional[int]:
		"""Unit value at `source` (default: the minimum price source)."""
		return self.pricer.price(source or self.settings.price_source, item, realm or self.pricer.default_realm())


def group_display(path: str) -> str:
	return " > ".join(part for part in path.split("`"))


def normalize_group(text: str) -> str:
	return " > ".join(p.strip() for p in re.split(r"`|>|/(?=[^ ])", text.lower()) if p.strip())


# ============================================================================
# Commands: helpers
# ============================================================================

def money_col(key: str, title: str, signed: bool = False, wide: bool = False) -> Column:
	return Column(key, title, "money", signed=signed, wide=wide)


def apply_main(ctx: Context, doc: Doc, table: Table, default_sort: Optional[str] = None, default_limit: int = 0) -> None:
	"""Apply --sort/--reverse/--limit to the main table of a document."""
	args: argparse.Namespace = ctx.args
	sort_key: Optional[str] = getattr(args, "sort", None) or default_sort
	if sort_key:
		table.sort(sort_key, bool(getattr(args, "reverse", False)))
	elif getattr(args, "reverse", False):
		table.rows.reverse()
	limit: Optional[int] = getattr(args, "limit", None)
	table.limit(default_limit if limit is None else limit)
	doc.main = table


def ledger_columns(kind: str) -> list[Column]:
	if kind in ("sale", "buy"):
		return [
			Column("time", "Time", "time"), Column("item", "Item", "item", max_width=40),
			Column("qty", "Qty", "int"), money_col("price", "Each"), money_col("total", "Total"),
			Column("other", "Buyer" if kind == "sale" else "Seller", max_width=24),
			Column("player", "Character"), Column("realm", "Realm", wide=True), Column("source", "Source"),
			Column("stack", "Stack", "int", wide=True), Column("account", "Account", wide=True),
		]
	if kind in ("income", "expense"):
		return [
			Column("time", "Time", "time"), Column("source", "Type"), money_col("total", "Amount"),
			Column("other", "Other"), Column("player", "Character"), Column("realm", "Realm"),
			Column("account", "Account", wide=True),
		]
	if kind in ("expire", "cancel"):
		return [
			Column("time", "Time", "time"), Column("item", "Item", "item", max_width=40), Column("qty", "Qty", "int"),
			Column("stack", "Stack", "int"), Column("player", "Character"), Column("realm", "Realm"),
			Column("account", "Account", wide=True),
		]
	return [
		Column("time", "Time", "time"), Column("kind", "Kind"), Column("item", "Item", "item", max_width=36),
		Column("qty", "Qty", "int"), money_col("price", "Each"), money_col("signed", "Amount", signed=True),
		Column("other", "Other", max_width=20), Column("player", "Character"), Column("realm", "Realm", wide=True),
		Column("source", "Source"), Column("account", "Account", wide=True),
	]


def txn_row(txn: Txn) -> dict[str, Any]:
	signed: Optional[int] = None
	if txn.kind in ("sale", "income"):
		signed = txn.total
	elif txn.kind in ("buy", "expense"):
		signed = -txn.total
	return {
		"time": txn.time, "kind": txn.kind, "item": txn.item or None, "qty": txn.qty,
		"price": txn.price if txn.kind in ("sale", "buy") else None,
		"total": txn.total if txn.kind in ("sale", "buy", "income", "expense") else None,
		"signed": signed, "other": txn.other, "player": txn.player, "realm": txn.realm,
		"source": txn.source, "stack": txn.stack, "account": txn.account,
	}


# ============================================================================
# Commands: get
# ============================================================================

GET_RESOURCES: dict[str, tuple[str, ...]] = {
	"accounts": ("account", "accounts", "acct"),
	"realms": ("realm", "realms"),
	"characters": ("char", "chars", "character", "characters", "toons"),
	"gold": ("gold", "money"),
	"gold-history": ("gold-history", "goldlog", "gold-log", "goldhistory"),
	"sales": ("sale", "sales", "sold"),
	"buys": ("buy", "buys", "purchases", "bought"),
	"income": ("income",),
	"expenses": ("expense", "expenses"),
	"expired": ("expired", "expires", "expire"),
	"cancelled": ("cancelled", "canceled", "cancels", "cancel"),
	"ledger": ("ledger", "transactions", "txns", "all"),
	"inventory": ("inventory", "inv", "items-held", "stock"),
	"auctions": ("auctions", "auction", "ah", "posted"),
	"groups": ("group", "groups"),
	"prices": ("price", "prices"),
	"sources": ("sources", "price-sources"),
	"professions": ("professions", "profs", "prof"),
	"items": ("items", "item"),
}

LEDGER_RESOURCE_KIND: dict[str, str] = {
	"sales": "sale", "buys": "buy", "income": "income", "expenses": "expense",
	"expired": "expire", "cancelled": "cancel",
}


def resolve_resource(name: str) -> str:
	lowered: str = name.lower()
	for canonical, aliases in GET_RESOURCES.items():
		if lowered == canonical or lowered in aliases:
			return canonical
	raise TsmctlError(f"unknown resource {name!r}; one of: {', '.join(GET_RESOURCES)}")


def cmd_get(ctx: Context) -> Doc:
	resource: str = resolve_resource(ctx.args.resource)
	query: Optional[str] = ctx.args.query
	if resource == "sources":
		return get_sources()
	if resource == "accounts":
		return get_accounts(ctx)
	if resource == "realms":
		return get_realms(ctx)
	if resource == "characters":
		return get_characters(ctx)
	if resource == "gold":
		return get_gold(ctx)
	if resource == "gold-history":
		return get_gold_history(ctx)
	if resource in LEDGER_RESOURCE_KIND or resource == "ledger":
		return get_ledger(ctx, resource, query)
	if resource in ("inventory", "auctions"):
		return get_inventory(ctx, query, auctions_only=resource == "auctions")
	if resource == "groups":
		return get_groups(ctx)
	if resource == "prices":
		return get_prices(ctx, query)
	if resource == "professions":
		return get_professions(ctx)
	if resource == "items":
		return cmd_search(ctx, query)
	raise TsmctlError(f"unhandled resource {resource}")


def get_sources() -> Doc:
	doc: Doc = Doc("Price sources", "get_sources")
	rows: list[dict[str, Any]] = [{"name": n, "scope": s["scope"], "desc": s["desc"]} for n, s in PRICE_SOURCES.items()]
	table: Table = Table([Column("name", "Source"), Column("scope", "Scope"), Column("desc", "Description")], rows)
	section: Section = doc.section("Price sources")
	section.table(table)
	section.text("Combine with min(), max(), avg(), first(), check(cond, then, else), + - * /, N% and money literals, e.g. \"first(dbmarket, 80% dbregionmarketavg)\".")
	doc.main = table
	return doc


def get_accounts(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	rows: list[dict[str, Any]] = []
	for info in data.files:
		chars: list[Character] = [c for c in data.characters.values() if c.account == info.account]
		txns: int = sum(1 for t in data.txns if t.account == info.account)
		rows.append({
			"account": info.account, "chars": len(chars), "gold": sum(c.money for c in chars) + data.warbank_money.get(info.account, 0),
			"txns": txns, "saved": info.mtime, "size": info.size,
		})
	doc: Doc = Doc("Accounts", "get_accounts")
	table: Table = Table([
		Column("account", "Account"), Column("chars", "Chars", "int"), money_col("gold", "Gold (incl. warbank)"),
		Column("txns", "Ledger rows", "int"), Column("saved", "SV saved", "time"), Column("size", "Bytes", "int", wide=True),
	], rows)
	doc.section("Accounts").table(table)
	apply_main(ctx, doc, table)
	return doc


def get_realms(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	market: Optional[Market] = ctx.market(required=False)
	filters: Filters = ctx.filters()
	rows: list[dict[str, Any]] = []
	for realm in sorted(set(data.realms()) | set(market.realm_names() if market else [])):
		if filters.realms is not None and realm not in filters.realms:
			continue
		chars: list[Character] = [c for c in data.characters.values() if c.realm == realm and filters.char_ok(c)]
		sales: list[Txn] = [t for t in data.txns if t.realm == realm and t.kind == "sale" and filters.txn_ok(t, use_time=False)]
		rows.append({
			"realm": realm, "chars": len(chars), "gold": sum(c.money for c in chars),
			"sales": len(sales), "revenue": sum(t.total for t in sales),
			"market": fmt_time(market.realm_download_time(realm)) if market and market.has_realm(realm) else "no realm data",
		})
	doc: Doc = Doc("Realms", "get_realms")
	table: Table = Table([
		Column("realm", "Realm"), Column("chars", "Chars", "int"), money_col("gold", "Gold"),
		Column("sales", "Sales (all time)", "int"), money_col("revenue", "Revenue (all time)"), Column("market", "Market data"),
	], rows)
	doc.section("Realms").table(table)
	apply_main(ctx, doc, table, default_sort="gold")
	return doc


def get_characters(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	filters: Filters = ctx.filters()
	values: dict[tuple[str, str], int] = {}
	for holding in data.holdings:
		if holding.owner.startswith(("Guild:", "Warbank")) or not filters.holding_ok(holding):
			continue
		value: Optional[int] = ctx.unit_value(holding.item, holding.realm)
		if value:
			values[(holding.owner, holding.realm)] = values.get((holding.owner, holding.realm), 0) + value * holding.qty
	rows: list[dict[str, Any]] = []
	for char in data.characters.values():
		if not filters.char_ok(char):
			continue
		profs: list[str] = [f"{n} {lua_dict(p).get('level', '?')}" for n, p in sorted(char.professions.items()) if isinstance(p, dict) and not p.get("isSecondary")]
		rows.append({
			"name": char.name, "realm": char.realm, "faction": char.faction, "class": class_name(char.class_key),
			"gold": char.money, "inventory": values.get((char.name, char.realm)), "professions": ", ".join(profs),
			"guild": char.guild, "account": char.account,
		})
	doc: Doc = Doc("Characters", "get_characters")
	table: Table = Table([
		Column("name", "Character"), Column("realm", "Realm"), Column("class", "Class"), money_col("gold", "Gold"),
		money_col("inventory", "Inventory value"), Column("professions", "Professions", max_width=34),
		Column("guild", "Guild", wide=True), Column("faction", "Faction", wide=True), Column("account", "Account", wide=True),
	], rows, totals={"name": "TOTAL", "gold": sum(r["gold"] for r in rows), "inventory": sum(r["inventory"] or 0 for r in rows)})
	doc.section("Characters").table(table)
	apply_main(ctx, doc, table, default_sort="gold")
	return doc


def get_professions(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	filters: Filters = ctx.filters()
	rows: list[dict[str, Any]] = []
	for char in data.characters.values():
		if not filters.char_ok(char):
			continue
		for name, prof in char.professions.items():
			info: dict[Any, Any] = lua_dict(prof)
			rows.append({
				"char": char.name, "realm": char.realm, "profession": name, "level": info.get("level"),
				"max": info.get("maxLevel"), "secondary": "yes" if info.get("isSecondary") else "",
			})
	doc: Doc = Doc("Professions", "get_professions")
	table: Table = Table([
		Column("char", "Character"), Column("realm", "Realm"), Column("profession", "Profession"),
		Column("level", "Skill", "int"), Column("max", "Max", "int"), Column("secondary", "Secondary"),
	], rows)
	doc.section("Professions").table(table)
	apply_main(ctx, doc, table, default_sort="char", default_limit=0)
	return doc


def get_gold(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	filters: Filters = ctx.filters()
	rows: list[dict[str, Any]] = []
	for char in data.characters.values():
		if filters.char_ok(char):
			rows.append({"owner": char.name, "realm": char.realm, "kind": "character", "class": class_name(char.class_key), "gold": char.money, "account": char.account})
	if filters.chars is None:
		for account, money in data.warbank_money.items():
			if filters.accounts is None or account in filters.accounts:
				rows.append({"owner": "Warbank", "realm": "", "kind": "warbank", "class": "", "gold": money, "account": account})
		for name, log in data.guild_logs.items():
			realm: str = name.rsplit(" (", 1)[-1].rstrip(")")
			if log and (filters.realms is None or realm in filters.realms):
				rows.append({"owner": name.rsplit(" (", 1)[0], "realm": realm, "kind": "guild (log)", "class": "", "gold": log[-1][1], "account": ""})
	total: int = sum(r["gold"] for r in rows)
	for row in rows:
		row["share"] = row["gold"] / total if total else None
	doc: Doc = Doc("Gold", "get_gold")
	table: Table = Table([
		Column("owner", "Owner"), Column("realm", "Realm"), Column("kind", "Kind"), Column("class", "Class", wide=True),
		money_col("gold", "Gold"), Column("share", "Share", "pct"), Column("account", "Account", wide=True),
	], rows, totals={"owner": "TOTAL", "gold": total})
	doc.section("Gold on hand").table(table)
	apply_main(ctx, doc, table, default_sort="gold")
	return doc


def get_gold_history(ctx: Context) -> Doc:
	filters: Filters = ctx.filters(default_since="30d")
	by: str = getattr(ctx.args, "by", None) or "day"
	if by not in ("day", "week", "month"):
		raise TsmctlError("gold-history --by must be day, week or month")
	data: TsmData = ctx.data
	start: int = filters.since or min((t for c in data.characters.values() for t, _ in c.gold_log), default=ctx.now)
	end: int = filters.until or ctx.now
	edges: list[int] = bucket_edges(start, end, by)
	edges[-1] = min(edges[-1], end)
	series: list[Optional[int]] = gold_series(data, filters, edges)
	rows: list[dict[str, Any]] = []
	previous: Optional[int] = None
	peak: int = max((v for v in series if v is not None), default=0)
	for edge, value in zip(edges, series):
		if value is None:
			continue
		bar: str = "█" * int(round(24 * value / peak)) if peak > 0 else ""
		rows.append({"date": edge - 1, "gold": value, "change": (value - previous) if previous is not None else None, "bar": bar})
		previous = value
	doc: Doc = Doc("Gold history", "get_gold_history")
	table: Table = Table([Column("date", "As of", "time"), money_col("gold", "Total gold"), money_col("change", "Change", signed=True), Column("bar", "")], rows,
		empty="no gold log entries in range")
	section: Section = doc.section(f"Gold history (per {by})")
	section.table(table)
	section.text("TSM rounds retail gold logs to the nearest 1,000g, so small swings do not show.")
	apply_main(ctx, doc, table)
	return doc


def get_ledger(ctx: Context, resource: str, query: Optional[str]) -> Doc:
	data: TsmData = ctx.data
	if query:
		ctx.args.item = list(getattr(ctx.args, "item", None) or []) + [query]
	filters: Filters = ctx.filters()
	kind: Optional[str] = LEDGER_RESOURCE_KIND.get(resource)
	rows: list[dict[str, Any]] = [txn_row(t) for t in data.txns if (kind is None or t.kind == kind) and filters.txn_ok(t)]
	columns: list[Column] = ledger_columns(kind or "ledger")
	totals: Optional[dict[str, Any]] = None
	if kind in ("sale", "buy", "income", "expense"):
		totals = {"time": f"{len(rows)} rows", "qty": sum(r["qty"] for r in rows), "total": sum(r["total"] or 0 for r in rows)}
	elif kind in ("expire", "cancel"):
		totals = {"time": f"{len(rows)} rows", "qty": sum(r["qty"] for r in rows)}
	else:
		totals = {"time": f"{len(rows)} rows", "signed": sum(r["signed"] or 0 for r in rows)}
	rows.reverse()
	title: str = {"sale": "Sales", "buy": "Purchases", "income": "Income", "expense": "Expenses", "expire": "Expired auctions", "cancel": "Cancelled auctions"}.get(kind or "", "Ledger")
	doc: Doc = Doc(title, f"get_{resource}")
	section: Section = doc.section(title)
	filter_desc: list[tuple[str, Any, str]] = filters.describe()
	if filter_desc:
		section.kv(filter_desc)
	table: Table = Table(columns, rows, totals=totals)
	section.table(table)
	apply_main(ctx, doc, table, default_limit=50)
	return doc


def get_inventory(ctx: Context, query: Optional[str], auctions_only: bool) -> Doc:
	data: TsmData = ctx.data
	if query:
		ctx.args.item = list(getattr(ctx.args, "item", None) or []) + [query]
	filters: Filters = ctx.filters()
	locations: Optional[set[str]] = {l.lower() for l in _split_multi(getattr(ctx.args, "location", None) or [])} or None
	if auctions_only:
		locations = {"auction"}
	by: str = getattr(ctx.args, "by", None) or "item"
	if by not in ("item", "char", "location", "realm", "group"):
		raise TsmctlError("inventory --by must be item, char, location, realm or group")
	min_value: Optional[int] = parse_money(ctx.args.min_value) if getattr(ctx.args, "min_value", None) else None
	pricer: Pricer = ctx.pricer
	market: Optional[Market] = data.market
	agg: dict[str, dict[str, Any]] = {}
	unpriced: set[str] = set()
	for holding in data.holdings:
		if not filters.holding_ok(holding):
			continue
		if locations is not None and holding.location.lower() not in locations:
			continue
		realm: str = holding.realm or pricer.default_realm()
		unit: Optional[int] = ctx.unit_value(holding.item, realm)
		if unit is None:
			unpriced.add(holding.item)
		item_key: str = filters.key(holding.item)
		key: str = {
			"item": item_key, "char": f"{holding.owner} ({holding.realm or 'account'})",
			"location": holding.location, "realm": holding.realm or "(account-wide)",
			"group": group_display(data.group_of(holding.item)) or "(ungrouped)",
		}[by]
		entry: dict[str, Any] = agg.setdefault(key, {"key": key, "item": item_key if by == "item" else None, "qty": 0, "value": 0, "where": set(), "realm": realm, "items": set()})
		entry["qty"] += holding.qty
		entry["value"] += (unit or 0) * holding.qty
		entry["where"].add(f"{holding.owner}:{holding.location}")
		entry["items"].add(item_key)
	rows: list[dict[str, Any]] = []
	for entry in agg.values():
		if min_value is not None and entry["value"] < min_value:
			continue
		row: dict[str, Any] = {"qty": entry["qty"], "value": entry["value"], "items": len(entry["items"])}
		if by == "item":
			item: str = entry["item"]
			row.update({
				"item": item, "unit": entry["value"] // entry["qty"] if entry["qty"] and entry["value"] else None,
				"where": ", ".join(sorted(entry["where"])), "group": group_display(data.group_of(item)),
				"rate": pricer.source("dbregionsalerate", item, entry["realm"]) if market else None,
				"spd": pricer.source("dbregionsoldperday", item, entry["realm"]) if market else None,
			})
		else:
			row["key"] = entry["key"]
		rows.append(row)
	total_value: int = sum(r["value"] for r in rows)
	doc: Doc = Doc("Auctions" if auctions_only else "Inventory", "get_auctions" if auctions_only else "get_inventory")
	columns: list[Column]
	if by == "item":
		columns = [
			Column("item", "Item", "item", max_width=40), Column("qty", "Qty", "int"), money_col("unit", "Unit value"),
			money_col("value", "Value"), Column("rate", "Sale rate", "rate"), Column("spd", "Sold/day", "num"),
			Column("group", "TSM group", wide=True), Column("where", "Where", max_width=40, wide=True),
		]
		totals: dict[str, Any] = {"item": f"{len(rows)} items", "qty": sum(r["qty"] for r in rows), "value": total_value}
	else:
		columns = [Column("key", by.title()), Column("items", "Items", "int"), Column("qty", "Qty", "int"), money_col("value", "Value")]
		totals = {"key": "TOTAL", "qty": sum(r["qty"] for r in rows), "value": total_value}
	section: Section = doc.section(("Posted auctions (as of last logout)" if auctions_only else "Inventory") + f" valued at {ctx.settings.price_source}")
	table: Table = Table(columns, rows, totals=totals, empty="nothing held matches")
	section.table(table)
	if unpriced:
		section.text(f"{len(unpriced)} item(s) had no price from {ctx.settings.price_source} and count as 0.")
	apply_main(ctx, doc, table, default_sort="value", default_limit=50)
	return doc


def get_groups(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	filters: Filters = ctx.filters(default_since="30d")
	stats: dict[str, ItemStats] = item_stats(data, Filters(**{**filters.__dict__, "variants": False}))
	held: dict[str, int] = {}
	held_value: dict[str, int] = {}
	for holding in data.holdings:
		if filters.holding_ok(holding):
			base: str = item_base(holding.item)
			held[base] = held.get(base, 0) + holding.qty
			held_value[base] = held_value.get(base, 0) + (ctx.unit_value(holding.item, holding.realm) or 0) * holding.qty
	members: dict[str, set[str]] = {}
	for item, path in data.groups.items():
		members.setdefault(path, set()).add(item_base(item))
	for path in data.group_paths:
		members.setdefault(path, set())
	rows: list[dict[str, Any]] = []
	for path, items in members.items():
		group_stats: list[ItemStats] = [stats[i] for i in items if i in stats]
		rows.append({
			"group": group_display(path), "items": len(items), "held": sum(held.get(i, 0) for i in items),
			"value": sum(held_value.get(i, 0) for i in items), "revenue": sum(s.revenue for s in group_stats),
			"profit": sum(s.profit for s in group_stats), "sold": sum(s.sold for s in group_stats),
		})
	doc: Doc = Doc("TSM groups", "get_groups")
	section: Section = doc.section("TSM groups")
	section.kv(filters.describe())
	table: Table = Table([
		Column("group", "Group", max_width=40), Column("items", "Items", "int"), Column("held", "Held", "int"),
		money_col("value", "Held value"), Column("sold", "Sold", "int"), money_col("revenue", "Revenue"), money_col("profit", "Profit", signed=True),
	], rows, empty="no TSM groups defined")
	section.table(table)
	apply_main(ctx, doc, table, default_sort="group")
	return doc


def get_prices(ctx: Context, query: Optional[str]) -> Doc:
	data: TsmData = ctx.data
	market: Optional[Market] = ctx.market()
	assert market is not None
	if query:
		ctx.args.item = list(getattr(ctx.args, "item", None) or []) + [query]
	filters: Filters = ctx.filters()
	if filters.items is None:
		raise TsmctlError("get prices needs an item: tsmctl get prices <item> (or --item/--group)")
	realms: list[str] = sorted(filters.realms) if filters.realms else [r for r in market.realm_names()]
	pricer: Pricer = ctx.pricer
	rows: list[dict[str, Any]] = []
	for item in sorted(filters.items, key=data.item_name):
		for realm in realms:
			rows.append({
				"item": item, "realm": realm,
				"minbuyout": pricer.source("dbminbuyout", item, realm), "auctions": pricer.source("dbnumauctions", item, realm),
				"market": pricer.source("dbmarket", item, realm), "recent": pricer.source("dbrecent", item, realm),
				"historical": pricer.source("dbhistorical", item, realm),
				"regionmarket": pricer.source("dbregionmarketavg", item, realm), "regionsale": pricer.source("dbregionsaleavg", item, realm),
				"rate": pricer.source("dbregionsalerate", item, realm), "spd": pricer.source("dbregionsoldperday", item, realm),
				"value": ctx.unit_value(item, realm),
			})
	doc: Doc = Doc("Prices", "get_prices")
	table: Table = Table([
		Column("item", "Item", "item", max_width=32), Column("realm", "Realm"), money_col("minbuyout", "Min buyout"),
		Column("auctions", "Auctions", "int"), money_col("market", "Market"), money_col("recent", "Recent", wide=True),
		money_col("historical", "Historical", wide=True), money_col("regionmarket", "Region mkt"), money_col("regionsale", "Region sale"),
		Column("rate", "Sale rate", "rate"), Column("spd", "Sold/day", "num"), money_col("value", "Value src", wide=True),
	], rows)
	doc.section("AuctionDB prices").table(table)
	apply_main(ctx, doc, table, default_limit=200)
	return doc


def cmd_search(ctx: Context, query: Optional[str]) -> Doc:
	text: Optional[str] = query or getattr(ctx.args, "query", None)
	if not text:
		raise TsmctlError("search needs some text: tsmctl search <name>")
	data: TsmData = ctx.data
	matches: list[str] = data.search_items(text)
	ledger: dict[str, ItemStats] = item_stats(data, Filters())
	held: dict[str, int] = holdings_by_item(data, Filters())
	rows: list[dict[str, Any]] = []
	for base in matches:
		info: Optional[ItemInfo] = data.items_by_base.get(base)
		rows.append({
			"item": base, "id": base, "quality": QUALITY_NAMES.get(info.quality, "") if info and info.quality >= 0 else "",
			"ilvl": info.item_level if info and info.item_level > 0 else None,
			"sold": ledger[base].sold if base in ledger else 0, "held": held.get(base, 0),
			"value": ctx.unit_value(base, ""), "group": group_display(data.group_of(base)),
		})
	doc: Doc = Doc(f"Items matching {text!r}", "search")
	table: Table = Table([
		Column("item", "Item", "item", max_width=44), Column("id", "Id"), Column("quality", "Quality"), Column("ilvl", "Ilvl", "int", wide=True),
		money_col("value", "Value"), Column("sold", "You sold", "int"), Column("held", "You hold", "int"), Column("group", "TSM group", wide=True),
	], rows, empty="no matching items in the TSM item cache")
	doc.section(f"Items matching {text!r}").table(table)
	apply_main(ctx, doc, table, default_limit=30)
	return doc


# ============================================================================
# Commands: pnl, top, flips, sellthrough, networth, deals
# ============================================================================

def cmd_pnl(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	filters: Filters = ctx.filters(default_since="30d")
	by: str = getattr(ctx.args, "by", None) or "week"
	valid: tuple[str, ...] = ("day", "week", "month", "year", "realm", "char", "source", "group", "item", "none")
	if by not in valid:
		raise TsmctlError(f"pnl --by must be one of: {', '.join(valid)}")
	buckets: dict[str, tuple[str, Pnl]] = {}
	total: Pnl = Pnl()
	for txn in data.txns:
		if txn.kind in ("expire", "cancel") or not filters.txn_ok(txn):
			continue
		total.add(txn)
		if by == "none":
			continue
		if by in ("day", "week", "month", "year"):
			sort_key, label = bucket_of(txn.time, by)
		elif by == "realm":
			sort_key = label = txn.realm
		elif by == "char":
			sort_key = label = f"{txn.player} ({txn.realm})"
		elif by == "source":
			sort_key = label = f"{txn.kind} {txn.source}".strip()
		elif by == "group":
			sort_key = label = group_display(data.group_of(txn.item)) if txn.item else "(money)"
			label = label or "(ungrouped)"
		else:
			sort_key = label = filters.key(txn.item) if txn.item else "(money)"
		if sort_key not in buckets:
			buckets[sort_key] = (label, Pnl())
		buckets[sort_key][1].add(txn)
	doc: Doc = Doc("Profit & loss", "pnl")
	summary: Section = doc.section("Profit & loss (cash basis)")
	summary.kv(filters.describe() + [
		("AH sales (net of cut)", total.ah_sales, "money"),
		("Vendor sales", total.vendor_sales, "money"),
		("Trade/COD sales", total.other_sales, "money"),
		("Other income", total.income, "money"),
		("Revenue", total.revenue, "money"),
		("Purchases", -total.purchases, "money"),
		("Expenses", -total.expenses, "money"),
		("Net cash flow", total.net, "money"),
		("Units sold", total.units_sold, "int"),
	])
	if by != "none":
		rows: list[dict[str, Any]] = []
		running: int = 0
		ordered: list[str] = sorted(buckets)
		for sort_key in ordered:
			label, pnl = buckets[sort_key]
			running += pnl.net
			rows.append({
				"bucket": label, "ah": pnl.ah_sales, "vendor": pnl.vendor_sales, "other": pnl.other_sales + pnl.income,
				"revenue": pnl.revenue, "purchases": -pnl.purchases, "expenses": -pnl.expenses, "net": pnl.net,
				"cumulative": running, "units": pnl.units_sold,
			})
		bucket_col: Column = Column("bucket", by.title(), "item" if by == "item" and not any(r["bucket"] == "(money)" for r in rows) else "str", max_width=40)
		table: Table = Table([
			bucket_col, money_col("ah", "AH sales"), money_col("vendor", "Vendor"), money_col("other", "Other in", wide=True),
			money_col("revenue", "Revenue"), money_col("purchases", "Purchases", signed=True), money_col("expenses", "Expenses", signed=True),
			money_col("net", "Net", signed=True), money_col("cumulative", "Cumulative", signed=True, wide=by not in ("day", "week", "month", "year")),
			Column("units", "Units", "int", wide=True),
		], rows, totals={
			"bucket": "TOTAL", "ah": total.ah_sales, "vendor": total.vendor_sales, "other": total.other_sales + total.income,
			"revenue": total.revenue, "purchases": -total.purchases, "expenses": -total.expenses, "net": total.net, "units": total.units_sold,
		})
		doc.section(f"By {by}", level=2).table(table)
		apply_main(ctx, doc, table, default_sort=None if by in ("day", "week", "month", "year") else "net")
	doc.section("Notes", level=2).text(
		"Cash basis: purchases count when bought, not when the goods sell, so a heavy buying week shows as a loss. "
		"TSM records AH sale prices after the auction house cut; internal transfers between your own characters are excluded unless --include-internal."
	)
	return doc


TOP_METRICS: dict[str, str] = {
	"profit": "profit", "revenue": "revenue", "sold": "sold", "units": "sold", "roi": "roi", "margin": "margin",
	"spent": "spent", "expired": "expired", "velocity": "velocity", "sales": "sales",
}


def item_stat_rows(ctx: Context, stats: dict[str, ItemStats], filters: Filters) -> list[dict[str, Any]]:
	"""Turn ItemStats into table rows with holdings and current market value."""
	data: TsmData = ctx.data
	held: dict[str, int] = holdings_by_item(data, filters)
	days: float = max(1.0, ((filters.until or ctx.now) - (filters.since or min((s.first_time or ctx.now) for s in stats.values()) if stats else ctx.now)) / SECONDS_PER_DAY)
	rows: list[dict[str, Any]] = []
	for key, s in stats.items():
		realm: str = ctx.pricer.default_realm()
		rows.append({
			"item": key, "sold": s.sold, "revenue": s.revenue, "avg_sale": s.avg_sale, "bought": s.bought, "spent": s.spent,
			"avg_buy": s.avg_buy, "cogs": s.cogs, "profit": s.profit, "margin": s.margin, "roi": s.roi,
			"expired": s.expired, "cancelled": s.cancelled, "sell_through": s.sell_through, "basis": s.basis,
			"held": held.get(key, 0), "velocity": s.sold / days, "sales": s.sales, "last_sale": s.last_sale,
			"vendor_revenue": s.vendor_revenue, "value": ctx.unit_value(key, realm),
			"group": group_display(data.group_of(key)),
		})
	return rows


def cmd_top(ctx: Context) -> Doc:
	what: str = (ctx.args.what or "items").lower()
	filters: Filters = ctx.filters(default_since="30d")
	data: TsmData = ctx.data
	metric: str = TOP_METRICS.get((getattr(ctx.args, "by", None) or "profit").lower(), "")
	doc: Doc = Doc(f"Top {what}", f"top_{what}")
	if what in ("items", "item"):
		if not metric:
			raise TsmctlError(f"top items --by must be one of: {', '.join(TOP_METRICS)}")
		rows: list[dict[str, Any]] = item_stat_rows(ctx, item_stats(data, filters), filters)
		if metric in ("roi", "margin"):
			rows = [r for r in rows if r[metric] is not None]
		table: Table = Table([
			Column("item", "Item", "item", max_width=36), Column("sold", "Sold", "int"), money_col("revenue", "Revenue"),
			money_col("avg_sale", "Avg sale"), Column("bought", "Bought", "int"), money_col("avg_buy", "Avg buy"),
			money_col("profit", "Profit", signed=True), Column("margin", "Margin", "pct", signed=True), Column("roi", "ROI", "pct", signed=True, wide=True),
			Column("sell_through", "Sell-thru", "pct"), Column("velocity", "Sold/day", "num", wide=True), Column("held", "Held", "int"),
			Column("basis", "Basis", wide=True), Column("expired", "Expired", "int", wide=True), Column("group", "TSM group", wide=True),
		], rows, totals={"item": f"{len(rows)} items", "sold": sum(r["sold"] for r in rows), "revenue": sum(r["revenue"] for r in rows), "profit": sum(r["profit"] for r in rows)})
		section: Section = doc.section(f"Top items by {metric}")
		section.kv(filters.describe())
		section.table(table)
		section.text("Profit uses average purchase cost for units you bought; items you never bought (farmed or crafted) have no cost basis, so profit equals revenue.")
		apply_main(ctx, doc, table, default_sort=metric, default_limit=25)
		return doc
	if what in ("chars", "characters", "char"):
		acc: dict[str, Pnl] = {}
		for txn in data.txns:
			if filters.txn_ok(txn):
				acc.setdefault(f"{txn.player} ({txn.realm})", Pnl()).add(txn)
		rows = [{"char": k, "revenue": p.revenue, "purchases": -p.purchases, "expenses": -p.expenses, "net": p.net, "sales": p.sales_count, "units": p.units_sold} for k, p in acc.items()]
		table = Table([
			Column("char", "Character"), money_col("revenue", "Revenue"), money_col("purchases", "Purchases", signed=True),
			money_col("expenses", "Expenses", signed=True), money_col("net", "Net", signed=True), Column("sales", "Sales", "int"), Column("units", "Units", "int"),
		], rows)
		section = doc.section("Top characters")
		section.kv(filters.describe())
		section.table(table)
		apply_main(ctx, doc, table, default_sort="net", default_limit=25)
		return doc
	if what in ("buyers", "customers", "sellers", "suppliers"):
		kind: str = "sale" if what in ("buyers", "customers") else "buy"
		people: dict[str, dict[str, Any]] = {}
		for txn in data.txns:
			if txn.kind == kind and txn.source != "Vendor" and filters.txn_ok(txn):
				entry: dict[str, Any] = people.setdefault(txn.other or "?", {"who": txn.other or "?", "total": 0, "units": 0, "count": 0, "items": set(), "last": 0})
				entry["total"] += txn.total
				entry["units"] += txn.qty
				entry["count"] += 1
				entry["items"].add(item_base(txn.item))
				entry["last"] = max(entry["last"], txn.time)
		rows = [{**e, "items": len(e["items"])} for e in people.values()]
		table = Table([
			Column("who", "Buyer" if kind == "sale" else "Seller"), money_col("total", "Gold"), Column("count", "Deals", "int"),
			Column("units", "Units", "int"), Column("items", "Distinct items", "int"), Column("last", "Last", "time"),
		], rows)
		section = doc.section("Top buyers (your customers)" if kind == "sale" else "Top sellers (your suppliers)")
		section.kv(filters.describe())
		section.table(table)
		apply_main(ctx, doc, table, default_sort="total", default_limit=25)
		return doc
	raise TsmctlError("top takes one of: items, chars, buyers, sellers")


def compute_flips(ctx: Context, filters: Filters, open_only: bool = False, min_spent: Optional[int] = None) -> list[dict[str, Any]]:
	"""
	Flip performance: for every item bought in the window, compare what was
	paid with what was sold since the first purchase, and value what is
	still held at the current price source. Shared by `flips` and `report`.
	"""
	data: TsmData = ctx.data
	pricer: Pricer = ctx.pricer
	first_buy: dict[str, int] = {}
	bought: dict[str, list[int]] = {}
	for txn in data.txns:
		if txn.kind == "buy" and filters.txn_ok(txn):
			key: str = filters.key(txn.item)
			first_buy.setdefault(key, txn.time)
			entry: list[int] = bought.setdefault(key, [0, 0, 0])
			entry[0] += txn.qty
			entry[1] += txn.total
			entry[2] = txn.time
	after: Filters = Filters(**{**filters.__dict__, "since": None})
	sold: dict[str, list[int]] = {}
	for txn in data.txns:
		if txn.kind != "sale" or not txn.item:
			continue
		key = filters.key(txn.item)
		if key in first_buy and txn.time >= first_buy[key] and after.txn_ok(txn):
			entry = sold.setdefault(key, [0, 0, 0])
			entry[0] += txn.qty
			entry[1] += txn.total
			entry[2] = txn.time
	held: dict[str, int] = holdings_by_item(data, filters)
	realm: str = pricer.default_realm()
	rows: list[dict[str, Any]] = []
	for key, (qty_bought, spent, last_buy) in bought.items():
		if min_spent is not None and spent < min_spent:
			continue
		qty_sold, revenue, last_sale = sold.get(key, [0, 0, 0])
		avg_buy: int = spent // qty_bought if qty_bought else 0
		matched: int = min(qty_sold, qty_bought)
		realized: int = (revenue * matched // qty_sold if qty_sold else 0) - avg_buy * matched
		open_qty: int = max(qty_bought - qty_sold, 0)
		unit: Optional[int] = ctx.unit_value(key, realm)
		unrealized: Optional[int] = int(open_qty * (unit * (1 - ctx.settings.ah_cut) - avg_buy)) if unit is not None and open_qty else (0 if not open_qty else None)
		if open_only and not open_qty:
			continue
		if qty_sold and revenue // qty_sold < avg_buy:
			status: str = "LOSING"
		elif open_qty and (ctx.now - max(last_sale, last_buy)) > 7 * SECONDS_PER_DAY:
			status = "STALE"
		elif open_qty and not qty_sold:
			status = "OPEN"
		elif open_qty:
			status = "SELLING"
		else:
			status = "CLOSED"
		rows.append({
			"item": key, "bought": qty_bought, "avg_buy": avg_buy, "spent": spent, "sold": qty_sold,
			"avg_sale": revenue // qty_sold if qty_sold else None, "realized": realized,
			"roi": realized / (avg_buy * matched) if matched and avg_buy else None,
			"open": open_qty, "held": held.get(key, 0), "value": unit, "unrealized": unrealized,
			"total": realized + (unrealized or 0), "status": status, "last_buy": last_buy,
			"tied": open_qty * avg_buy,
		})
	return rows


def cmd_flips(ctx: Context) -> Doc:
	filters: Filters = ctx.filters(default_since="30d")
	min_spent: Optional[int] = parse_money(ctx.args.min_spent) if getattr(ctx.args, "min_spent", None) else None
	rows: list[dict[str, Any]] = compute_flips(ctx, filters, bool(getattr(ctx.args, "open", False)), min_spent)
	realm: str = ctx.pricer.default_realm()
	doc: Doc = Doc("Flips", "flips")
	section: Section = doc.section("Flip performance")
	section.kv(filters.describe() + [
		("Spent", sum(r["spent"] for r in rows), "money"),
		("Realized profit", sum(r["realized"] for r in rows), "money"),
		("Unrealized (open, after cut)", sum(r["unrealized"] or 0 for r in rows), "money"),
		("Capital still tied up", sum(r["tied"] for r in rows), "money"),
	])
	table: Table = Table([
		Column("item", "Item", "item", max_width=34), Column("bought", "Bought", "int"), money_col("avg_buy", "Avg buy"),
		money_col("spent", "Spent", wide=True), Column("sold", "Sold", "int"), money_col("avg_sale", "Avg sale"),
		money_col("realized", "Realized", signed=True), Column("roi", "ROI", "pct", signed=True), Column("open", "Open", "int"),
		money_col("value", "Now", wide=True), money_col("unrealized", "Unrealized", signed=True), money_col("total", "Total P/L", signed=True, wide=True),
		Column("status", "Status"), Column("last_buy", "Last buy", "date", wide=True),
	], rows, empty="no purchases in range")
	section.table(table)
	section.text(f"Open units are valued at {ctx.settings.price_source} on {realm} less a {ctx.settings.ah_cut * 100:g}% AH cut. STALE = still holding with no buy/sale for 7 days.")
	apply_main(ctx, doc, table, default_sort="spent", default_limit=30)
	return doc


def cmd_sellthrough(ctx: Context) -> Doc:
	"""Listing outcomes per item and dead-stock calls."""
	data: TsmData = ctx.data
	filters: Filters = ctx.filters(default_since="30d")
	min_listings: int = 3 if getattr(ctx.args, "min_listings", None) is None else int(ctx.args.min_listings)
	max_rate: Optional[float] = float(ctx.args.max_rate) / 100.0 if getattr(ctx.args, "max_rate", None) is not None else None
	pricer: Pricer = ctx.pricer
	realm: str = pricer.default_realm()
	stats: dict[str, ItemStats] = item_stats(data, filters)
	held: dict[str, int] = holdings_by_item(data, filters)
	rows: list[dict[str, Any]] = []
	for key, s in stats.items():
		outcomes: int = s.ah_sold + s.expired + s.cancelled
		if outcomes < min_listings:
			continue
		rate: Optional[float] = s.sell_through
		if max_rate is not None and (rate is None or rate > max_rate):
			continue
		unit: Optional[int] = ctx.unit_value(key, realm)
		info: Optional[ItemInfo] = data.item_info(key)
		vendor: Optional[int] = info.vendor_sell if info and info.vendor_sell > 0 else None
		region_rate: Optional[float] = pricer.source("dbregionsalerate", key, realm)
		if rate is not None and rate >= 0.5:
			verdict: str = "healthy"
		elif vendor and unit is not None and unit * (1 - ctx.settings.ah_cut) <= vendor:
			verdict = "vendor it"
		elif rate is not None and rate < 0.15 and (region_rate is None or region_rate < 0.05):
			verdict = "dead market: stop posting"
		elif rate is not None and rate < 0.15:
			verdict = "overpriced: lower or wait"
		else:
			verdict = "slow: watch"
		rows.append({
			"item": key, "listed": outcomes, "sold": s.ah_sold, "expired": s.expired, "cancelled": s.cancelled,
			"rate": rate, "region_rate": region_rate, "held": held.get(key, 0), "value": unit, "vendor": vendor,
			"held_value": (unit or 0) * held.get(key, 0), "verdict": verdict, "group": group_display(data.group_of(key)),
		})
	doc: Doc = Doc("Sell-through", "sellthrough")
	section: Section = doc.section("Sell-through and dead stock")
	total_sold: int = sum(r["sold"] for r in rows)
	total_listed: int = sum(r["listed"] for r in rows)
	section.kv(filters.describe() + [
		("Units through the AH", total_listed, "int"),
		("Sold", total_sold, "int"),
		("Overall sell-through", total_sold / total_listed if total_listed else None, "pct"),
		("Items flagged (<15%)", sum(1 for r in rows if r["rate"] is not None and r["rate"] < 0.15), "int"),
	])
	table: Table = Table([
		Column("item", "Item", "item", max_width=34), Column("listed", "Outcomes", "int"), Column("sold", "Sold", "int"),
		Column("expired", "Expired", "int"), Column("cancelled", "Cancelled", "int", wide=True), Column("rate", "Sell-thru", "pct"),
		Column("region_rate", "Region rate", "rate"), Column("held", "Held", "int"), money_col("value", "Value"),
		money_col("vendor", "Vendor", wide=True), money_col("held_value", "Held value", wide=True), Column("verdict", "Verdict"),
		Column("group", "TSM group", wide=True),
	], rows, empty=f"no items with at least {min_listings} AH outcomes in range")
	section.table(table)
	section.text("Outcomes count units that left the AH: sold, expired or cancelled. Re-posting the same unit counts it again, which is the point: each expiry is a lost deposit and lost time.")
	apply_main(ctx, doc, table, default_sort="expired", default_limit=30)
	return doc


VALUATIONS: tuple[str, ...] = ("min", "market")


def value_holdings(ctx: Context, filters: Filters, key_of: Callable[[Holding], str]) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
	"""
	Value every filtered holding at both the minimum and the market price
	source. Returns per-key buckets with goods_<v>/auction_<v> sums, and
	totals that also count unpriced holdings and the market value of items
	with no region sales (the illiquid part of the market figure).
	"""
	data: TsmData = ctx.data
	pricer: Pricer = ctx.pricer
	sources: dict[str, str] = {"min": ctx.settings.price_source, "market": ctx.settings.market_source}
	buckets: dict[str, dict[str, int]] = {}
	extra: dict[str, int] = {"unpriced_min": 0, "unpriced_market": 0, "illiquid_market": 0}
	for holding in data.holdings:
		if not filters.holding_ok(holding):
			continue
		bucket: dict[str, int] = buckets.setdefault(key_of(holding), {f"{part}_{v}": 0 for part in ("goods", "auction") for v in VALUATIONS})
		part: str = "auction" if holding.location == "auction" else "goods"
		realm: str = holding.realm or pricer.default_realm()
		for valuation in VALUATIONS:
			unit: Optional[int] = ctx.unit_value(holding.item, realm, sources[valuation])
			if unit is None:
				extra[f"unpriced_{valuation}"] += 1
				continue
			bucket[f"{part}_{valuation}"] += unit * holding.qty
			if valuation == "market" and pricer.source("dbregionsaleavg", holding.item, realm) is None:
				extra["illiquid_market"] += unit * holding.qty
	return buckets, extra


def cmd_networth(ctx: Context) -> Doc:
	"""
	Net worth two ways: minimum (what goods actually sell for) and market
	(what they are listed at). --valuation min|market|both picks the view.
	"""
	data: TsmData = ctx.data
	filters: Filters = ctx.filters()
	pricer: Pricer = ctx.pricer
	by: str = getattr(ctx.args, "by", None) or "realm"
	if by not in ("realm", "char", "location"):
		raise TsmctlError("networth --by must be realm, char or location")
	view: str = (getattr(ctx.args, "valuation", None) or "both").lower()
	if view not in ("min", "market", "both"):
		raise TsmctlError("networth --valuation must be min, market or both")
	cut: float = 1 - ctx.settings.ah_cut

	def holding_key(holding: Holding) -> str:
		return {
			"realm": holding.realm or "(warbank)",
			"char": f"{holding.owner} ({holding.realm})" if holding.realm else holding.owner,
			"location": holding.location,
		}[by]

	buckets, extra = value_holdings(ctx, filters, holding_key)
	gold_by_key: dict[str, int] = {}
	for char in data.characters.values():
		if filters.char_ok(char):
			key: str = {"realm": char.realm, "char": f"{char.name} ({char.realm})", "location": "gold"}[by]
			gold_by_key[key] = gold_by_key.get(key, 0) + char.money
	_, warbank, guild = liquid_gold(data, filters)
	if warbank:
		key = {"realm": "(warbank)", "char": "Warbank", "location": "gold"}[by]
		gold_by_key[key] = gold_by_key.get(key, 0) + warbank
	if guild:
		key = {"realm": "(guild banks)", "char": "Guild banks", "location": "gold"}[by]
		gold_by_key[key] = gold_by_key.get(key, 0) + guild

	rows: list[dict[str, Any]] = []
	for key in set(gold_by_key) | set(buckets):
		values: dict[str, int] = buckets.get(key, {})
		row: dict[str, Any] = {"key": key, "gold": gold_by_key.get(key, 0)}
		for valuation in VALUATIONS:
			goods: int = values.get(f"goods_{valuation}", 0)
			auction: int = values.get(f"auction_{valuation}", 0)
			row[f"goods_{valuation}"] = goods
			row[f"auction_{valuation}"] = auction
			row[f"holdings_{valuation}"] = goods + auction
			row[f"total_{valuation}"] = row["gold"] + goods + auction
		rows.append(row)
	totals: dict[str, Any] = {"key": "TOTAL"}
	for column in ("gold",) + tuple(f"{p}_{v}" for p in ("goods", "auction", "holdings", "total") for v in VALUATIONS):
		totals[column] = sum(r[column] for r in rows)
	gold: int = totals["gold"]

	doc: Doc = Doc("Net worth", "networth")
	section: Section = doc.section("Net worth")
	pairs: list[tuple[str, Any, str]] = [("Liquid gold", gold, "money")]
	labels: dict[str, str] = {"min": "Minimum", "market": "Market"}
	sources: dict[str, str] = {"min": ctx.settings.price_source, "market": ctx.settings.market_source}
	shown: tuple[str, ...] = VALUATIONS if view == "both" else (view,)
	for valuation in shown:
		holdings: int = totals[f"holdings_{valuation}"]
		pairs += [
			(f"{labels[valuation]} net worth", gold + holdings, "money"),
			(f"  {valuation} goods + posted auctions", holdings, "money"),
			(f"  {valuation} after {ctx.settings.ah_cut * 100:g}% AH cut", gold + int(holdings * cut), "money"),
		]
	if view == "both":
		pairs += [
			("Market minus minimum", totals["holdings_market"] - totals["holdings_min"], "money"),
			("  of which items with no region sales", extra["illiquid_market"], "money"),
		]
	for valuation in shown:
		pairs.append((f"{labels[valuation]} price source", sources[valuation], "str"))
	pairs.append(("Fallback realm", pricer.default_realm(), "str"))
	section.kv(pairs)

	columns: list[Column] = [Column("key", by.title()), money_col("gold", "Gold")]
	if view == "both":
		columns += [
			money_col("goods_min", "Goods min", wide=True), money_col("auction_min", "On AH min", wide=True),
			money_col("goods_market", "Goods mkt", wide=True), money_col("auction_market", "On AH mkt", wide=True),
			money_col("holdings_min", "Holdings min"), money_col("holdings_market", "Holdings mkt"),
			money_col("total_min", "Total min"), money_col("total_market", "Total mkt"),
		]
	else:
		columns += [
			money_col(f"goods_{view}", "Goods"), money_col(f"auction_{view}", "On AH"), money_col(f"total_{view}", "Total"),
		]
	table: Table = Table(columns, rows, totals=totals)
	section.table(table)
	if view in ("min", "both") and extra["unpriced_min"]:
		section.text(f"{extra['unpriced_min']} holding(s) had no minimum price and count as 0 (soulbound or never seen on the AH).")
	if view == "both":
		section.text(
			"Minimum values goods at what they actually sell for region-wide (capped at the realm market, vendor price if they never sell). "
			"Market values them at realm listing prices; the gap from items with no region sales is mostly listings that never fill."
		)
	apply_main(ctx, doc, table, default_sort="total_market" if view == "market" else "total_min")
	return doc


def cmd_deals(ctx: Context) -> Doc:
	"""
	Scan a realm's last AuctionDB snapshot for items whose min buyout is
	well under a reference sell price, ranked by expected value per listing
	(net profit per unit x region sale rate).
	"""
	data: TsmData = ctx.data
	market: Optional[Market] = ctx.market()
	assert market is not None
	pricer: Pricer = ctx.pricer
	realm_arg: list[str] = _split_multi(getattr(ctx.args, "realm", None) or [])
	realm: str = resolve_realm(realm_arg[0], data, market) if realm_arg else pricer.default_realm()
	if not market.has_realm(realm):
		raise TsmctlError(f"no AuctionDB realm data for {realm}; realms with data: {', '.join(market.realm_names())}")
	filters: Filters = ctx.filters()
	sell_source: str = getattr(ctx.args, "sell_source", None) or ctx.settings.sell_source
	buy_source: str = getattr(ctx.args, "buy_source", None) or "dbminbuyout"
	max_pct: float = float(getattr(ctx.args, "max_pct", None) or 70.0) / 100.0
	min_profit: int = parse_money(ctx.args.min_profit) if getattr(ctx.args, "min_profit", None) else 10 * COPPER_PER_GOLD
	min_rate: float = float(getattr(ctx.args, "min_sale_rate", None) or 0.05)
	min_spd: float = float(getattr(ctx.args, "min_sold_per_day", None) or 0.0)
	max_buy: Optional[int] = parse_money(ctx.args.max_buy) if getattr(ctx.args, "max_buy", None) else None
	include_commodities: bool = bool(getattr(ctx.args, "commodities", False))
	cut: float = ctx.settings.ah_cut
	sell_expr: PriceExpr = pricer.expr(sell_source)
	buy_expr: PriceExpr = pricer.expr(buy_source)
	rows: list[dict[str, Any]] = []
	for item in market.realm_items(realm, include_commodities):
		if filters.items is not None and item_base(item) not in filters.items:
			continue
		if item.startswith("p:") and getattr(ctx.args, "no_pets", False):
			continue
		buy: Optional[float] = buy_expr.evaluate(pricer, item, realm)
		if not buy or buy <= 0 or (max_buy is not None and buy > max_buy):
			continue
		ref: Optional[float] = sell_expr.evaluate(pricer, item, realm)
		if not ref or buy > ref * max_pct:
			continue
		profit: float = ref * (1 - cut) - buy
		if profit < min_profit:
			continue
		rate: Optional[float] = pricer.source("dbregionsalerate", item, realm)
		spd: Optional[float] = pricer.source("dbregionsoldperday", item, realm)
		if (rate or 0.0) < min_rate or (spd or 0.0) < min_spd:
			continue
		rows.append({
			"item": item, "buy": int(buy), "ref": int(ref), "pct": buy / ref, "profit": int(profit),
			"roi": profit / buy, "rate": rate, "spd": spd, "auctions": pricer.source("dbnumauctions", item, realm),
			"ev": int(profit * (rate or 0.0)), "market": pricer.source("dbmarket", item, realm),
		})
	doc: Doc = Doc(f"Deals on {realm}", "deals")
	section: Section = doc.section(f"Deals on {realm}")
	snapshot: Optional[int] = market.realm_download_time(realm)
	section.kv([
		("Snapshot", f"{fmt_time(snapshot)} ({fmt_age(ctx.now - snapshot)} old)" if snapshot else "unknown", "str"),
		("Buy at", buy_source, "str"),
		("Sell reference", sell_source, "str"),
		("Rules", f"buy ≤ {max_pct * 100:g}% of reference, net profit ≥ {fmt_money(min_profit, ctx.settings.money)}, sale rate ≥ {min_rate:g}" + (f", sold/day ≥ {min_spd:g}" if min_spd else ""), "str"),
		("Matches", len(rows), "int"),
	])
	table: Table = Table([
		Column("item", "Item", "item", max_width=34), money_col("buy", "Buy"), money_col("ref", "Sell ref"),
		Column("pct", "Buy/ref", "pct"), money_col("profit", "Net/unit", signed=True), Column("roi", "ROI", "pct", wide=True),
		Column("rate", "Sale rate", "rate"), Column("spd", "Sold/day", "num"), Column("auctions", "Auctions", "int"),
		money_col("ev", "EV/listing", signed=True), money_col("market", "Realm mkt", wide=True),
	], rows, empty="nothing matches; loosen --max-pct, --min-profit or --min-sale-rate")
	section.table(table)
	section.text("Min buyouts come from TSM's last realm scan, not live AH data, so verify in game before buying. EV/listing = net profit per unit x region sale rate.")
	apply_main(ctx, doc, table, default_sort="ev", default_limit=30)
	return doc


# ============================================================================
# Commands: describe
# ============================================================================

def cmd_describe(ctx: Context) -> Doc:
	kind: str = ctx.args.kind.lower()
	name: str = " ".join(ctx.args.name)
	if kind in ("item", "items", "i"):
		return describe_item(ctx, name)
	if kind in ("char", "character", "chars", "c"):
		return describe_char(ctx, name)
	if kind in ("realm", "realms", "r"):
		return describe_realm(ctx, name)
	if kind in ("group", "groups", "g"):
		ctx.args.group = [name]
		return cmd_top_for_group(ctx, name)
	raise TsmctlError("describe takes: item, char, realm or group")


def describe_item(ctx: Context, query: str) -> Doc:
	data: TsmData = ctx.data
	matches: list[str] = data.search_items(query)
	if not matches:
		raise TsmctlError(f"no item matches {query!r}")
	if len(matches) > 1:
		exact: list[str] = [m for m in matches if data.item_name(m).lower() == query.lower()]
		if len(exact) != 1:
			listing: str = "\n  ".join(f"{m}  {data.item_name(m)}" for m in matches[:15])
			raise TsmctlError(f"{query!r} matches {len(matches)} items; be more specific or use the id:\n  {listing}")
		matches = exact
	item: str = matches[0]
	ctx.args.item = [item]
	filters: Filters = ctx.filters()
	market: Optional[Market] = ctx.market(required=False)
	pricer: Pricer = ctx.pricer
	info: Optional[ItemInfo] = data.item_info(item)
	doc: Doc = Doc(data.item_name(item), "describe_item_" + re.sub(r"[^a-z0-9]+", "_", data.item_name(item).lower()).strip("_"))

	# Identity
	about: Section = doc.section(f"{data.item_name(item)} ({item})")
	pairs: list[tuple[str, Any, str]] = [("Wowhead", wowhead_url(item), "str")]
	if info:
		pairs += [
			("Quality", QUALITY_NAMES.get(info.quality, "?"), "str"),
			("Item level", info.item_level if info.item_level > 0 else None, "int"),
			("Class", ITEM_CLASS_NAMES.get(info.class_id, str(info.class_id)) if info.class_id >= 0 else None, "str"),
			("Max stack", info.max_stack if info.max_stack > 0 else None, "int"),
			("Vendor sell", info.vendor_sell if info.vendor_sell > 0 else None, "money"),
		]
	pairs += [
		("Vendor buy", pricer.source("vendorbuy", item, ""), "money"),
		("TSM group", group_display(data.group_of(item)) or None, "str"),
	]
	about.kv(pairs)

	# Market
	if market is not None:
		realms: list[str] = sorted(filters.realms) if filters.realms else sorted({c.realm for c in data.characters.values() if market.has_realm(c.realm)} or set(market.realm_names()))
		rows: list[dict[str, Any]] = []
		for realm in realms:
			rows.append({
				"realm": realm, "minbuyout": pricer.source("dbminbuyout", item, realm), "auctions": pricer.source("dbnumauctions", item, realm),
				"market": pricer.source("dbmarket", item, realm), "recent": pricer.source("dbrecent", item, realm),
				"historical": pricer.source("dbhistorical", item, realm), "value": ctx.unit_value(item, realm),
			})
		section: Section = doc.section("Market", level=2)
		section.kv([
			("Region market avg", pricer.source("dbregionmarketavg", item, ""), "money"),
			("Region historical", pricer.source("dbregionhistorical", item, ""), "money"),
			("Region sale avg", pricer.source("dbregionsaleavg", item, ""), "money"),
			("Region sale rate", pricer.source("dbregionsalerate", item, ""), "rate"),
			("Region sold/day", pricer.source("dbregionsoldperday", item, ""), "num"),
		])
		section.table(Table([
			Column("realm", "Realm"), money_col("minbuyout", "Min buyout"), Column("auctions", "Auctions", "int"),
			money_col("market", "Market"), money_col("recent", "Recent"), money_col("historical", "Historical"), money_col("value", "Value src"),
		], rows))

	# Your history
	stats: Optional[ItemStats] = item_stats(data, Filters(**{**filters.__dict__, "variants": False})).get(item_base(item))
	history: Section = doc.section("Your history", level=2)
	if stats is None:
		history.text("No accounting records for this item in range.")
	else:
		history.kv([p for p in filters.describe() if p[0] != "Items"] + [
			("Units sold", stats.sold, "int"), ("Revenue", stats.revenue, "money"),
			("Avg / min / max sale", f"{fmt_money(stats.avg_sale, ctx.settings.money)} / {fmt_money(stats.min_sale, ctx.settings.money)} / {fmt_money(stats.max_sale, ctx.settings.money)}", "str"),
			("Vendor-sold units", stats.vendor_sold, "int"),
			("Units bought", stats.bought, "int"), ("Spent", stats.spent, "money"), ("Avg buy", stats.avg_buy, "money"),
			("Profit (avg cost)", stats.profit, "money"), ("Margin", stats.margin, "pct"),
			("Expired / cancelled", f"{stats.expired:,} / {stats.cancelled:,}", "str"),
			("Sell-through", stats.sell_through, "pct"),
			("Last sale", stats.last_sale, "time"), ("Last buy", stats.last_buy, "time"),
		])
		realm: str = pricer.default_realm()
		unit: Optional[int] = ctx.unit_value(item, realm)
		if stats.avg_buy and unit:
			margin_now: int = int(unit * (1 - ctx.settings.ah_cut)) - stats.avg_buy
			history.text(f"At today's {ctx.settings.price_source} on {realm} ({fmt_money(unit, ctx.settings.money)}), each unit bought at your average cost nets {fmt_money(margin_now, ctx.settings.money)} after the AH cut.")

	# Holdings
	held_rows: list[dict[str, Any]] = [
		{"owner": h.owner, "realm": h.realm or "(account)", "location": h.location, "qty": h.qty, "value": (ctx.unit_value(h.item, h.realm) or 0) * h.qty}
		for h in data.holdings if item_base(h.item) == item_base(item) and filters.holding_ok(h)
	]
	if held_rows:
		doc.section("Holdings", level=2).table(Table([
			Column("owner", "Owner"), Column("realm", "Realm"), Column("location", "Where"), Column("qty", "Qty", "int"), money_col("value", "Value"),
		], held_rows, totals={"owner": "TOTAL", "qty": sum(r["qty"] for r in held_rows), "value": sum(r["value"] for r in held_rows)}))

	# Recent transactions
	recent: list[dict[str, Any]] = [txn_row(t) for t in reversed(data.txns) if filters.txn_ok(t)][:15]
	if recent:
		doc.section("Recent transactions", level=2).table(Table(ledger_columns("ledger"), recent))
	return doc


def describe_char(ctx: Context, query: str) -> Doc:
	data: TsmData = ctx.data
	lowered: str = query.lower()
	matches: list[Character] = [c for c in data.characters.values() if c.name.lower() == lowered or c.key.lower() == lowered or f"{c.name}-{c.realm}".lower() == lowered]
	if not matches:
		matches = [c for c in data.characters.values() if c.name.lower().startswith(lowered)]
	if not matches:
		raise TsmctlError(f"no character matches {query!r}")
	if len(matches) > 1:
		raise TsmctlError(f"{query!r} matches several characters; use Name-Realm: " + ", ".join(f"{c.name}-{c.realm}" for c in matches))
	char: Character = matches[0]
	ctx.args.char = [char.name]
	ctx.args.realm = [char.realm]
	filters: Filters = ctx.filters(default_since="30d")
	doc: Doc = Doc(f"{char.name} - {char.realm}", "describe_char_" + re.sub(r"[^a-z0-9]+", "_", f"{char.name}_{char.realm}".lower()))
	pnl: Pnl = pnl_total(data, filters)
	held: list[Holding] = [h for h in data.holdings if h.owner == char.name and h.realm == char.realm]
	held_value: int = sum((ctx.unit_value(h.item, h.realm) or 0) * h.qty for h in held)
	section: Section = doc.section(f"{char.name} - {char.realm}")
	section.kv([
		("Class", class_name(char.class_key), "str"), ("Faction", char.faction, "str"), ("Guild", char.guild or None, "str"),
		("Account", char.account, "str"), ("Gold", char.money, "money"), ("Inventory value", held_value, "money"),
		("Gold log updated", char.gold_log_updated or None, "time"),
	] + filters.describe() + [
		("Revenue", pnl.revenue, "money"), ("Purchases", -pnl.purchases, "money"), ("Expenses", -pnl.expenses, "money"), ("Net", pnl.net, "money"),
	])
	profs: list[dict[str, Any]] = [{"profession": n, "level": lua_dict(p).get("level"), "max": lua_dict(p).get("maxLevel")} for n, p in sorted(char.professions.items())]
	if profs:
		doc.section("Professions", level=2).table(Table([Column("profession", "Profession"), Column("level", "Skill", "int"), Column("max", "Max", "int")], profs))
	by_loc: dict[tuple[str, str], list[int]] = {}
	for holding in held:
		entry: list[int] = by_loc.setdefault((filters.key(holding.item), holding.location), [0, 0])
		entry[0] += holding.qty
		entry[1] += (ctx.unit_value(holding.item, holding.realm) or 0) * holding.qty
	held_rows: list[dict[str, Any]] = [{"item": k[0], "location": k[1], "qty": v[0], "value": v[1]} for k, v in by_loc.items()]
	held_rows.sort(key=lambda r: r["value"], reverse=True)
	if held_rows:
		doc.section("Most valuable holdings", level=2).table(Table([
			Column("item", "Item", "item", max_width=40), Column("location", "Where"), Column("qty", "Qty", "int"), money_col("value", "Value"),
		], held_rows[:20]))
	recent: list[dict[str, Any]] = [txn_row(t) for t in reversed(data.txns) if filters.txn_ok(t)][:20]
	if recent:
		doc.section("Recent transactions", level=2).table(Table(ledger_columns("ledger"), recent))
	return doc


def describe_realm(ctx: Context, query: str) -> Doc:
	data: TsmData = ctx.data
	market: Optional[Market] = ctx.market(required=False)
	realm: str = resolve_realm(query, data, market)
	ctx.args.realm = [realm]
	filters: Filters = ctx.filters(default_since="30d")
	chars: list[Character] = [c for c in data.characters.values() if c.realm == realm]
	pnl: Pnl = pnl_total(data, filters)
	doc: Doc = Doc(f"Realm {realm}", "describe_realm_" + re.sub(r"[^a-z0-9]+", "_", realm.lower()))
	section: Section = doc.section(f"Realm {realm}")
	snapshot: Optional[int] = market.realm_download_time(realm) if market else None
	section.kv([
		("Characters", len(chars), "int"), ("Gold", sum(c.money for c in chars), "money"),
		("Market snapshot", snapshot, "time"),
		("Items on AH (realm data)", len(market.realm_items(realm, False)) if market and market.has_realm(realm) else None, "int"),
	] + filters.describe() + [
		("Revenue", pnl.revenue, "money"), ("Purchases", -pnl.purchases, "money"), ("Expenses", -pnl.expenses, "money"), ("Net", pnl.net, "money"),
	])
	rows: list[dict[str, Any]] = [{"name": c.name, "class": class_name(c.class_key), "gold": c.money, "guild": c.guild} for c in chars]
	section.table(Table([Column("name", "Character"), Column("class", "Class"), money_col("gold", "Gold"), Column("guild", "Guild")], sorted(rows, key=lambda r: -r["gold"])))
	return doc


def cmd_top_for_group(ctx: Context, name: str) -> Doc:
	filters: Filters = ctx.filters(default_since="30d")
	rows: list[dict[str, Any]] = item_stat_rows(ctx, item_stats(ctx.data, filters), filters)
	items: set[str] = filters.items or set()
	have: set[str] = {r["item"] for r in rows}
	held: dict[str, int] = holdings_by_item(ctx.data, filters)
	for base in items - have:
		rows.append({"item": base, "sold": 0, "revenue": 0, "profit": 0, "held": held.get(base, 0), "value": ctx.unit_value(base, ""), "sell_through": None, "avg_sale": None})
	doc: Doc = Doc(f"Group {name}", "describe_group_" + re.sub(r"[^a-z0-9]+", "_", name.lower()))
	section: Section = doc.section(f"TSM group: {name}")
	section.kv(filters.describe() + [("Items", len(items), "int"), ("Revenue", sum(r["revenue"] for r in rows), "money"), ("Profit", sum(r["profit"] for r in rows), "money")])
	table: Table = Table([
		Column("item", "Item", "item", max_width=40), Column("sold", "Sold", "int"), money_col("revenue", "Revenue"), money_col("avg_sale", "Avg sale"),
		money_col("profit", "Profit", signed=True), Column("sell_through", "Sell-thru", "pct"), Column("held", "Held", "int"), money_col("value", "Unit value"),
	], rows)
	section.table(table)
	apply_main(ctx, doc, table, default_sort="revenue", default_limit=40)
	return doc


# ============================================================================
# Commands: status, paths, config
# ============================================================================

def cmd_status(ctx: Context) -> Doc:
	data: TsmData = ctx.data
	market: Optional[Market] = ctx.market(required=False)
	doc: Doc = Doc("tsmctl status", "status")
	section: Section = doc.section("Data source")
	section.kv([
		("Mode", "remote" if ctx.source.remote else "local", "str"),
		("Source", ctx.source.describe(), "str"),
		("Last sync", ctx.source.synced_at, "time") if ctx.source.remote else ("WoW dir", str(ctx.source.root), "str"),
		("Using stale cache", "yes" if ctx.source.stale else "no", "str"),
		("Config", str(ctx.settings.config_path) if ctx.settings.config_path else "(none)", "str"),
		("Accounts", ", ".join(data.accounts), "str"),
		("Characters", len(data.characters), "int"),
		("Realms", ", ".join(data.realms()), "str"),
		("Item cache entries", len(data.items), "int"),
		("TSM groups", len(data.group_paths), "int"),
	])
	files: list[dict[str, Any]] = [{"file": f"{f.account}/SavedVariables/{f.path.name}", "size": f.size, "modified": f.mtime, "age": fmt_age(ctx.now - f.mtime)} for f in data.files]
	if data.appdata_path is not None:
		stat: os.stat_result = data.appdata_path.stat()
		files.append({"file": APPDATA_REL, "size": stat.st_size, "modified": stat.st_mtime, "age": fmt_age(ctx.now - stat.st_mtime)})
	doc.section("Files", level=2).table(Table([Column("file", "File"), Column("size", "Bytes", "int"), Column("modified", "Modified", "time"), Column("age", "Age")], files))
	counts: dict[str, int] = {}
	latest: dict[str, int] = {}
	for txn in data.txns:
		counts[txn.kind] = counts.get(txn.kind, 0) + 1
		latest[txn.kind] = max(latest.get(txn.kind, 0), txn.time)
	first: Optional[int] = data.txns[0].time if data.txns else None
	doc.section("Ledger", level=2).table(Table([Column("kind", "Kind"), Column("rows", "Rows", "int"), Column("latest", "Latest", "time")],
		[{"kind": k, "rows": counts[k], "latest": latest[k]} for k in LEDGER_KEYS if k in counts], title=f"Ledger since {fmt_date(first)}"))
	if market is not None:
		market_rows: list[dict[str, Any]] = [
			{"where": where, "tag": d.tag.replace("AUCTIONDB_", "").lower(), "items": len(d.rows), "downloaded": d.download_time, "age": fmt_age(ctx.now - d.download_time) if d.download_time else "-"}
			for where, d in market.datasets()
		]
		market_section: Section = doc.section("Market data (AppData.lua)", level=2)
		market_section.kv([("TSM app last sync", market.app_sync, "time"), ("Region", market.region, "str")])
		market_section.table(Table([Column("where", "Realm/region"), Column("tag", "Dataset"), Column("items", "Items", "int"), Column("downloaded", "Downloaded", "time"), Column("age", "Age")], market_rows))
	# Warnings worth acting on.
	warnings: list[str] = []
	newest_sv: float = max((f.mtime for f in data.files), default=0)
	if newest_sv and ctx.now - newest_sv > SECONDS_PER_DAY:
		warnings.append(f"SavedVariables are {fmt_age(ctx.now - newest_sv)} old; WoW only writes them on logout or /reload.")
	if market is not None and market.app_sync and ctx.now - market.app_sync > 6 * 3600:
		warnings.append(f"TSM app last synced {fmt_age(ctx.now - market.app_sync)} ago; run `tsm-app` to refresh prices.")
	if market is None:
		warnings.append("No AppData.lua: market prices, valuations and deals are unavailable.")
	if data.trimmed:
		warnings.append("TSM trimmed old accounting data for: " + ", ".join(data.trimmed))
	own_chars: set[str] = {c.realm for c in data.characters.values()}
	if market is not None:
		missing: list[str] = sorted(r for r in own_chars if not market.has_realm(r))
		if missing:
			warnings.append("No realm market data (TSM app realm list) for: " + ", ".join(missing))
	warnings.extend(Log.warnings)
	if warnings:
		warn_section: Section = doc.section("Warnings", level=2)
		for warning in warnings:
			warn_section.text(f"- {warning}")
	return doc


def cmd_paths(ctx: Context) -> Doc:
	settings: Settings = ctx.settings
	doc: Doc = Doc("tsmctl paths", "paths")
	doc.section("Paths").kv([
		("Config", str(settings.config_path or DEFAULT_CONFIG_PATH) + ("" if settings.config_path else " (not present)"), "str"),
		("Host", settings.host or "(local)", "str"),
		("WoW dir", f"{settings.wow_dir}/{settings.flavor}", "str"),
		("Data root", str(ctx.source.root), "str"),
		("Cache dir", str(settings.cache_dir), "str"),
		("Notes dir", str(settings.notes_dir), "str"),
		("Report dir (--save)", str(settings.report_dir), "str"),
		("Default report file", str(settings.report_dir / default_save_name("report")), "str"),
	])
	return doc


SAMPLE_CONFIG: str = """\
# ~/.config/tsmctl/config.yaml - tsmctl settings (flat YAML; CLI and env win)

# Machine that runs WoW. Leave empty (or set to this machine's hostname) to
# read the local install. Remote reads are ssh + find/tar only.
host: mob-zach

# WoW install root on that machine (~ is the remote $HOME) and game flavor.
wow_dir: "~/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/compatdata/2555556235/pfx/drive_c/Program Files (x86)/World of Warcraft"
flavor: _retail_

# Only read these WoW account folders (default: all).
# accounts:
#   - ZAKMANN

# Realm used for account-wide items (warbank) and deals when --realm is absent.
# realm: Thorium Brotherhood

# How holdings are valued. price_source is the minimum (what actually sells:
# region sale average capped at realm market, vendor price if it never sells)
# and is used everywhere; market_source is the optimistic market-price view
# shown next to it by `networth` and `report`.
price_source: "check(dbregionsaleavg, min(dbmarket, dbregionsaleavg), vendorsell)"
market_source: "first(dbmarket, dbregionmarketavg, vendorsell)"
# Reference sell price for `deals`.
sell_source: "first(dbregionsaleavg, dbmarket)"
ah_cut: 5

# Where --save writes org reports, and the notes repo root (for index links).
report_dir: ~/Documents/notes/02_areas/personal/wow/accounting
notes_dir: ~/Documents/notes

# Money format: g (1,234.56g), gsc (1,234g 56s 00c) or copper.
money: g

# Extra ssh options, e.g. a jump host.
# ssh_options:
#   - -J
#   - bastion
"""


def cmd_config(ctx: Context) -> Doc:
	action: str = (ctx.args.action or "view").lower()
	if action == "sample":
		sys.stdout.write(SAMPLE_CONFIG)
		raise SystemExit(0)
	if action != "view":
		raise TsmctlError("config takes: view or sample")
	settings: Settings = ctx.settings
	doc: Doc = Doc("tsmctl config", "config")
	rows: list[dict[str, Any]] = []
	for name in ("host", "wow_dir", "flavor", "cache_dir", "accounts", "realm", "price_source", "market_source", "sell_source", "ah_cut", "notes_dir", "report_dir", "money", "color", "author", "categories"):
		value: Any = getattr(settings, name)
		if name == "ah_cut":
			value = f"{value * 100:g}%"
		elif isinstance(value, list):
			value = ", ".join(value) or "(all)"
		rows.append({"setting": name, "value": str(value) or "-", "from": settings.sources.get(name, "default")})
	section: Section = doc.section("Effective configuration")
	section.kv([("Config file", str(settings.config_path) if settings.config_path else f"(none; would read {DEFAULT_CONFIG_PATH})", "str")])
	table: Table = Table([Column("setting", "Setting"), Column("value", "Value", max_width=70), Column("from", "From")], rows)
	section.table(table)
	doc.main = table
	return doc


# ============================================================================
# Commands: report
# ============================================================================

REPORT_SECTIONS: tuple[str, ...] = ("summary", "pnl", "top", "flips", "sellthrough", "inventory", "gold", "deals")


def cmd_report(ctx: Context) -> Doc:
	"""The whole business on one page: summary, P&L, products, flips, stock, gold."""
	data: TsmData = ctx.data
	filters: Filters = ctx.filters(default_since="30d")
	top_n: int = int(getattr(ctx.args, "top", None) or 15)
	wanted: list[str] = _split_multi(getattr(ctx.args, "sections", None) or []) or [s for s in REPORT_SECTIONS if s != "deals"]
	if getattr(ctx.args, "deals", False) and "deals" not in wanted:
		wanted.append("deals")
	unknown: list[str] = [s for s in wanted if s not in REPORT_SECTIONS]
	if unknown:
		raise TsmctlError(f"unknown report section(s) {', '.join(unknown)}; choose from {', '.join(REPORT_SECTIONS)}")
	ctx.market(required=False)
	pricer: Pricer = ctx.pricer
	doc: Doc = Doc(f"TSM business report {datetime.now().strftime('%Y-%m-%d')}", "report")

	period_start: int = filters.since or (data.txns[0].time if data.txns else ctx.now)
	period_end: int = filters.until or ctx.now
	days: float = max(1.0, (period_end - period_start) / SECONDS_PER_DAY)
	pnl: Pnl = pnl_total(data, filters)
	stats: dict[str, ItemStats] = item_stats(data, filters)
	stat_rows: list[dict[str, Any]] = item_stat_rows(ctx, stats, filters)

	# Holdings valuation (shared by summary and inventory).
	goods: int = 0
	on_ah: int = 0
	held_by_item: dict[str, list[int]] = {}
	for holding in data.holdings:
		if not filters.holding_ok(holding):
			continue
		unit: int = ctx.unit_value(holding.item, holding.realm) or 0
		value: int = unit * holding.qty
		if holding.location == "auction":
			on_ah += value
		else:
			goods += value
		entry: list[int] = held_by_item.setdefault(filters.key(holding.item), [0, 0])
		entry[0] += holding.qty
		entry[1] += value
	char_gold, warbank, guild = liquid_gold(data, filters)
	liquid: int = char_gold + warbank + guild
	market_holdings: int = 0
	if "summary" in wanted:
		market_buckets, _ = value_holdings(ctx, filters, lambda h: "all")
		market_holdings = sum(v for k, v in market_buckets.get("all", {}).items() if k.endswith("_market"))
	gold_change: Optional[int] = gold_change_between(data, filters, period_start, period_end)
	realized: int = sum(r["realized"] for r in compute_flips(ctx, filters))
	ah_units: int = sum(s.ah_sold + s.expired + s.cancelled for s in stats.values())
	ah_sold: int = sum(s.ah_sold for s in stats.values())

	if "summary" in wanted:
		section: Section = doc.section("Summary")
		section.kv(filters.describe() + [
			("Days covered", round(days, 1), "num"),
			("Revenue", pnl.revenue, "money"),
			("  AH sales (net of cut)", pnl.ah_sales, "money"),
			("  Vendor sales", pnl.vendor_sales, "money"),
			("  Trade/COD + other income", pnl.other_sales + pnl.income, "money"),
			("Purchases", -pnl.purchases, "money"),
			("Expenses", -pnl.expenses, "money"),
			("Net cash flow", pnl.net, "money"),
			("Net cash flow per day", pnl.net / days, "money"),
			("Realized flip profit", realized, "money"),
			("AH sell-through", ah_sold / ah_units if ah_units else None, "pct"),
			("Gold change (gold log)", gold_change, "money"),
			("Liquid gold", liquid, "money"),
			("Net worth, minimum", liquid + goods + on_ah, "money"),
			("  min goods + posted auctions", goods + on_ah, "money"),
			("Net worth, market", liquid + market_holdings, "money"),
			("  market goods + posted auctions", market_holdings, "money"),
			("Minimum valued at", ctx.settings.price_source, "str"),
			("Market valued at", f"{ctx.settings.market_source} (fallback realm {pricer.default_realm()})", "str"),
		])
		highlights: list[str] = []
		best: list[dict[str, Any]] = sorted(stat_rows, key=lambda r: r["profit"], reverse=True)[:3]
		if best and best[0]["profit"] > 0:
			highlights.append("Best earners: " + ", ".join(f"{data.item_name(r['item'])} ({fmt_money(r['profit'], ctx.settings.money)})" for r in best if r["profit"] > 0) + ".")
		losers: list[dict[str, Any]] = [r for r in stat_rows if r["bought"] and r["avg_sale"] is not None and r["avg_buy"] and r["avg_sale"] < r["avg_buy"]]
		if losers:
			highlights.append(f"{len(losers)} item(s) sold below average cost: " + ", ".join(data.item_name(r["item"]) for r in losers[:5]) + ".")
		dead: list[dict[str, Any]] = [r for r in stat_rows if r["sell_through"] is not None and r["sell_through"] < 0.15 and r["expired"] >= 5]
		if dead:
			highlights.append(f"{len(dead)} item(s) under 15% sell-through with 5+ expiries; reprice, vendor or stop posting.")
		if pnl.purchases > pnl.revenue:
			highlights.append("Spent more than you took in this period; check `flips` for how much of that is stock still to sell.")
		if highlights:
			section.text("Highlights:")
			for line in highlights:
				section.text(f"- {line}")

	if "pnl" in wanted:
		by: str = "day" if days <= 14 else ("week" if days <= 120 else "month")
		buckets: dict[str, Pnl] = {}
		labels: dict[str, str] = {}
		for txn in data.txns:
			if txn.kind not in ("expire", "cancel") and filters.txn_ok(txn):
				sort_key, label = bucket_of(txn.time, by)
				labels[sort_key] = label
				buckets.setdefault(sort_key, Pnl()).add(txn)
		rows: list[dict[str, Any]] = []
		running: int = 0
		for sort_key in sorted(buckets):
			p: Pnl = buckets[sort_key]
			running += p.net
			rows.append({"bucket": labels[sort_key], "ah": p.ah_sales, "vendor": p.vendor_sales, "revenue": p.revenue, "purchases": -p.purchases, "expenses": -p.expenses, "net": p.net, "cumulative": running})
		doc.section(f"Profit & loss by {by}").table(Table([
			Column("bucket", by.title()), money_col("ah", "AH sales"), money_col("vendor", "Vendor"), money_col("revenue", "Revenue"),
			money_col("purchases", "Purchases", signed=True), money_col("expenses", "Expenses", signed=True), money_col("net", "Net", signed=True),
			money_col("cumulative", "Cumulative", signed=True),
		], rows, totals={"bucket": "TOTAL", "ah": pnl.ah_sales, "vendor": pnl.vendor_sales, "revenue": pnl.revenue, "purchases": -pnl.purchases, "expenses": -pnl.expenses, "net": pnl.net}))

	if "top" in wanted:
		earners: list[dict[str, Any]] = sorted((r for r in stat_rows if r["revenue"] > 0), key=lambda r: r["profit"], reverse=True)[:top_n]
		doc.section(f"Top {top_n} products by profit").table(Table([
			Column("item", "Item", "item", max_width=34), Column("sold", "Sold", "int"), money_col("revenue", "Revenue"), money_col("avg_sale", "Avg sale"),
			money_col("avg_buy", "Avg buy"), money_col("profit", "Profit", signed=True), Column("margin", "Margin", "pct", signed=True),
			Column("sell_through", "Sell-thru", "pct"), Column("velocity", "Sold/day", "num"), Column("held", "Held", "int"),
		], earners, empty="no sales in range"))

	if "flips" in wanted:
		flip_rows: list[dict[str, Any]] = compute_flips(ctx, filters)
		flip_rows.sort(key=lambda r: r["spent"], reverse=True)
		section = doc.section("Flips (items bought in period)")
		section.kv([
			("Spent on stock", sum(r["spent"] for r in flip_rows), "money"),
			("Realized profit", sum(r["realized"] for r in flip_rows), "money"),
			("Capital tied up in unsold stock", sum(r["tied"] for r in flip_rows), "money"),
			("Unrealized P/L on that stock", sum(r["unrealized"] or 0 for r in flip_rows), "money"),
		])
		section.table(Table([
			Column("item", "Item", "item", max_width=34), Column("bought", "Bought", "int"), money_col("avg_buy", "Avg buy"), money_col("spent", "Spent"),
			Column("sold", "Sold", "int"), money_col("avg_sale", "Avg sale"), money_col("realized", "Realized", signed=True), Column("open", "Open", "int"),
			money_col("unrealized", "Unrealized", signed=True), Column("status", "Status"),
		], flip_rows[:top_n], empty="no purchases in range"))

	if "sellthrough" in wanted:
		weak: list[dict[str, Any]] = sorted(
			(r for r in stat_rows if r["sell_through"] is not None and r["expired"] >= 3 and r["sell_through"] < 0.5),
			key=lambda r: (r["sell_through"], -r["expired"]),
		)[:top_n]
		section = doc.section("Dead and slow stock")
		section.table(Table([
			Column("item", "Item", "item", max_width=34), Column("sold", "Sold", "int"), Column("expired", "Expired", "int"),
			Column("cancelled", "Cancelled", "int"), Column("sell_through", "Sell-thru", "pct"), Column("held", "Held", "int"), money_col("value", "Unit value"),
		], weak, empty="no slow movers (sell-through under 50% with 3+ expiries)"))
		section.text("Each expiry costs the deposit and a relist. Under ~15% sell-through, cut the price, vendor it, or stop posting.")

	if "inventory" in wanted:
		inv_rows: list[dict[str, Any]] = [{"item": k, "qty": v[0], "value": v[1], "unit": v[1] // v[0] if v[0] else None} for k, v in held_by_item.items() if v[1] > 0]
		inv_rows.sort(key=lambda r: r["value"], reverse=True)
		section = doc.section(f"Top {top_n} holdings by value")
		section.kv([("Goods", goods, "money"), ("Posted on AH", on_ah, "money"), ("Distinct items held", len(held_by_item), "int")])
		section.table(Table([Column("item", "Item", "item", max_width=40), Column("qty", "Qty", "int"), money_col("unit", "Unit value"), money_col("value", "Value")], inv_rows[:top_n]))

	if "gold" in wanted:
		gold_rows: list[dict[str, Any]] = [{"owner": f"{c.name} ({c.realm})", "gold": c.money} for c in data.characters.values() if filters.char_ok(c) and c.money >= COPPER_PER_GOLD]
		if warbank:
			gold_rows.append({"owner": "Warbank", "gold": warbank})
		if guild:
			gold_rows.append({"owner": "Guild banks (last log)", "gold": guild})
		gold_rows.sort(key=lambda r: r["gold"], reverse=True)
		doc.section("Gold by character").table(Table([Column("owner", "Owner"), money_col("gold", "Gold")], gold_rows, totals={"owner": "TOTAL", "gold": liquid}))

	if "deals" in wanted and data.market is not None:
		deal_args: argparse.Namespace = argparse.Namespace(**vars(ctx.args))
		deal_args.sort = None
		deal_args.limit = top_n
		deal_ctx: Context = Context.__new__(Context)
		deal_ctx.__dict__.update(ctx.__dict__)
		deal_ctx.args = deal_args
		deal_ctx._filters = None
		deal_doc: Doc = cmd_deals(deal_ctx)
		for deal_section in deal_doc.sections:
			doc.sections.append(deal_section)

	notes: Section = doc.section("Method")
	notes.text("- Source: TSM accounting in SavedVariables (as of each account's last logout or /reload) and TSM desktop app AuctionDB data.")
	notes.text("- AH sale prices are recorded by TSM after the 5% AH cut; purchases are what you paid. Transfers between your own characters are excluded.")
	notes.text("- Net cash flow is cash basis (stock bought this period counts now). Realized profit matches units sold against average purchase cost.")
	notes.text(f"- Goods are valued at {ctx.settings.price_source} (minimum, used throughout) and, for the market net worth only, at {ctx.settings.market_source}. Gold history comes from TSM's gold log, rounded to 1,000g.")
	return doc


# ============================================================================
# Saving into the notes repo
# ============================================================================

def default_save_name(slug: str) -> str:
	stamp: str = datetime.now().strftime("%Y%m%d")
	if slug == "report":
		return f"{stamp}_tsm_report.org"
	return f"{stamp}_tsm_{re.sub(r'[^a-z0-9]+', '_', slug.lower()).strip('_')}.org"


def resolve_save_path(ctx: Context, doc: Doc) -> Path:
	"""--save with no value uses the report dir; a directory gets the default name."""
	target: str = ctx.args.save
	ext: str = {"org": ".org", "text": ".txt", "csv": ".csv", "tsv": ".tsv", "json": ".json"}[ctx.args.output_format]
	name: str = default_save_name(doc.slug)
	if ext != ".org":
		name = name[: -len(".org")] + ext
	if target in ("", "-"):
		return ctx.settings.report_dir / name
	path: Path = Path(target).expanduser()
	if path.is_dir() or target.endswith("/"):
		return path / name
	return path


def write_saved(ctx: Context, doc: Doc, body: str) -> Path:
	"""
	Write a document to disk atomically. Org files become roam nodes: an
	:ID: drawer (kept stable when regenerating), standard headers, and a link
	in the directory's 00_index.org when it lives inside the notes repo.
	"""
	path: Path = resolve_save_path(ctx, doc)
	fmt: str = ctx.args.output_format
	existing: str = ""
	if path.exists():
		try:
			existing = path.read_text(encoding="utf-8")
		except OSError as exc:
			raise TsmctlError(f"cannot read existing {path}: {exc}") from exc
		if fmt == "org" and "#+generator: tsmctl" not in existing and not ctx.args.force:
			raise TsmctlError(f"{path} exists and was not written by tsmctl; use --force to overwrite it")
	path.parent.mkdir(parents=True, exist_ok=True)
	content: str = body
	title: str = doc.title
	node_id: str = ""
	if fmt == "org":
		created: str = iso_now()
		version: str = "1.0"
		match: Optional[re.Match[str]] = re.search(r"^:ID:\s+(\S+)", existing, re.M)
		if match:
			node_id = match.group(1)
		found: Optional[re.Match[str]] = re.search(r"^#\+created:\s*(\S+)", existing, re.M)
		if found:
			created = found.group(1)
		found = re.search(r"^#\+version:\s*(\d+)\.(\d+)", existing, re.M)
		if found:
			version = f"{found.group(1)}.{int(found.group(2)) + 1}"
		node_id = node_id or str(uuid.uuid4())
		day: str = datetime.now().strftime("%Y-%m-%d")
		title = f"{day} TSM {'business report' if doc.slug == 'report' else doc.title}"
		header: list[str] = [
			":PROPERTIES:",
			f":ID:       {node_id}",
			":END:",
			f"#+title: {title}",
			f"#+description: TradeSkillMaster {('business report' if doc.slug == 'report' else doc.title.lower())} generated by tsmctl from WoW/TSM data",
			f"#+authors: {ctx.settings.author}",
			f"#+categories: {ctx.settings.categories}",
			f"#+created: {created}",
			f"#+updated: {iso_now()}",
			f"#+version: {version}",
			f"#+generator: tsmctl {VERSION} {doc.slug}",
			"",
		]
		content = "\n".join(header) + body
	tmp: Path = path.with_name(f".{path.name}.tmp")
	tmp.write_text(content, encoding="utf-8")
	os.replace(tmp, path)
	if fmt == "org":
		_register_in_index(ctx, path, node_id, title)
	return path


def _register_in_index(ctx: Context, path: Path, node_id: str, title: str) -> None:
	"""Add `- [[id:..][title]]` to the directory's 00_index.org (sorted, once)."""
	if getattr(ctx.args, "no_index", False):
		return
	index: Path = path.parent / "00_index.org"
	try:
		inside_notes: bool = path.resolve().is_relative_to(ctx.settings.notes_dir.resolve())
	except OSError:
		inside_notes = False
	if not inside_notes:
		return
	if not index.is_file():
		Log.warn(f"{index} does not exist; {path.name} is not linked from an index")
		return
	text: str = index.read_text(encoding="utf-8")
	if f"[[id:{node_id}]" in text:
		return
	lines: list[str] = text.split("\n")
	bullet: str = f"- [[id:{node_id}][{title}]]"
	# Prefer the list under a "* Reports" heading; else the first id-link list.
	heading: Optional[int] = next((i for i, line in enumerate(lines) if re.match(r"^\*+ Reports\s*$", line)), None)
	block_start: Optional[int]
	if heading is not None:
		section_end: int = next((i for i in range(heading + 1, len(lines)) if lines[i].startswith("*")), len(lines))
		block_start = next((i for i in range(heading + 1, section_end) if lines[i].startswith("- [[id:")), None)
		if block_start is None:
			lines[heading + 1:heading + 1] = ["", bullet]
			block_start = -1
	else:
		block_start = next((i for i, line in enumerate(lines) if line.startswith("- [[id:")), None)
	if block_start == -1:
		pass
	elif block_start is None:
		insert_at: int = max((i for i, line in enumerate(lines) if line.startswith("#+")), default=-1) + 1
		lines[insert_at:insert_at] = ["", bullet] if insert_at < len(lines) and lines[insert_at] != "" else [bullet]
	else:
		block_end: int = block_start
		while block_end < len(lines) and lines[block_end].startswith("- [[id:"):
			block_end += 1
		block: list[str] = lines[block_start:block_end] + [bullet]
		block.sort(key=lambda line: re.sub(r"^- \[\[id:[^\]]+\]\[", "", line).lower())
		lines[block_start:block_end] = block
	updated: str = "\n".join(lines)
	updated = re.sub(r"^#\+updated:.*$", f"#+updated: {iso_now()}", updated, count=1, flags=re.M)
	tmp: Path = index.with_name(f".{index.name}.tmp")
	tmp.write_text(updated, encoding="utf-8")
	os.replace(tmp, index)
	Log.info(f"linked {path.name} from {index}")


# ============================================================================
# CLI
# ============================================================================

EPILOG: str = """\
commands:
  status                       data sources, freshness and warnings
  get <resource> [query]       list things; resources:
                                 accounts realms chars gold gold-history
                                 sales buys income expenses expired cancelled ledger
                                 inventory auctions groups prices professions items sources
  describe <kind> <name>       item | char | realm | group, in depth
  search <text>                find items by name or id
  pnl                          profit & loss (--by day|week|month|realm|char|source|group|item)
  top <what>                   items (--by profit|revenue|sold|roi|margin|velocity|expired|spent),
                               chars, buyers, sellers
  flips                        buy-to-sell performance, open positions, capital tied up
  sellthrough                  listing outcomes per item, dead-stock verdicts
  networth                     gold + goods + posted auctions (--by realm|char|location)
  deals                        scan a realm's last AuctionDB snapshot for buys
  report                       the whole business: summary, P&L, products, flips, stock, gold
  paths | config [view|sample] where things are and the effective settings

output:
  everything goes to stdout as text; -o wide|org|csv|tsv|json changes the format.
  --save writes an org file instead (default dir: ~/Documents/notes/02_areas/personal/wow/accounting,
  name <YYYYMMDD>_tsm_report.org for `report`, <YYYYMMDD>_tsm_<command>.org otherwise)
  and links it from that directory's 00_index.org.

examples:
  tsmctl status
  tsmctl report
  tsmctl report --since 7d --save
  tsmctl report --period last-month --deals -o org
  tsmctl pnl --by day --since 14d
  tsmctl pnl --by group --since month
  tsmctl get sales --since today
  tsmctl get sales "card of omens" -n 0 -o csv > omens.csv
  tsmctl get buys --realm thorium --since 2026-09-01 --until 2026-10-01
  tsmctl get inventory --min-value 500g
  tsmctl get inventory --by char
  tsmctl get gold
  tsmctl get gold-history --by week --since 3m
  tsmctl describe item "Card of Omens"
  tsmctl describe char Drgold-Thorium Brotherhood
  tsmctl top items --by roi --since 30d
  tsmctl top buyers
  tsmctl flips --open
  tsmctl sellthrough --max-rate 20
  tsmctl networth --by char
  tsmctl deals --realm "Moon Guard" --max-pct 60 --min-profit 100g --min-sale-rate 0.1
  tsmctl get prices 113355 --realm thorium
  tsmctl --host mob-zach --refresh status
  tsmctl -o json get chars | yq -P '.sections[0].tables[0].rows'

time values (--since/--until): 12h 7d 2w 3m 1y today yesterday week month ytd all,
  2026-09-01, 2026-09-01T18:00, or an epoch. --period also takes last-week, last-month, last-year.

price expressions: sources (tsmctl get sources) combined with min() max() avg() first() check(),
  + - * /, N%, and money like 10g or 1g50s, e.g. "first(dbmarket, 80% dbregionmarketavg)".

read-only: tsmctl never writes to the WoW/TSM files. Remote hosts are only asked to
  run find and tar c; only --save writes, and only into the notes repo or the path given.
"""


def add_common_options(parser: argparse.ArgumentParser, suppress: bool) -> None:
	"""
	Options accepted both before and after the command. On subcommands the
	defaults are SUPPRESS so they never clobber values given up front.
	"""
	def d(value: Any) -> Any:
		return argparse.SUPPRESS if suppress else value

	group: argparse._ArgumentGroup = parser.add_argument_group("data source")
	group.add_argument("--host", default=d(None), metavar="HOST", help="read WoW data from HOST over ssh (read-only); default from config/$TSMCTL_HOST")
	group.add_argument("--local", action="store_true", default=d(False), help="ignore any configured host and read the local install")
	group.add_argument("--wow-dir", default=d(None), metavar="DIR", help="World of Warcraft directory (~ = that host's $HOME)")
	group.add_argument("--flavor", default=d(None), metavar="NAME", help="game flavor dir: _retail_ (default), _classic_, _classic_era_ ...")
	group.add_argument("--account", action="append", default=d(None), metavar="NAME", help="only these WoW account folders (repeatable, comma-separated)")
	group.add_argument("--cache-dir", default=d(None), metavar="DIR", help=f"cache for remote copies (default {DEFAULT_CACHE_DIR})")
	group.add_argument("--offline", action="store_true", default=d(False), help="use cached remote data without contacting the host")
	group.add_argument("--refresh", action="store_true", default=d(False), help="re-copy every remote file even if unchanged")
	group.add_argument("--config", default=d(None), metavar="PATH", help=f"config file (default {DEFAULT_CONFIG_PATH})")
	group.add_argument("--no-config", action="store_true", default=d(False), help="ignore the config file")

	flt: argparse._ArgumentGroup = parser.add_argument_group("filters")
	flt.add_argument("--realm", action="append", default=d(None), metavar="REALM", help="only these realms (prefix match, repeatable)")
	flt.add_argument("--char", action="append", default=d(None), metavar="NAME", help="only these characters (repeatable)")
	flt.add_argument("--item", action="append", default=d(None), metavar="ITEM", help="only these items: id, i:ID, wowhead URL or name substring (repeatable)")
	flt.add_argument("--group", action="append", default=d(None), metavar="PATH", help="only items in this TSM group (and subgroups)")
	flt.add_argument("--source", action="append", default=d(None), metavar="SRC", help="ledger source: auction, vendor, trade, cod, or money type (Postage...)")
	flt.add_argument("--since", default=d(None), metavar="WHEN", help="start of the window (default depends on command)")
	flt.add_argument("--until", default=d(None), metavar="WHEN", help="end of the window (exclusive; default now)")
	flt.add_argument("--period", default=d(None), metavar="NAME", help="today, yesterday, week, month, ytd, last-week, last-month, last-year, or any --since value")
	flt.add_argument("--include-internal", action="store_true", default=d(False), help="keep trades/mail/COD between your own characters")
	flt.add_argument("--variants", action="store_true", default=d(False), help="keep item variants (ilvl/bonus ids) apart instead of grouping by base item")

	out: argparse._ArgumentGroup = parser.add_argument_group("output")
	out.add_argument("-o", "--output", default=d(None), metavar="FMT", help="text (default), wide, org, csv, tsv or json")
	out.add_argument("--save", nargs="?", const="", default=d(None), metavar="PATH", help="write to a file instead of stdout (org by default; no PATH = the notes report dir); put it after the command")
	out.add_argument("--force", action="store_true", default=d(False), help="let --save overwrite a file tsmctl did not write")
	out.add_argument("--no-index", action="store_true", default=d(False), help="do not link a saved org file from its 00_index.org")
	out.add_argument("-n", "--limit", type=int, default=d(None), metavar="N", help="max rows in the main table (0 = all)")
	out.add_argument("--sort", default=d(None), metavar="COLUMN", help="sort the main table by a column key (numbers high-first)")
	out.add_argument("--reverse", action="store_true", default=d(False), help="reverse the sort order")
	out.add_argument("--money", default=d(None), choices=("g", "gsc", "copper"), help="money format (default g)")
	out.add_argument("--price-source", default=d(None), metavar="EXPR", help=f"minimum (conservative) valuation expression (default {DEFAULT_PRICE_SOURCE})")
	out.add_argument("--market-source", default=d(None), metavar="EXPR", help=f"market valuation expression for networth/report (default {DEFAULT_MARKET_SOURCE})")
	out.add_argument("--ah-cut", type=float, default=d(None), metavar="PCT", help=f"auction house cut percent (default {DEFAULT_AH_CUT_PCT:g})")
	out.add_argument("--color", default=d(None), choices=("auto", "always", "never"), help="colour text output (default auto; NO_COLOR is honoured)")
	out.add_argument("--no-links", action="store_true", default=d(False), help="org output: plain item names instead of Wowhead links")
	out.add_argument("--ids", action="store_true", default=d(False), help="show item strings next to names")
	out.add_argument("-v", "--verbose", action="count", default=d(0), help="more logging to stderr (-vv for debug)")
	out.add_argument("-q", "--quiet", action="store_true", default=d(False), help="suppress warnings")


def build_parser() -> argparse.ArgumentParser:
	parser: argparse.ArgumentParser = argparse.ArgumentParser(
		prog=PROG,
		description="Read-only, kubectl-style CLI for TradeSkillMaster data: ledger, gold, inventory, market and business reports.",
		formatter_class=argparse.RawDescriptionHelpFormatter,
		epilog=EPILOG,
	)
	parser.add_argument("-V", "--version", action="version", version=f"{PROG} {VERSION}")
	parser.add_argument("--license", action="store_true", help="show license information and exit")
	add_common_options(parser, suppress=False)
	subparsers: argparse._SubParsersAction[argparse.ArgumentParser] = parser.add_subparsers(dest="command", metavar="COMMAND")

	def sub(name: str, help_text: str, func: Callable[[Context], Doc], aliases: Optional[list[str]] = None) -> argparse.ArgumentParser:
		child: argparse.ArgumentParser = subparsers.add_parser(name, help=help_text, aliases=aliases or [], description=help_text, formatter_class=argparse.RawDescriptionHelpFormatter)
		add_common_options(child, suppress=True)
		child.set_defaults(func=func)
		return child

	sub("status", "data sources, freshness and warnings", cmd_status)
	sub("paths", "show resolved paths", cmd_paths)
	config: argparse.ArgumentParser = sub("config", "show effective settings or print a sample config", cmd_config)
	config.add_argument("action", nargs="?", default="view", help="view (default) or sample")

	get: argparse.ArgumentParser = sub("get", "list a resource", cmd_get, aliases=["ls"])
	get.add_argument("resource", help="accounts, realms, chars, gold, gold-history, sales, buys, income, expenses, expired, cancelled, ledger, inventory, auctions, groups, prices, professions, items, sources")
	get.add_argument("query", nargs="?", help="optional item filter (name, id, i:ID) for ledger/inventory/prices")
	get.add_argument("--by", metavar="KEY", help="gold-history: day|week|month; inventory: item|char|location|realm|group")
	get.add_argument("--location", action="append", metavar="LOC", help="inventory locations: bag, bank, mail, auction, warbank, guild")
	get.add_argument("--min-value", metavar="MONEY", help="inventory: hide rows worth less than this (e.g. 500g)")

	describe: argparse.ArgumentParser = sub("describe", "describe one item, character, realm or TSM group", cmd_describe, aliases=["desc"])
	describe.add_argument("kind", help="item, char, realm or group")
	describe.add_argument("name", nargs="+", help="what to describe")

	search: argparse.ArgumentParser = sub("search", "find items by name or id", lambda c: cmd_search(c, " ".join(c.args.text)))
	search.add_argument("text", nargs="+", help="name text, id or i:ID")

	pnl: argparse.ArgumentParser = sub("pnl", "profit & loss statement", cmd_pnl)
	pnl.add_argument("--by", metavar="KEY", help="day, week (default), month, year, realm, char, source, group, item, none")

	top: argparse.ArgumentParser = sub("top", "rank items, characters, buyers or sellers", cmd_top)
	top.add_argument("what", nargs="?", default="items", help="items (default), chars, buyers, sellers")
	top.add_argument("--by", metavar="METRIC", help="items: profit (default), revenue, sold, roi, margin, velocity, expired, spent, sales")

	flips: argparse.ArgumentParser = sub("flips", "buy-to-sell performance and open positions", cmd_flips)
	flips.add_argument("--open", action="store_true", help="only items still held from purchases")
	flips.add_argument("--min-spent", metavar="MONEY", help="ignore items with less spent than this")

	sell: argparse.ArgumentParser = sub("sellthrough", "AH listing outcomes and dead stock", cmd_sellthrough, aliases=["stale", "dead"])
	sell.add_argument("--min-listings", type=int, metavar="N", help="minimum AH outcomes per item (default 3)")
	sell.add_argument("--max-rate", type=float, metavar="PCT", help="only items at or below this sell-through percent")

	worth: argparse.ArgumentParser = sub("networth", "gold + goods + posted auctions", cmd_networth, aliases=["worth"])
	worth.add_argument("--by", metavar="KEY", help="realm (default), char or location")
	worth.add_argument("--valuation", metavar="VIEW", help="both (default), min (region sale average) or market (market price)")

	deals: argparse.ArgumentParser = sub("deals", "scan a realm's AuctionDB snapshot for buys", cmd_deals, aliases=["scan"])
	deals.add_argument("--buy-source", metavar="EXPR", help="price you would pay (default dbminbuyout)")
	deals.add_argument("--sell-source", metavar="EXPR", help=f"price you expect to sell at (default {DEFAULT_SELL_SOURCE})")
	deals.add_argument("--max-pct", type=float, metavar="PCT", help="buy at most this percent of the sell price (default 70)")
	deals.add_argument("--min-profit", metavar="MONEY", help="minimum net profit per unit after the cut (default 10g)")
	deals.add_argument("--min-sale-rate", type=float, metavar="RATE", help="minimum region sale rate 0-1 (default 0.05)")
	deals.add_argument("--min-sold-per-day", type=float, metavar="N", help="minimum region units sold per day")
	deals.add_argument("--max-buy", metavar="MONEY", help="skip items costing more than this")
	deals.add_argument("--commodities", action="store_true", help="include region-wide commodities (stackables)")
	deals.add_argument("--no-pets", action="store_true", help="skip battle pets")

	report: argparse.ArgumentParser = sub("report", "full business report", cmd_report)
	report.add_argument("--top", type=int, metavar="N", help="rows per section (default 15)")
	report.add_argument("--sections", action="append", metavar="LIST", help=f"only these sections: {', '.join(REPORT_SECTIONS)}")
	report.add_argument("--deals", action="store_true", help="add a deals scan for the default realm")
	return parser


def normalize_args(args: argparse.Namespace) -> None:
	"""Fill SUPPRESSed defaults and derive the effective output format."""
	defaults: dict[str, Any] = {
		"host": None, "local": False, "wow_dir": None, "flavor": None, "account": None, "cache_dir": None,
		"offline": False, "refresh": False, "config": None, "no_config": False, "realm": None, "char": None,
		"item": None, "group": None, "source": None, "since": None, "until": None, "period": None,
		"include_internal": False, "variants": False, "output": None, "save": None, "force": False,
		"no_index": False, "limit": None, "sort": None, "reverse": False, "money": None, "price_source": None, "market_source": None,
		"ah_cut": None, "color": None, "no_links": False, "ids": False, "verbose": 0, "quiet": False,
	}
	for key, value in defaults.items():
		if not hasattr(args, key):
			setattr(args, key, value)
	output: str = (args.output or "").lower()
	wide: bool = output == "wide"
	if output in ("", "wide"):
		output = "org" if args.save is not None else "text"
	if output not in ("text", "org", "csv", "tsv", "json"):
		raise TsmctlError(f"unknown output format {args.output!r}; use text, wide, org, csv, tsv or json")
	args.output_format = output
	args.wide = wide
	args.default_realm = None


def main(argv: Optional[list[str]] = None) -> int:
	parser: argparse.ArgumentParser = build_parser()
	args: argparse.Namespace = parser.parse_args(argv)
	if getattr(args, "license", False):
		print(LICENSE_TEXT)
		return 0
	if not getattr(args, "command", None):
		parser.print_help()
		return 0
	try:
		normalize_args(args)
		Log.verbosity = int(args.verbose or 0)
		Log.quiet = bool(args.quiet)
		settings: Settings = build_settings(args)
		ctx: Context = Context(args, settings)
		doc: Doc = args.func(ctx)

		# Render. Colour only for text on a terminal unless forced.
		color: bool = settings.color == "always" or (settings.color == "auto" and args.output_format == "text" and args.save is None and sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
		width: int = shutil.get_terminal_size((160, 40)).columns if sys.stdout.isatty() else 200
		data: Optional[TsmData] = ctx._data
		opts: RenderOptions = RenderOptions(
			fmt=args.output_format, money=settings.money, color=color and args.save is None,
			links=not args.no_links, ids=bool(args.ids), wide=bool(args.wide) or args.save is not None, width=width,
		)
		body: str = Renderer(data, opts).render(doc)
		if args.save is not None:
			path: Path = write_saved(ctx, doc, body)
			print(f"wrote {path}", file=sys.stderr)
		else:
			sys.stdout.write(body)
			sys.stdout.flush()
		return 0
	except TsmctlError as exc:
		print(f"{PROG}: error: {exc}", file=sys.stderr)
		return 1
	except BrokenPipeError:
		# Output piped into head/less that exited early.
		devnull: int = os.open(os.devnull, os.O_WRONLY)
		os.dup2(devnull, sys.stdout.fileno())
		return 0
	except KeyboardInterrupt:
		return 130


if __name__ == "__main__":
	sys.exit(main())
