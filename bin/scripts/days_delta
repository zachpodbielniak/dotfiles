use strict;
use warnings;
use Time::Local qw(timegm_modern);

($#ARGV+1) >= 1 or die("Usage: days_delta <days_to_add_or_sub>\n");

my $days_add = $ARGV[0];
my (undef, undef, undef, $mday, $mon, $year) = localtime;
my $cur_epoch = timegm_modern(0, 0, 0, $mday, $mon, $year + 1900);
my $new_epoch = $cur_epoch + (24 * 60 * 60 * $days_add);
my (undef, undef, undef, $new_d, $new_m, $new_y) = gmtime($new_epoch);

printf("%04d-%02d-%02d\n", $new_y + 1900, $new_m + 1, $new_d);

