use strict;
use warnings;
use Time::Local qw(timegm_modern);

($#ARGV+1) >= 1 or die("Usage: days_since <date_in_%Y-%m-%d>\n");

my ($past_y, $past_m, $past_d) = $ARGV[0] =~ /\A(\d{4})-(\d{2})-(\d{2})\z/
    or die("Usage: days_since <date_in_%Y-%m-%d>\n");

my (undef, undef, undef, $mday, $mon, $year) = localtime;
my $cur_epoch  = timegm_modern(0, 0, 0, $mday, $mon, $year + 1900);
my $past_epoch = timegm_modern(0, 0, 0, $past_d, $past_m - 1, $past_y);

printf("%d\n", ($cur_epoch - $past_epoch) / (24 * 60 * 60));

