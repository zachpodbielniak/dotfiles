set -euo pipefail

usage () {
	cat << 'EOF'
columns - Simple column selector

USAGE:
	columns [OPTIONS] <selection>

OPTIONS:
	-h, --help              Show this help message
	--license               Show license information
	-d, --delimiter DELIM   Field delimiter (default: whitespace)
	-o, --output DELIM      Output delimiter (default: tab)

EXAMPLES:
	echo "a b c d e" | columns 1,3,5
	cat data.csv | columns -d',' 2-4
	echo "a:b:c:d" | columns -d: -o' ' 1,4

EOF
}

selection=""
delimiter=" "
output_delimiter=$'\t'

while [[ $# -gt 0 ]]; do
	case "${1}" in
		-h|--help) usage; exit 0 ;;
		--license) echo "AGPLv3"; exit 0 ;;
		-d|--delimiter) delimiter="${2}"; shift 2 ;;
		-o|--output) output_delimiter="${2}"; shift 2 ;;
		-d?*) delimiter="${1:2}"; shift ;;
		-o?*) output_delimiter="${1:2}"; shift ;;
		*)
			if [[ -z "$selection" ]]; then
				selection="${1}"
				shift
			else
				echo "Error: unexpected argument '$1'" >&2
				exit 1
			fi
			;;
	esac
done

if [[ -z "$selection" ]]; then
	echo "Error: selection argument required" >&2
	exit 1
fi

# Validate the complete selection before handing data to awk.
if [[ ! "$selection" =~ ^[[:space:]]*[0-9]+(-[0-9]+)?[[:space:]]*(,[[:space:]]*[0-9]+(-[0-9]+)?[[:space:]]*)*$ ]]; then
    echo "Error: invalid column selection" >&2
    exit 1
fi
# Environment values are data, not awk source or -v escape sequences.
COLUMNS_SELECTION="$selection" COLUMNS_FS="$delimiter" COLUMNS_OFS="$output_delimiter" awk '
BEGIN {
    FS = ENVIRON["COLUMNS_FS"]
    OFS = ENVIRON["COLUMNS_OFS"]
    n = split(ENVIRON["COLUMNS_SELECTION"], selections, ",")
    for (i = 1; i <= n; i++) {
        split(selections[i], bounds, "-")
        start = bounds[1] + 0
        end = (selections[i] ~ /-/) ? bounds[2] + 0 : start
        if (start < 1 || end < start || end > 100000) {
            print "Error: column range must be ascending and between 1 and 100000" > "/dev/stderr"
            exit 1
        }
        for (j = start; j <= end; j++) columns[++total] = j
    }
}
{
    for (i = 1; i <= total; i++) printf "%s%s", (i == 1 ? "" : OFS), $(columns[i])
    printf "\n"
}'
