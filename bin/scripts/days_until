use strict;
use warnings;
use Time::Local qw(timegm_modern);

($#ARGV+1) >= 1 or die("Usage: days_until <date_in_%Y-%m-%d>\n");

my ($fut_y, $fut_m, $fut_d) = $ARGV[0] =~ /\A(\d{4})-(\d{2})-(\d{2})\z/
    or die("Usage: days_until <date_in_%Y-%m-%d>\n");

my (undef, undef, undef, $mday, $mon, $year) = localtime;
my $cur_epoch = timegm_modern(0, 0, 0, $mday, $mon, $year + 1900);
my $fut_epoch = timegm_modern(0, 0, 0, $fut_d, $fut_m - 1, $fut_y);

printf("%d\n", ($fut_epoch - $cur_epoch) / (24 * 60 * 60));

