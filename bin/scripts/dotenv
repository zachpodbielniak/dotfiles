# along with this program.  If not, see <https://www.gnu.org/licenses/>.

set -euo pipefail

usage () {
	cat << 'EOF'
dotenv - Load and export .env file variables

USAGE:
	dotenv [OPTIONS] FILE

OPTIONS:
	-h, --help      Show this help message
	--license       Show license information
	--export        Print export statements (for eval)
	--json          Output as JSON
	--yaml          Output as YAML
	--check         Validate syntax only

EXAMPLES:
	dotenv .env
	eval "$(dotenv .env --export)"
	dotenv .env --json | jq .
	dotenv .env --yaml

DESCRIPTION:
	Load variables from a .env file in KEY=VALUE format.
	Supports quoted values and comments.

EOF
}

if [[ $# -lt 1 ]]; then
	usage >&2
	exit 1
fi

format="plain"
check_only=false
envfile=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--license)
			echo "AGPLv3"
			exit 0
			;;
		--export)
			format="export"
			shift
			;;
		--json)
			format="json"
			shift
			;;
		--yaml)
			format="yaml"
			shift
			;;
		--check)
			check_only=true
			shift
			;;
		*)
			envfile="$1"
			shift
			;;
	esac
done

if [[ ! -f "$envfile" ]]; then
	echo "dotenv: file not found: $envfile" >&2
	exit 1
fi

# Parse .env file
declare -A vars=()
while IFS= read -r line || [[ -n "$line" ]]; do
	# Skip empty lines and comments
	[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

	# Parse KEY=VALUE
	if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*) ]]; then
		key="${BASH_REMATCH[1]}"
		value="${BASH_REMATCH[2]}"
        # Strip only matching outer quotes; values are never evaluated.
        if [[ "$value" == \"* || "$value" == \'* ]]; then
            quote="${value:0:1}"
            if [[ ${#value} -lt 2 || "${value: -1}" != "$quote" ]]; then
                echo "dotenv: unmatched quote for $key" >&2
                exit 1
            fi
            value="${value:1:${#value}-2}"
        fi
		vars[$key]="$value"
	else
		# Invalid line
		if [[ "$check_only" != true ]]; then
			echo "dotenv: invalid line: $line" >&2
		fi
		exit 1
	fi
done < "$envfile"

# If check-only, exit with success
[[ "$check_only" == "true" ]] && exit 0

# Output in requested format
case "$format" in
	export)
		for key in "${!vars[@]}"; do
			printf 'export %s=%q\n' "$key" "${vars[$key]}"
		done
		;;
	json|yaml)
        # JSON is also valid YAML and preserves string types and special characters.
        for key in "${!vars[@]}"; do
            printf '%s\0%s\0' "$key" "${vars[$key]}"
        done | python3 -c '
import json, sys
parts = sys.stdin.buffer.read().decode().split("\0")[:-1]
print(json.dumps(dict(zip(parts[::2], parts[1::2])), ensure_ascii=False, indent=2))
'
        ;;
	plain)
		for key in "${!vars[@]}"; do
			printf '%s=%s\n' "$key" "${vars[$key]}"
		done
		;;
esac
