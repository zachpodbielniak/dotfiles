set -euo pipefail

usage () {
	cat << 'EOF'
oldest - Find oldest file(s) in directory

USAGE:
	oldest [OPTIONS] <directory> [count]

OPTIONS:
	-h, --help          Show this help message
	--license           Show license information
	--recursive         Search subdirectories
	--type f|d          Files (f) or directories (d) only

EXAMPLES:
	oldest ~/logs 10
	oldest ~/docs --recursive

EOF
}

recursive=false
type_filter=""
count=""

while [[ $# -gt 0 ]]; do
	case "${1}" in
		-h|--help) usage; exit 0 ;;
		--license) echo "AGPLv3"; exit 0 ;;
		--recursive) recursive=true; shift ;;
		--type) type_filter="${2}"; shift 2 ;;
		*)
			if [[ -z "${dir:-}" ]]; then
				dir="${1}"
				shift
			elif [[ -z "${count:-}" ]]; then
				count="${1}"
				shift
			else
				echo "Error: unexpected argument '$1'" >&2
				exit 1
			fi
			;;
	esac
done

if [[ -z "${dir:-}" ]]; then
	echo "Error: directory argument required" >&2
	exit 1
fi

if [[ ! -d "$dir" ]]; then
	echo "Error: directory not found: $dir" >&2
	exit 1
fi

count=${count:-1}
if [[ ! "$count" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: count must be a positive integer" >&2
    exit 1
fi
case "$type_filter" in
    "") type_filter=f ;;
    f|d) ;;
    *) echo "Error: invalid type '$type_filter'" >&2; exit 1 ;;
esac
# Prefix relative paths to prevent find from interpreting them as expressions.
[[ "$dir" == /* ]] || dir="./$dir"
find_cmd=(find "$dir")
[[ "$recursive" == false ]] && find_cmd+=(-maxdepth 1)
find_cmd+=(-type "$type_filter" -printf '%T@ %p\0')

# NUL records preserve embedded newlines until the final, line-oriented output.
"${find_cmd[@]}" | sort -zn | python3 -c '
import sys
count = int(sys.argv[1])
index = 0
pending = b""
while True:
    chunk = sys.stdin.buffer.read(65536)
    if not chunk:
        break
    records = (pending + chunk).split(b"\0")
    pending = records.pop()
    for record in records:
        if index < count:
            sys.stdout.buffer.write(record.split(b" ", 1)[1] + b"\n")
        index += 1
' "$count"
