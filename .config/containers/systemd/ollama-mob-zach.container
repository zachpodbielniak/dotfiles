[Unit]
Description=Ollama container (Intel Arc B390, Vulkan)
Wants=network-online.target
After=network-online.target
ConditionHost=mob-zach
StartLimitIntervalSec=0

[Container]
# Locally built - see .supporting_files/ollama_vulkan/ for the Containerfile and
# why neither the official image nor Intel's ipex-llm image works on this GPU.
# Build with: just build-ollama-vulkan
Image=localhost/ollama-vulkan:latest
PublishPort=127.0.0.1:11434:11434
PublishPort=100.72.0.44:11434:11434

# Intel Arc B390 (Panther Lake, xe driver). No /dev/kfd on this machine.
AddDevice=/dev/dri

Volume=/var/home/zach/.ollama:/root/.ollama:z

# OLLAMA_HOST, OLLAMA_VULKAN, OLLAMA_IGPU_ENABLE and GGML_VK_VISIBLE_DEVICES are
# baked into the image (they are properties of this GPU, not this deployment).
# Only the tuning knobs live here.

# Number of parallel requests to handle simultaneously (default: 4 or 1 based on memory)
# Higher values allow more concurrent requests but require more VRAM
Environment=OLLAMA_NUM_PARALLEL=1

# Maximum number of models to keep loaded in VRAM simultaneously (default: 1)
# Allows faster switching between models at the cost of more VRAM usage
Environment=OLLAMA_MAX_LOADED_MODELS=2

# Enable Flash Attention optimization for better memory efficiency (default: 0)
# Reduces memory usage and improves performance on supported GPUs
Environment=OLLAMA_FLASH_ATTENTION=1

# Force all model layers to load on GPU (default: auto-detects based on VRAM)
# Set to 999 to force maximum GPU usage, or specific number for partial offloading
Environment=OLLAMA_NUM_GPU=999

# The iGPU shares system RAM; give Vulkan room for host-side staging buffers.
ShmSize=8g

SecurityLabelDisable=true

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
