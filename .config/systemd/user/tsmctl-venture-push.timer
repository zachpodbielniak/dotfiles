[Unit]
# tsmctl-venture-push.timer - push to VENTURE every 30min even when nothing
# triggered the path unit (a missed inotify event, a server that was down).
# --if-changed makes an idle push cost one export and no request.
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
Description=Push WoW data to VENTURE every 30min (fallback)

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
RandomizedDelaySec=60
Unit=tsmctl-venture-push.service

[Install]
WantedBy=timers.target
