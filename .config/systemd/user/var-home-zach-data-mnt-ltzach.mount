[Unit]
Description=SSHFS Mount for lt-zach
# Only the roaming machines mount lt-zach's home. The leading `|` makes each
# of these a *triggering* condition: plain repeated Condition= directives are
# AND'ed, so `ConditionHost=mob-zach` + `ConditionHost=otg-zach` can never both
# hold and the unit is skipped on every host. With `|` the unit starts when at
# least one triggering condition matches -- mob-zach OR otg-zach -- and is
# skipped elsewhere (including on lt-zach, which would mount its own home).
#
# NOTE: the hostname is gated HERE, not by the filename. The Justfile's
# per-host stow ignore would otherwise swallow this file -- it builds a
# `.*ltzach.*` ignore on every host that is not lt-zach, which is exactly the
# set of hosts that need this mount. The Justfile now exempts *.mount from
# those ignores for this reason; see the comment on the ignore loop there.
ConditionHost=|mob-zach
ConditionHost=|otg-zach
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
# Retry configuration
StartLimitIntervalSec=300
StartLimitBurst=5

# Make sure user is part of fuse group 
# or `user_allow_other` is uncommented in /etc/fuse.conf
[Mount]
What=zach@lt-zach:/var/home/zach
# Where= must match the unit name as a LITERAL string - systemd compares the
# two without resolving symlinks, and refuses with "Where= setting doesn't
# match unit name" if they differ. %h is unusable here: passwd gives
# /home/zach on this host, and /home is a symlink to var/home, so %h expands
# to /home/zach/... while the unit name decodes to /var/home/zach/... Do not
# "simplify" this back to %h. (IdentityFile= below is a real path lookup, so
# %h is fine there.)
#
# The mount point drops the hyphen (ltzach, not lt-zach) to match the srvzach
# convention and keep the unit name free of systemd's \x2d path escape.
Where=/var/home/zach/data/mnt/ltzach
Type=fuse.sshfs
# Options mirror the other sshfs mounts here (see the 2026-06-08 suspend-hang
# fix documented in var-home-zach-data-mnt-nas-apool.mount). Two things matter:
# `reconnect` is deliberately absent -- it makes sshfs retry a dead link
# forever, pinning I/O threads in uninterruptible (D) state, which the suspend
# freezer cannot freeze, so the laptop hangs on suspend needing a hard
# power-off. Without it a dead link returns EIO instead of blocking. The tight
# ServerAlive* keepalive detects a dead link in ~10s, inside the 20s freeze
# window. NOTE: x-systemd.automount and x-systemd.idle-timeout are INERT in a
# native .mount unit (only honored for /etc/fstab entries; no companion
# .automount unit exists), so this does not auto-unmount when idle -- resume
# remounts are handled by nas-sleep-guard.service. Both hosts here are
# laptops, so keep this in sync with that service's MOUNT_UNITS list.
Options=_netdev,ServerAliveInterval=5,ServerAliveCountMax=2,x-systemd.automount,x-systemd.idle-timeout=120,IdentityFile=%h/.ssh/id_rsa,allow_other,default_permissions,ConnectTimeout=10,compression=no
TimeoutSec=90

[Install]
WantedBy=default.target
