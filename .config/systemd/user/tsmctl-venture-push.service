[Unit]
# tsmctl-venture-push.service - push WoW data (TSM, DataStore, Syndicator) to VENTURE.
#
# Copyright (C) 2026 Zach Podbielniak
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Started by tsmctl-venture-push.path when WoW writes its SavedVariables (logout,
# /reload) and by tsmctl-venture-push.timer as a fallback. --settle waits until WoW has
# finished writing every file; the push takes a lock, so overlapping
# triggers run one after another. Settings (server, data source, token
# file) come from ~/.config/tsmctl/config.yaml; the token is never on a
# command line. See docs/tsmctl.org, "VENTURE".
Description=Push WoW data to VENTURE (tsmctl)
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
ExecStart=%h/bin/scripts/tsmctl -q venture push --settle 20s --if-changed --wait
Nice=10
TimeoutStartSec=20min
